---
// Archived original chip design for Pesa header
import { Image } from 'astro:assets';
import chipCaretRole from '@/assets/images/svg/chip-caret-role.svg';
import chipCaretFocus from '@/assets/images/svg/chip-caret-focus.svg';
import chipCaretTimeline from '@/assets/images/svg/chip-caret-timeline.svg';
---

<div class="chips">
	<div class="chip-group stagger-in">
		<span class="chip role">Role <Image src={chipCaretRole} width={9.5} height={9.5} alt="" loading="eager"/></span>
		<p>Software Engineer Intern</p>
	</div>
	<div class="chip-group stagger-in">
		<span class="chip focus">Focus <Image src={chipCaretFocus} width={9.5} height={9.5} alt="" loading="eager"/></span>
		<p>Mobile (iOS + Android)</p>
	</div>
	<div class="chip-group stagger-in">
		<span class="chip timeline">Timeline <Image src={chipCaretTimeline} width={9.5} height={9.5} alt="" loading="eager"/></span>
		<p>Summer 2026</p>
	</div>
</div>

<style>
	.chips {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		flex-shrink: 0;
		width: 11.25rem;
	}

	.chip-group {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.5rem;
	}

	.chip {
		-webkit-user-select: none;
		user-select: none;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--color-charcoal-navy);
		border-radius: 1.5rem;
		padding: 0.375rem 0.75rem 0.55rem 0.75rem;
		font-family: var(--font-sans), sans-serif;
		font-weight: 600;
		font-size: var(--font-size-14);
		line-height: 0.5;
		white-space: nowrap;
	}

	.chip img {
		margin-top: 0.1875rem;
	}

	.chip.role     { color: var(--color-chip-pink); }
	.chip.focus    { color: var(--color-chip-yellow); }
	.chip.timeline { color: var(--color-brand-cyan); }

	:root[data-theme='dark'] .chip           { color: #000000; }
	:root[data-theme='dark'] .chip.role      { background: #ffb0ea; }
	:root[data-theme='dark'] .chip.focus     { background: #ffeaa3; }
	:root[data-theme='dark'] .chip.timeline  { background: #aceaff; }
	:root[data-theme='dark'] .chip img       { filter: brightness(0); }

	.chip-group p {
		margin: 0;
		font-size: var(--font-size-15);
		color: var(--color-gray-warm);
		text-align: right;
	}

	@media (max-width: 45rem) {
		.chips          { width: 100%; }
		.chip-group     { align-items: flex-start; }
		.chip-group p   { text-align: left; }
	}
</style>
