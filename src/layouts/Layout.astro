---
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';

import '@/styles/bounce.css';
import '@/styles/fonts.css';
import '@/styles/arrow-reveal.css';
import '@/styles/colors.css';
import '@/styles/typography.css';
import '@/styles/easing.css';

import Tooltip from '@/components/common/Tooltip.astro';
import ClockWidget from '@/components/common/ClockWidget.astro';
import ScrollProgress from '@/components/common/ScrollProgress.astro';
import ConfigMenu from '@/components/common/ConfigMenu.astro';
import CursorStar from '@/components/common/CursorStar.astro';

interface Props {
	title?: string;
	description?: string;
	starColor?: string;
	showClock?: boolean;
	showConfigMenu?: boolean;
}

const {
	title = "Hi, I'm Ashley",
	description = 'CS Student at UWestern building intentionally crafted products.',
	starColor,
	showClock = true,
	showConfigMenu = true,
} = Astro.props;

const outDuration = 0.1;
const inDuration = 0.1;
const sequentialFade = {
	old: {
		name: 'astroFadeOut',
		duration: `${outDuration}s`,
		easing: 'ease-out',
		fillMode: 'forwards',
	},
	new: {
		name: 'astroFadeIn',
		duration: `${inDuration}s`,
		delay: `${outDuration}s`,
		easing: 'ease-in',
		fillMode: 'backwards',
	},
};
const pageTransition = { forwards: sequentialFade, backwards: sequentialFade };

const ogImage = new URL('/og-image.png', Astro.url).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<script is:inline>
			(function () {
				function applyStoredTheme() {
					try {
						const stored = localStorage.getItem('theme');
						const theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
						document.documentElement.setAttribute('data-theme', theme);
					} catch (e) {}
				}
				applyStoredTheme();
				document.addEventListener('astro:after-swap', applyStoredTheme);
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Azeret+Mono:ital,wght@0,100..900;1,100..900&display=swap"
			rel="stylesheet"
		/>

		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<ClientRouter />
		<Analytics/>
	</head>
	<body style={starColor ? `--star-color: ${starColor};` : undefined}>
		<slot name="background" />
		<div id="smooth-wrapper" transition:animate={pageTransition}>
			<div id="smooth-content">
				<slot />
			</div>
		</div>
		<Tooltip />
		<CursorStar />
		{showClock && <ClockWidget />}
		<ScrollProgress />
		{showConfigMenu && <ConfigMenu />}
	</body>

	<script>
		import { gsap } from 'gsap';
		import { ScrollSmoother } from 'gsap/ScrollSmoother';
		import { ScrollTrigger } from 'gsap/ScrollTrigger';
		import checkHardwareAcceleration from '@/utils/hardwareAcceleration';

		gsap.registerPlugin(ScrollSmoother, ScrollTrigger);
		let isFirstLoad = true;

		document.addEventListener('astro:page-load', () => {
			ScrollSmoother.get()?.kill();

			if (checkHardwareAcceleration()) {
				document.documentElement.classList.remove('no-smooth-scroll');
				ScrollSmoother.create({
					wrapper: '#smooth-wrapper',
					content: '#smooth-content',
					smooth: 1.2,
					effects: true,
				});
			} else {
				document.documentElement.classList.add('no-smooth-scroll');
			}

			const isHomeFirstVisit = isFirstLoad && window.location.pathname === '/';
			isFirstLoad = false;

			const staggerEls = document.querySelectorAll('.stagger-in');
			if (staggerEls.length) {
				gsap.fromTo(
					staggerEls,
					{ opacity: 0, y: 10 },
					{
						opacity: 1,
						y: 0,
						duration: 0.3,
						stagger: 0.05,
						delay: isHomeFirstVisit ? 0.03 : 0,
						ease: 'power2.out',
					},
				);
			}

			const FADE_DURATION = 0.15;
			document.querySelectorAll<HTMLImageElement | HTMLVideoElement>('img, video').forEach((el) => {
				if (el.closest('.crossfade-video')) return;

				const isImg = el.tagName === 'IMG';
				const isLoaded = isImg ? (el as HTMLImageElement).complete : (el as HTMLVideoElement).readyState >= 2;
				if (isLoaded) return;

				gsap.set(el, { opacity: 0 });
				const reveal = () => gsap.to(el, { opacity: 1, duration: FADE_DURATION, ease: 'power1.out' });

				el.addEventListener(isImg ? 'load' : 'loadeddata', reveal, { once: true });
				el.addEventListener('error', reveal, { once: true });
			});
		});

		document.addEventListener('dragstart', (event) => {
			if (event.target instanceof HTMLImageElement) {
				event.preventDefault();
			}
		});

		const clickSoundPool = Array.from({ length: 4 }, () => {
			const audio = new Audio('/audio/mouse-click.mp3');
			audio.preload = 'auto';
			audio.volume = 0.2;
			audio.load();
			return audio;
		});
		let clickSoundIndex = 0;

		document.addEventListener('mouseup', (event) => {
			const target = (event.target as HTMLElement)?.closest(
				'.say-hello, .see-work, .card, .back-button, .cursor-fill-btn',
			);
			if (!target) return;
			const sound = clickSoundPool[clickSoundIndex];
			clickSoundIndex = (clickSoundIndex + 1) % clickSoundPool.length;
			sound.currentTime = 0;
			sound.play().catch(() => {});
		});

		let pressedBounceEl: HTMLElement | null = null;

		document.addEventListener('mousedown', (event) => {
			const target = (event.target as HTMLElement)?.closest<HTMLElement>('[data-bounce]');
			if (!target) return;
			pressedBounceEl = target;
			gsap.to(target, {
				scale: parseFloat(target.dataset.bounce || '0.9'),
				duration: 0.15,
				ease: 'power2.out',
			});
		});

		document.addEventListener('mouseup', () => {
			if (!pressedBounceEl) return;
			gsap.to(pressedBounceEl, { scale: 1, duration: 0.6, ease: 'elastic.out(1, 0.5)' });
			pressedBounceEl = null;
		});
	</script>
</html>

<style is:global>
	html[data-theme-transition] * {
		view-transition-name: none !important;
	}

	html[data-theme-transition='down']::view-transition-old(root) {
		animation: none;
		z-index: 1;
	}

	html[data-theme-transition='down']::view-transition-new(root) {
		animation: swipe-down 0.5s var(--ease-swipe) forwards;
		z-index: 2;
	}

	html[data-theme-transition='up']::view-transition-old(root) {
		animation: none;
		z-index: 1;
	}

	html[data-theme-transition='up']::view-transition-new(root) {
		animation: swipe-up 0.5s var(--ease-swipe) forwards;
		z-index: 2;
	}

	@keyframes swipe-down {
		from {
			clip-path: inset(0 0 100% 0);
		}
		to {
			clip-path: inset(0 0 0% 0);
		}
	}

	@keyframes swipe-up {
		from {
			clip-path: inset(100% 0 0 0);
		}
		to {
			clip-path: inset(0% 0 0 0);
		}
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		background: var(--color-bg-page);
		color: var(--color-text-primary);
		font-family: var(--font-sans), sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	* {
		box-sizing: border-box;
	}

	img {
		-webkit-user-drag: none;
		user-select: none;
	}

	#smooth-wrapper {
		overflow: hidden;
		position: fixed;
		height: 100%;
		width: 100%;
	}

	#smooth-content {
		overflow: visible;
		width: 100%;
	}

	/* No GPU-backed WebGL: use regular scrolling */
	html.no-smooth-scroll #smooth-wrapper {
		position: static;
		overflow: visible;
		height: auto;
		width: auto;
	}

	::selection {
		background: var(--color-brand-lime);
		color: #232323;
	}

	.path-label {
		font-family: var(--font-mono), monospace;
		user-select: none;
		font-size: var(--font-size-12);
		color: var(--color-gray-mid-light);
	}

	:root[data-theme='dark'] .path-label {
		color: #464547;
	}

	.stagger-in {
		opacity: 0;
		transform: translateY(0.625rem);
	}
</style>
