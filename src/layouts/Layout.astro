		font-weight: 500;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-SemiBold.otf') format('opentype');
		font-weight: 600;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-SemiBoldItalic.otf') format('opentype');
		font-weight: 600;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
