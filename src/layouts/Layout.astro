---
import { ClientRouter } from 'astro:transitions';
import '../styles/bounce.css';
import Tooltip from '../components/common/Tooltip.astro';
import ClockWidget from '../components/common/ClockWidget.astro';
import ScrollProgress from '../components/common/ScrollProgress.astro';
import ConfigMenu from '../components/common/ConfigMenu.astro';
import CursorStar from '../components/common/CursorStar.astro';

interface Props {
	title?: string;
	description?: string;
	starColor?: string;
}

const {
	title = "Hi, I'm Ashley",
	description = 'CS Student at UWestern building intentionally crafted products.',
	starColor,
} = Astro.props;

const outDuration = 0.1;
const inDuration = 0.1;
const sequentialFade = {
	old: {
		name: 'astroFadeOut',
		duration: `${outDuration}s`,
		easing: 'ease-out',
		fillMode: 'forwards',
	},
	new: {
		name: 'astroFadeIn',
		duration: `${inDuration}s`,
		delay: `${outDuration}s`,
		easing: 'ease-in',
		fillMode: 'backwards',
	},
};
const pageTransition = { forwards: sequentialFade, backwards: sequentialFade };

const ogImage = new URL('/og-image.png', Astro.url).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Azeret+Mono:ital,wght@0,100..900;1,100..900&display=swap"
			rel="stylesheet"
		/>

		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<ClientRouter />
	</head>
	<body style={starColor ? `--star-color: ${starColor};` : undefined}>
		<slot name="background" />
		<div id="smooth-wrapper" transition:animate={pageTransition}>
			<div id="smooth-content">
				<slot />
			</div>
		</div>
		<Tooltip />
		<CursorStar />
		<ClockWidget />
		<ScrollProgress />
		<ConfigMenu />
	</body>

	<script>
		import { gsap } from 'gsap';
		import { ScrollSmoother } from 'gsap/ScrollSmoother';
		import { ScrollTrigger } from 'gsap/ScrollTrigger';

		gsap.registerPlugin(ScrollSmoother, ScrollTrigger);

		// True only for the very first 'astro:page-load' firing
		let isFirstLoad = true;

		document.addEventListener('astro:page-load', () => {
			ScrollSmoother.get()?.kill();
			ScrollSmoother.create({
				wrapper: '#smooth-wrapper',
				content: '#smooth-content',
				smooth: 1.2,
				effects: true,
			});

			const isHomeFirstVisit = isFirstLoad && window.location.pathname === '/';
			isFirstLoad = false;

			const staggerEls = document.querySelectorAll('.stagger-in');
			if (staggerEls.length) {
				gsap.fromTo(
					staggerEls,
					{ opacity: 0, y: 10 },
					{
						opacity: 1,
						y: 0,
						duration: 0.3,
						stagger: 0.05,
						delay: isHomeFirstVisit ? 0.05 : 0,
						ease: 'power2.out',
					}
				);
			}
		});

		document.addEventListener('dragstart', (event) => {
			if (event.target instanceof HTMLImageElement) {
				event.preventDefault();
			}
		});

		const clickSoundPool = Array.from({ length: 4 }, () => {
			const audio = new Audio('/audio/mouse-click.mp3');
			audio.preload = 'auto';
			audio.volume = 0.4;
			audio.load();
			return audio;
		});
		let clickSoundIndex = 0;

		document.addEventListener('mouseup', (event) => {
			const target = (event.target as HTMLElement)?.closest(
				'.say-hello, .see-work, .card, .back-button, .cursor-fill-btn'
			);
			if (!target) return;
			const sound = clickSoundPool[clickSoundIndex];
			clickSoundIndex = (clickSoundIndex + 1) % clickSoundPool.length;
			sound.currentTime = 0;
			sound.play().catch(() => {});
		});

		let pressedBounceEl: HTMLElement | null = null;

		document.addEventListener('mousedown', (event) => {
			const target = (event.target as HTMLElement)?.closest<HTMLElement>('[data-bounce]');
			if (!target) return;
			pressedBounceEl = target;
			gsap.to(target, {
				scale: parseFloat(target.dataset.bounce || '0.9'),
				duration: 0.15,
				ease: 'power2.out',
			});
		});

		document.addEventListener('mouseup', () => {
			if (!pressedBounceEl) return;
			gsap.to(pressedBounceEl, { scale: 1, duration: 0.6, ease: 'elastic.out(1, 0.5)' });
			pressedBounceEl = null;
		});
	</script>
</html>

<style is:global>
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-UltraLight.otf') format('opentype');
		font-weight: 100;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-UltraLightItalic.otf') format('opentype');
		font-weight: 100;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-ExtraLight.otf') format('opentype');
		font-weight: 200;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-ExtraLightItalic.otf') format('opentype');
		font-weight: 200;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-Light.otf') format('opentype');
		font-weight: 300;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-LightItalic.otf') format('opentype');
		font-weight: 300;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-Regular.otf') format('opentype');
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-RegularItalic.otf') format('opentype');
		font-weight: 400;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-Medium.otf') format('opentype');
		font-weight: 500;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-MediumItalic.otf') format('opentype');
		font-weight: 500;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-SemiBold.otf') format('opentype');
		font-weight: 600;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-SemiBoldItalic.otf') format('opentype');
		font-weight: 600;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-Bold.otf') format('opentype');
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-BoldItalic.otf') format('opentype');
		font-weight: 700;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-Black.otf') format('opentype');
		font-weight: 900;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-BlackItalic.otf') format('opentype');
		font-weight: 900;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Druk Wide Bold';
		src: url('/fonts/DrukWideBold.ttf') format('truetype');
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}

	:root {
		/* brand */
		--color-brand-pink: #FE6FC1;
		--color-brand-lime: #EDFDAD;
		--color-brand-cyan: #beefff;
		--color-accent-purple: #9093E8;

		/* text */
		--color-text-primary: #232323;
		--color-text-primary-alt: #212121;
		--color-text-secondary: #444444;
		--color-text-medium: #4D4D4D;
		--color-text-muted: #606060;
		--color-text-faint: #868686;
		--color-charcoal: #393939;
		--color-charcoal-alt: #222222;
		--color-gray-dark: #383838;
		--color-gray-warm: #303030;
		--color-slate: #595d62;

		--color-white: #ffffff;
		--color-black: #000000;

		/* dark fills (hover/press states) */
		--color-navy-deep: #202935;
		--color-forest-deep: #222C25;
		--color-ink-deep: #1D2726;
		--color-charcoal-navy: #25262D;

		/* backgrounds / borders */
		--color-bg-page: #fefefe;

		--color-border: #eaeaea;
		--color-border-soft: #ebebeb;
		--color-border-harsh: #E9E9E9;

		--color-gray-faint: #f8f8f8;
		--color-gray-faint-hover: #FAFAFA;

		--color-gray-light: #f4f4f4;
		--color-gray-lighter: #f3f3f3;

		--color-gray-hover: #f0f0f0;
		--color-gray-mid: #c8c8c8;
		--color-gray-mid-light: #cbcbcb;

		/* one-offs */
		--color-selection: #7E96FF;
		--color-chip-pink: #FEC0F2;
		--color-chip-yellow: #ffeeb5;

		--font-sans: 'Sofia Pro', system-ui, sans-serif;
		--font-sofia: 'Sofia Pro', var(--font-sans);
		--font-display: 'Druk Wide Bold', system-ui, sans-serif;
		--font-mono: 'Azeret Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;

		--font-size-12: 0.75rem;   /* 12px */
		--font-size-13: 0.8125rem; /* 13px */
		--font-size-14: 0.875rem;  /* 14px */
		--font-size-15: 0.9375rem; /* 15px */
		--font-size-16: 1rem;      /* 16px */
		--font-size-18: 1.125rem;  /* 18px */
		--font-size-20: 1.25rem;   /* 20px */
		--font-size-22: 1.375rem;  /* 22px */
		--font-size-24: 1.5rem; 	 /* 24px */
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		background: var(--color-bg-page);
		color: var(--color-text-primary);
		font-family: var(--font-sans), sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	* {
		box-sizing: border-box;
	}

	img {
		-webkit-user-drag: none;
		user-select: none;
	}

	#smooth-wrapper {
		overflow: hidden;
		position: fixed;
		height: 100%;
		width: 100%;
	}

	#smooth-content {
		overflow: visible;
		width: 100%;
	}

	::selection {
		background: var(--color-brand-lime);
		color: var(--color-text-primary);
	}

	.path-label {
		font-family: var(--font-mono), monospace;
		user-select: none;
		font-size: var(--font-size-12);
		color: var(--color-gray-mid-light);
	}

	.stagger-in {
		opacity: 0;
		transform: translateY(0.625rem);
	}
</style>
