		src: url('/fonts/sofia-pro/SofiaPro-Bold.otf') format('opentype');
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-BoldItalic.otf') format('opentype');
		font-weight: 700;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-Black.otf') format('opentype');
		font-weight: 900;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-BlackItalic.otf') format('opentype');
		font-weight: 900;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Druk Wide Bold';
		src: url('/fonts/DrukWideBold.ttf') format('truetype');
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}

	:root {
		--color-bg: #fefefe;
		--color-ink: #2a2a2a;
		--color-ink-medium: #444444;
		--color-ink-soft: #606060;
		--color-ink-muted: #868686;
		--color-border: #eaeaea;
		--color-accent: #9093E8;
		--color-main: #FE6FC1;
		--font-sans: 'Sofia Pro', system-ui, sans-serif;
		--font-sofia: 'Sofia Pro', var(--font-sans);
		--font-display: 'Druk Wide Bold', system-ui, sans-serif;
		--font-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		background: var(--color-bg);
		color: var(--color-ink);
		font-family: var(--font-sans), sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	* {
		box-sizing: border-box;
	}

	img {
		-webkit-user-drag: none;
		user-select: none;
	}

	#smooth-wrapper {
		overflow: hidden;
		position: fixed;
		height: 100%;
		width: 100%;
	}

	#smooth-content {
		overflow: visible;
		width: 100%;
	}

	::selection {
		background: #7E96FF;
		color: #fff;
	}

	.path-label {
		font-family: var(--font-mono), monospace;
		user-select: none;
		font-size: 12px;
		color: #cbcbcb;
	}
	
	.stagger-in {
		opacity: 0;
		transform: translateY(10px);
	}
</style>
