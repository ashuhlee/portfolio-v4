---
import { ClientRouter } from 'astro:transitions';
import '../styles/bounce.css';
import Tooltip from '../components/Tooltip.astro';
import ClockWidget from '../components/ClockWidget.astro';
import ScrollProgress from '../components/ScrollProgress.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Hi, I'm Ashley - wip!",
	description = 'Computer science student with a passion for software development and intuitive design.',
} = Astro.props;

const outDuration = 0.1;
const inDuration = 0.1;
const sequentialFade = {
	old: {
		name: 'astroFadeOut',
		duration: `${outDuration}s`,
		easing: 'ease-out',
		fillMode: 'forwards',
	},
	new: {
		name: 'astroFadeIn',
		duration: `${inDuration}s`,
		delay: `${outDuration}s`,
		easing: 'ease-in',
		fillMode: 'backwards',
	},
};
const pageTransition = { forwards: sequentialFade, backwards: sequentialFade };

const ogImage = new URL('/og-image.png', Astro.url).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<ClientRouter />
	</head>
	<body>
		<slot name="background" />
		<div id="smooth-wrapper" transition:animate={pageTransition}>
			<div id="smooth-content">
				<slot />
			</div>
		</div>
		<Tooltip />
		<ClockWidget />
		<ScrollProgress />
	</body>

	<script>
		import { gsap } from 'gsap';
		import { ScrollSmoother } from 'gsap/ScrollSmoother';
		import { ScrollTrigger } from 'gsap/ScrollTrigger';

		gsap.registerPlugin(ScrollSmoother, ScrollTrigger);

		// True only for the very first 'astro:page-load' firing
		let isFirstLoad = true;

		document.addEventListener('astro:page-load', () => {
			ScrollSmoother.get()?.kill();
			ScrollSmoother.create({
				wrapper: '#smooth-wrapper',
				content: '#smooth-content',
				smooth: 1.2,
				effects: true,
			});

			const isHomeFirstVisit = isFirstLoad && window.location.pathname === '/';
			isFirstLoad = false;

			const staggerEls = document.querySelectorAll('.stagger-in');
			if (staggerEls.length) {
				gsap.fromTo(
					staggerEls,
					{ opacity: 0, y: 10 },
					{
						opacity: 1,
						y: 0,
						duration: 0.3,
						stagger: 0.05,
						delay: isHomeFirstVisit ? 0.05 : 0,
						ease: 'power2.out',
					}
				);
			}
		});

		document.addEventListener('dragstart', (event) => {
			if (event.target instanceof HTMLImageElement) {
				event.preventDefault();
			}
		});

		const clickSoundPool = Array.from({ length: 4 }, () => {
			const audio = new Audio('/audio/mouse-click.mp3');
			audio.preload = 'auto';
			audio.volume = 0.4;
			audio.load();
			return audio;
		});
		let clickSoundIndex = 0;

		document.addEventListener('mouseup', (event) => {
			const target = (event.target as HTMLElement)?.closest(
				'.say-hello, .see-work, .card, .back-button, .cursor-fill-btn'
			);
			if (!target) return;
			const sound = clickSoundPool[clickSoundIndex];
			clickSoundIndex = (clickSoundIndex + 1) % clickSoundPool.length;
			sound.currentTime = 0;
			sound.play().catch(() => {});
		});

		let pressedBounceEl: HTMLElement | null = null;

		document.addEventListener('mousedown', (event) => {
			const target = (event.target as HTMLElement)?.closest<HTMLElement>('[data-bounce]');
			if (!target) return;
			pressedBounceEl = target;
			gsap.to(target, {
				scale: parseFloat(target.dataset.bounce || '0.9'),
				duration: 0.15,
				ease: 'power2.out',
			});
		});

		document.addEventListener('mouseup', () => {
			if (!pressedBounceEl) return;
			gsap.to(pressedBounceEl, { scale: 1, duration: 0.6, ease: 'elastic.out(1, 0.5)' });
			pressedBounceEl = null;
		});
	</script>
</html>

<style is:global>
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-UltraLight.otf') format('opentype');
		font-weight: 100;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-UltraLightItalic.otf') format('opentype');
		font-weight: 100;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-ExtraLight.otf') format('opentype');
		font-weight: 200;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-ExtraLightItalic.otf') format('opentype');
		font-weight: 200;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-Light.otf') format('opentype');
		font-weight: 300;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-LightItalic.otf') format('opentype');
		font-weight: 300;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-Regular.otf') format('opentype');
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
		src: url('/fonts/sofia-pro/SofiaPro-RegularItalic.otf') format('opentype');
		font-weight: 400;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Sofia Pro';
