---
import Layout from '../../layouts/Layout.astro';
import PageFooter from '../../components/work/PageFooter.astro';
---

<Layout
	title="Software Engineer Intern at Pesa — Ashley O"
	description="Over the summer I worked on Pesa's mobile app, using Flutter and Dart across iOS and Android."
>
	<div class="page">
		<a class="back-button" href="/" aria-label="Back to home">
			<img src="/images/pesa/back-arrow.svg" alt="" width="24" height="24" />
		</a>

		<header class="header-row">
			<div class="header-left">
				<div class="title-row">
					<div class="title-icon">
						<img src="/images/home/avatar-star-icon.svg" alt="" width="24" height="24" />
					</div>
					<h1>My experience</h1>
				</div>
				<p class="description">
					Over the summer I worked on Pesa's mobile app, using Flutter and Dart. I worked across
					iOS and Android to build and ship new features and improve existing user experiences. I also rotated across the product and
					engineering teams.
				</p>
				<p class="description">
					I had the opportunity to ship multiple user-facing features to the app, being used by
					over 10,000 users all over the world.
				</p>
			</div>

			<div class="chips">
				<div class="chip-group">
					<span class="chip role">Role <img src="/images/pesa/chip-caret-role.svg" alt="" width="9" height="9" /></span>
					<p>Software Engineer Intern</p>
				</div>
				<div class="chip-group">
					<span class="chip focus">Focus <img src="/images/pesa/chip-caret-focus.svg" alt="" width="9" height="9" /></span>
					<p>Mobile (iOS &amp; Android)</p>
				</div>
				<div class="chip-group">
					<span class="chip timeline">Timeline <img src="/images/pesa/chip-caret-timeline.svg" alt="" width="9" height="9" /></span>
					<p>Summer 2026</p>
				</div>
			</div>
		</header>

		<div class="showcase-header">
			<div class="icon-button">
				<img src="/images/home/avatar-star-icon.svg" alt="" width="24" height="24" />
			</div>
			<h2>Showcase</h2>
		</div>

		<div class="showcase-grid">
			<div class="placeholder card-e"></div>
			<div class="placeholder card-b"></div>
			<div class="placeholder card-a"></div>
			<div class="placeholder card-d"></div>
			<div class="placeholder card-f"></div>
			<div class="placeholder card-c"></div>
		</div>

		<div class="badges">
			<span class="badge blue">+ a bunch of other cool stuff</span>
			<span class="badge pink">for 10k+ users</span>
		</div>

		<PageFooter />
	</div>
</Layout>

<style>
	.page {
		max-width: 800px;
		margin: 0 auto;
		padding: 40px 24px 64px;
	}

	.back-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: #f3f3f3;
		border-radius: 999px;
		margin-bottom: 64px;
	}

	.header-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 32px;
		margin-bottom: 56px;
	}

	.header-left {
		flex: 1;
		min-width: 0;
	}

	.title-row {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 12px;
	}

	.title-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: #aac6ff;
		border-radius: 999px;
		flex-shrink: 0;
	}

	h1 {
		font-family: var(--font-display);
		font-size: 20px;
		margin: 0;
		color: var(--color-ink);
	}

	.description {
		font-size: 15px;
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0 0 12px;
		max-width: 520px;
	}

	.description:last-child {
		margin-bottom: 0;
	}

	.chips {
		display: flex;
		flex-direction: column;
		gap: 16px;
		flex-shrink: 0;
		width: 170px;
	}

	.chip-group {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 8px;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: #2b2b2b;
		border-radius: 24px;
		padding: 6px 12px;
		font-family: var(--font-sofia), sans-serif;
		font-weight: 600;
		font-size: 14px;
		white-space: nowrap;
	}

	.chip.role {
		color: #f4c9f1;
	}

	.chip.focus {
		color: #ffeeb5;
	}

	.chip.timeline {
		color: #beefff;
	}

	.chip-group p {
		margin: 0;
		font-size: 15px;
		color: #303030;
		text-align: right;
	}

	.showcase-header {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 24px;
	}

	.icon-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: #f4c9f1;
		border-radius: 999px;
		flex-shrink: 0;
		transform: rotate(-8.57deg);
	}

	h2 {
		font-family: var(--font-display), sans-serif;
		font-size: 20px;
		margin: 0;
		color: var(--color-ink);
	}

	.showcase-grid {
		position: relative;
		width: 100%;
		aspect-ratio: 919 / 1396;
		margin-bottom: 56px;
	}

	.placeholder {
		position: absolute;
		background: #f8f8f8;
		border: 1px solid #ebebeb;
		border-radius: 24px;
	}


	.card-e {
		left: 0;
		top: 0;
		width: 99.8%;
		height: 37%;
	}

	.card-b {
		left: 0;
		top: 38.9%;
		width: 54.9%;
		height: 23%;
	}

	.card-a {
		left: 58%;
		top: 38.9%;
		width: 41.8%;
		height: 15.5%;
	}

	.card-d {
		left: 58%;
		top: 56.3%;
		width: 42%;
		height: 24.4%;
	}

	.card-f {
		left: 0;
		top: 63.9%;
		width: 55.2%;
		height: 31.2%;
	}

	.card-c {
		left: 58%;
		top: 82.5%;
		width: 41.8%;
		height: 17.5%;
	}

	.badges {
		display: flex;
		justify-content: center;
		gap: 16px;
		margin-bottom: 56px;
	}

	.badge {
		border-radius: 999px;
		padding: 6px 12px;
		font-family: var(--font-sofia);
		font-weight: 600;
		font-size: 14px;
		white-space: nowrap;
	}

	.badge.blue {
		background: #7e96ff;
		color: #fff;
		transform: rotate(-2deg);
	}

	.badge.pink {
		background: #f4c9f1;
		color: #000;
		transform: rotate(2deg);
	}

	@media (max-width: 720px) {
		.header-row {
			flex-direction: column;
		}

		.chips {
			width: 100%;
		}

		.chip-group {
			align-items: flex-start;
		}

		.chip-group p {
			text-align: left;
		}

		.badges {
			flex-wrap: wrap;
		}
	}
</style>
