---
import { Image } from 'astro:assets';

import Layout from '../../layouts/Layout.astro';
import PageFooter from '../../components/common/PageFooter.astro';
import DitherBackground from '../../components/dither/DitherBackground.astro';
import BackButton from '../../components/common/BackButton.astro';

import withdraw1 from '../../assets/pesa/withdraw-1.webp';
import withdraw2 from '../../assets/pesa/withdraw-2.webp';
import withdraw3 from '../../assets/pesa/withdraw-3.webp';

import wallet1 from '../../assets/pesa/wallet-1.webp';
import wallet2 from '../../assets/pesa/wallet-2.webp';

import savings1 from '../../assets/pesa/savings-1.webp';
import savings2 from '../../assets/pesa/savings-2.webp';

import settings1 from '../../assets/pesa/settings-1.webp';
import settings2 from '../../assets/pesa/settings-2.webp';

import reviewPlaceholder from '../../assets/pesa/placeholder.webp';
import chipCaretRole from '../../assets/pesa/chip-caret-role.svg';
import chipCaretFocus from '../../assets/pesa/chip-caret-focus.svg';
import chipCaretTimeline from '../../assets/pesa/chip-caret-timeline.svg';
---

<Layout
	title="Pesa Internship - Ashley O"
	description="Over the summer I worked on Pesa's mobile app, using Flutter and Dart across iOS and Android."
>
	<DitherBackground slot="background" color="grey" />
	<div class="page">
		<BackButton />

		<header class="header-row">
			<div class="header-left">
				<div class="title-row stagger-in">
					<h1>Pesa</h1>
				</div>
				<p class="description stagger-in">
					Over the summer I worked on Pesa's mobile app, using Flutter. I worked across
					iOS and Android to build and ship new features and improve existing user experiences, rotating across product /
					engineering teams.
				</p>
				<p class="description stagger-in">
					I had the opportunity to ship multiple user-facing features that are now used by thousands of users around the world.
				</p>
			</div>

			<div class="chips">
				<div class="chip-group stagger-in">
					<span class="chip role">Role <Image src={chipCaretRole} width={9.5} height={9.5} alt="" /></span>
					<p>Software Engineer Intern</p>
				</div>
				<div class="chip-group stagger-in">
					<span class="chip focus">Focus <Image src={chipCaretFocus} width={9.5} height={9.5} alt="" /></span>
					<p>Mobile (iOS + Android)</p>
				</div>
				<div class="chip-group stagger-in">
					<span class="chip timeline">Timeline <Image src={chipCaretTimeline} width={9.5} height={9.5} alt="" /></span>
					<p>Summer 2026</p>
				</div>
			</div>
		</header>

		<div class="showcase-header stagger-in">
			<h2>Showcase</h2>
			<button class="expand-toggle" type="button" data-bounce="0.9" aria-label="Expand showcase width">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path
						class="icon-expand"
						d="M4 3H9.33333V4.77778H5.77778V8.33333H4V3ZM4 19H9.33333V17.2222H5.77778V13.6667H4L4 19ZM14.6667 19H20V13.6667H18.2222V17.2222H14.6667V19ZM20 3H14.6667V4.77778H18.2222V8.33333H20V3Z"
						fill="currentColor"
					/>
					<path
						class="icon-collapse"
						d="M9.33333 8.33333H4V6.55556H7.55556V3H9.33333V8.33333ZM9.33333 13.6667H4V15.4444H7.55556V19H9.33333V13.6667ZM20 13.6667H14.6667V19H16.4444V15.4444H20V13.6667ZM14.6667 8.33333H20V6.55556H16.4444V3H14.6667V8.33333Z"
						fill="currentColor"
						opacity="0"
					/>
				</svg>
			</button>
		</div>

		<div class="showcase-grid">
			<div
				class="placeholder card-withdraw showcase-preview stagger-in"
				data-tooltip="Deposit and withdraw from savings"
				data-tooltip-color="#FEC0F2"
			>
				<Image
					class="preview-phone preview-phone-left"
					src={withdraw1}
					inferSize
					alt="Withdraw from stash screen"
				/>
				<Image
					class="preview-phone preview-phone-center"
					src={withdraw2}
					inferSize
					alt="Request for withdrawal modal"
				/>
				<Image
					class="preview-phone preview-phone-right"
					src={withdraw3}
					inferSize
					alt="Decline withdrawal request modal"
				/>
			</div>
			<div
				class="placeholder card-wallet showcase-preview stagger-in"
				data-tooltip="Create a new wallet"
				data-tooltip-color="#E4F894"
			>
				<Image
					class="wallet-phone wallet-phone-1"
					src={wallet1}
					inferSize
					alt="Your new GBP wallet is waiting screen"
				/>
				<Image
					class="wallet-phone wallet-phone-2"
					src={wallet2}
					inferSize
					alt="Activate your USD wallet screen"
				/>
			</div>
			<video
				class="placeholder card-toast stagger-in"
				src="/videos/pesa/notifications.webm"
				autoplay
				loop
				muted
				playsinline
				controls={false}
				data-tooltip="Toast feedback"
				data-tooltip-color="#FFE9A0"
			></video>
			<div
				class="placeholder card-savings showcase-preview stagger-in"
				data-tooltip="Create a savings account"
				data-tooltip-color="#BEEFFF"
			>
				<Image
					class="savings-phone savings-phone-1"
					src={savings1}
					inferSize
					alt="Empty personal stash screen"
				/>
				<Image
					class="savings-phone savings-phone-2"
					src={savings2}
					inferSize
					alt="Stash created successfully modal"
				/>
			</div>
			<div
				class="placeholder card-settings showcase-preview stagger-in"
				data-tooltip="Savings creation and deletion"
				data-tooltip-color="#FFB8AA"
			>
				<Image
					class="settings-phone settings-phone-1"
					src={settings1}
					inferSize
					alt="Stash settings screen"
				/>
				<Image
					class="settings-phone settings-phone-2"
					src={settings2}
          inferSize
					alt="Stash closed confirmation modal"
				/>
			</div>
			<div
				class="placeholder card-review showcase-preview stagger-in"
				data-tooltip="Action-prompted dialogs"
				data-tooltip-color="#FFAFDD"
			>
				<Image
					class="review-phone"
					src={reviewPlaceholder}
					inferSize
					alt="App Store review prompt dialog"
				/>
			</div>

			<p class="showcase-note stagger-in">
				<span class="showcase-note-text">+ a bunch of other cool stuff</span><span class="showcase-exclaim">!</span>
			</p>
		</div>

		<div class="stagger-in"><PageFooter /></div>
	</div>
</Layout>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import SplitType from 'split-type';

	gsap.registerPlugin(ScrollTrigger);

	document.addEventListener('astro:page-load', () => {
		const page = document.querySelector<HTMLElement>('.page');

		const toggle = document.querySelector<HTMLButtonElement>('.expand-toggle');
		const svg = toggle?.querySelector('svg');

		const expandIcon = toggle?.querySelector<SVGPathElement>('.icon-expand');
		const collapseIcon = toggle?.querySelector<SVGPathElement>('.icon-collapse');

		if (!page || !toggle || !svg || !expandIcon || !collapseIcon) return;

		let rotation = 0;

		toggle.addEventListener('click', () => {
			const expanded = page.classList.toggle('expanded');
			rotation += 90;

			gsap.to(svg, { rotate: rotation, duration: 0.4, ease: 'power2.inOut' });
			gsap.to(expandIcon, { opacity: expanded ? 0 : 1, duration: 0.3, ease: 'power2.inOut' });
			gsap.to(collapseIcon, { opacity: expanded ? 1 : 0, duration: 0.3, ease: 'power2.inOut' });

			toggle.setAttribute('aria-label', expanded ? 'Collapse showcase width' : 'Expand showcase width');
		});

		const note = document.querySelector<HTMLElement>('.showcase-note');
		const noteText = note?.querySelector<HTMLElement>('.showcase-note-text');
		const exclaim = note?.querySelector<HTMLElement>('.showcase-exclaim');
		if (note && noteText && exclaim) {
			const split = new SplitType(noteText, { types: 'words', tagName: 'span' });
			gsap.set(split.words, { opacity: 0 });
			gsap.set(exclaim, { opacity: 0, rotate: 25 });

			const noteTimeline = gsap.timeline({
				scrollTrigger: {
					trigger: note,
					start: 'top 90%',
					once: true,
				},
			});

			noteTimeline
				.to(split.words, {
					opacity: 1,
					duration: 0.4,
					ease: 'power1.out',
					stagger: 0.08,
				})
				.to(
					exclaim,
					{
						opacity: 1,
						rotate: 8,
						duration: 1,
						ease: 'elastic.out(1, 0.3)',
					},
					'+=0.5'
				);
		}
	});
</script>

<style>
	.page {
		max-width: 50rem;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 0;
		transition: max-width 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.0);
	}

	.page.expanded {
		max-width: 80vw;
	}

	.header-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.header-left {
		flex: 1;
		min-width: 0;
	}

	.title-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	h1 {
		font-family: var(--font-display), sans-serif;
		font-size: 1.25rem;
		margin: 0;
		color: var(--color-ink);
	}

	.description {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0 0 0.75rem;
		max-width: 31.5625rem;
	}

	.description:last-child {
		margin-bottom: 0;
	}

	.chips {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		flex-shrink: 0;
		width: 11.25rem;
	}

	.chip-group {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.5rem;
	}

	.chip {
		user-select: none;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: #25262D;
		border-radius: 1.5rem;
		padding: 0.375rem 0.75rem 0.5rem 0.75rem;
		font-family: var(--font-sofia), sans-serif;
		font-weight: 600;
		font-size: 0.875rem;
		line-height: 0.5;
		white-space: nowrap;
	}

	.chip img {
		margin-top: 0.1875rem;
	}

	.chip.role {
		color: #FEC0F2;
	}

	.chip.focus {
		color: #ffeeb5;
	}

	.chip.timeline {
		color: #beefff;
	}

	.chip-group p {
		margin: 0;
		font-size: 0.9375rem;
		color: #303030;
		text-align: right;
	}

	.showcase-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.expand-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		background: #F8F8F8;
		border: none;
		border-radius: 999px;
		color: #000;
		cursor: pointer;
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	.expand-toggle:hover {
		background: #FAFAFA;
		color: var(--color-main);
	}

	h2 {
		font-family: var(--font-display), sans-serif;
		font-size: 1.125rem;
		margin: 0;
		color: var(--color-ink);
	}

	.showcase-grid {
		position: relative;
		width: 100%;
		aspect-ratio: 919 / 1396;
		margin-bottom: 3.5rem;
	}

	.showcase-note {
		position: absolute;
		left: 0;
		top: calc(95.1% + 1.5rem);
		width: 55.2%;
		margin: 0;
		font-family: var(--font-sofia), sans-serif;
		font-style: italic;
		font-weight: 500;
		font-size: 0.9375rem;
		text-align: center;
		color: var(--color-main);
	}

	.showcase-exclaim {
		display: inline-block;
		margin-left: 0.125rem;
		transform-origin: 50% 100%;
	}

	.placeholder {
		position: absolute;
		background: #f8f8f8;
		border: 1px solid #ebebeb;
		border-radius: 1.125rem;
	}

	video.placeholder {
		object-fit: cover;
	}

	.showcase-preview {
		overflow: hidden;
	}

	.preview-phone {
		position: absolute;
		top: 50%;
		width: 22.9%;
		height: auto;
		transform: translate(-50%, -50%);
		pointer-events: none;
		user-select: none;
	}

	.preview-phone-left {
		left: 21.25%;
	}

	.preview-phone-center {
		left: 50%;
	}

	.preview-phone-right {
		left: 78.75%;
	}

	.wallet-phone {
		position: absolute;
		width: 41.04%;
		height: auto;
		pointer-events: none;
		user-select: none;
	}

	.wallet-phone-1 {
		left: 6.67%;
		top: 9.19%;
	}

	.wallet-phone-2 {
		left: 51.25%;
		top: -36.26%;
	}

	.card-savings.showcase-preview {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 7%;
		padding: 1.5rem;
	}

	.savings-phone {
		height: 100%;
		width: auto;
		max-width: 45%;
		object-fit: contain;
		pointer-events: none;
		user-select: none;
	}

	.card-settings.showcase-preview {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10%;
		padding: 1.75rem;
	}

	.settings-phone {
		height: 100%;
		width: auto;
		max-width: 45%;
		object-fit: contain;
		pointer-events: none;
		user-select: none;
	}

	.review-phone {
		position: absolute;
		width: 66%;
		height: auto;
		left: 18%;
		top: -124%;
		pointer-events: none;
		user-select: none;
	}


	.card-withdraw {
		left: 0;
		top: 0;
		width: 99.8%;
		height: 37%;
	}

	.card-wallet {
		left: 0;
		top: 38.9%;
		width: 54.9%;
		height: 23%;
	}

	.card-toast {
		left: 58%;
		top: 38.9%;
		width: 41.8%;
		height: 15.5%;
	}

	.card-savings {
		left: 58%;
		top: 56.3%;
		width: 42%;
		height: 24.4%;
	}

	.card-settings {
		left: 0;
		top: 63.9%;
		width: 55.2%;
		height: 31.2%;
	}

	.card-review {
		left: 58%;
		top: 82.5%;
		width: 41.8%;
		height: 17.5%;
	}

	@media (max-width: 45rem) {
		.header-row {
			flex-direction: column;
		}
		.chips {
			width: 100%;
		}
		.chip-group {
			align-items: flex-start;
		}
		.chip-group p {
			text-align: left;
		}
	}
</style>
