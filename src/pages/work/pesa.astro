---
import {Image} from 'astro:assets';

import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/layout/Footer.astro';
import DitherBackground from '@/components/webgl/dither/DitherBackground.astro';
import PixelBlastBackground from '@/components/webgl/pixelblast/PixelBlastBackground.astro';
import BackButton from '@/components/layout/BackButton.astro';
import CrossfadeVideo from '@/components/media/CrossfadeVideo.astro';
import ShowcaseCard from '@/components/projects/ShowcaseCard.astro';
import PesaHeader from '@/components/projects/PesaHeader.astro';

import withdraw1 from '@/assets/videos/webm/pesa-withdraw-1.webm';
import withdraw1Mov from '@/assets/videos/mov/pesa-withdraw-1.mov';
import withdraw2 from '@/assets/images/webp/pesa-withdraw-2.webp';
import withdraw3 from '@/assets/images/webp/pesa-withdraw-3.webp';

import wallet1 from '@/assets/images/webp/pesa-wallet-1.webp';
import wallet2 from '@/assets/images/webp/pesa-wallet-2.webp';

import savings1 from '@/assets/images/webp/pesa-savings-1.webp';
import savings2 from '@/assets/images/webp/pesa-savings-2.webp';

import settings2 from '@/assets/videos/webm/pesa-settings.webm';
import settings2Mov from '@/assets/videos/mov/pesa-settings.mov';
import create1 from '@/assets/videos/webm/pesa-create-stash.webm';
import create1Mov from '@/assets/videos/mov/pesa-create-stash.mov';

import notificationsWebm from '@/assets/videos/webm/pesa-notifications.webm';
import notificationsMov from '@/assets/videos/mov/pesa-notifications.mov';

import reviewPlaceholder from '@/assets/images/webp/pesa-placeholder.webp';
---

<Layout
  title="Pesa — Hi, I'm Ashley"
  description="Over the summer I worked on Pesa's mobile app, using Flutter and Dart across iOS and Android."
  starColor="var(--color-brand-pink)"
>
  <DitherBackground slot="background" color="grey"/>
  <PixelBlastBackground slot="background" visibleInTheme="dark"/>
  <div class="page">
    <BackButton/>

    <PesaHeader />

    <div class="showcase-header stagger-in">
      <h2>SHOWCASE</h2>
      <button class="expand-toggle" type="button" data-bounce="0.9" aria-label="Expand showcase width">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            class="icon-expand"
            d="M4 3H9.33333V4.77778H5.77778V8.33333H4V3ZM4 19H9.33333V17.2222H5.77778V13.6667H4L4 19ZM14.6667 19H20V13.6667H18.2222V17.2222H14.6667V19ZM20 3H14.6667V4.77778H18.2222V8.33333H20V3Z"
            fill="currentColor"
          />
          <path
            class="icon-collapse"
            d="M9.33333 8.33333H4V6.55556H7.55556V3H9.33333V8.33333ZM9.33333 13.6667H4V15.4444H7.55556V19H9.33333V13.6667ZM20 13.6667H14.6667V19H16.4444V15.4444H20V13.6667ZM14.6667 8.33333H20V6.55556H16.4444V3H14.6667V8.33333Z"
            fill="currentColor"
            opacity="0"
          />
        </svg>
      </button>
    </div>

    <div class="showcase-grid">
      <ShowcaseCard variant="withdraw" tooltip="Deposit and withdraw from savings" tooltipColor="#FFA6D9"
                    tooltipColorStart="#FFDDF8">
        <CrossfadeVideo
          class="preview-phone preview-phone-left"
          src={withdraw1}
          srcMov={withdraw1Mov}
          aspectRatio="660 / 1368"
          replayDelay={5000}
          ariaLabel="Withdraw from stash screen"
        />
        <Image
          class="preview-phone preview-phone-center"
          src={withdraw2}
          inferSize
          loading="eager"
          alt="Request for withdrawal modal"
        />
        <Image
          class="preview-phone preview-phone-right"
          src={withdraw3}
          inferSize
          loading="eager"
          alt="Decline withdrawal request modal"
        />
      </ShowcaseCard>
      <ShowcaseCard variant="wallet" tooltip="Create a new wallet" tooltipColor="#D8D8D8" tooltipColorStart="#FFFFFF">
        <Image
          class="wallet-phone wallet-phone-1"
          src={wallet1}
          inferSize
          alt="Your new GBP wallet is waiting screen"
        />
        <Image
          class="wallet-phone wallet-phone-2"
          src={wallet2}
          inferSize
          alt="Activate your USD wallet screen"
        />
      </ShowcaseCard>
      <video
        class="placeholder card-toast stagger-in"
        autoplay
        loop
        muted
        playsinline
        controls={false}
        data-tooltip="Toast feedback"
        data-tooltip-color="#FFA6D9"
        data-tooltip-color-start="#FFDDF8"
      >
        <source src={notificationsMov} type="video/mp4; codecs=hvc1"/>
        <source src={notificationsWebm} type="video/webm"/>
      </video>
      <ShowcaseCard variant="savings" tooltip="Create a savings account" tooltipColor="#212121"
                    tooltipColorStart="#555555" tooltipTextColor="#FFFFFF">
        <Image
          class="savings-phone savings-phone-1"
          src={savings1}
          inferSize
          alt="Empty personal stash screen"
        />
        <CrossfadeVideo
          class="savings-phone savings-phone-2"
          src={create1}
          srcMov={create1Mov}
          aspectRatio="660 / 1368"
          replayDelay={3000}
          fadeDuration={0.2}
          ariaLabel="Create stash screen"
        />
      </ShowcaseCard>
      <ShowcaseCard variant="settings" tooltip="Savings creation and deletion" tooltipColor="#FFA6D9"
                    tooltipColorStart="#FFDDF8">
        <Image
          class="settings-phone settings-phone-1"
          src={savings2}
          inferSize
          alt="Stash created successfully modal"
        />
        <CrossfadeVideo
          class="settings-phone settings-phone-2"
          src={settings2}
          srcMov={settings2Mov}
          aspectRatio="660 / 1368"
          replayDelay={3000}
          fadeDuration={0.2}
          ariaLabel="Stash closed confirmation modal"
        />
      </ShowcaseCard>
      <ShowcaseCard variant="review" tooltip="Action-prompted dialogs" tooltipColor="#FFA6D9"
                    tooltipColorStart="#FFDDF8">
        <Image
          class="review-phone"
          src={reviewPlaceholder}
          inferSize
          alt="App Store review prompt dialog"
        />
      </ShowcaseCard>

      <p class="showcase-note stagger-in">+ a bunch of other cool stuff</p>
    </div>

    <div class="stagger-in">
      <Footer/>
    </div>
  </div>
</Layout>

<script>
	import {gsap} from 'gsap';
	import {attachSkeletons} from '@/utils/skeleton';

	document.addEventListener('astro:page-load', () => {
		attachSkeletons(
			'.preview-phone, .wallet-phone, .savings-phone, .settings-phone, ' +
			'.review-phone, .crossfade-video, video.card-toast',
		);

		const page = document.querySelector<HTMLElement>('.page');

		const toggle = document.querySelector<HTMLButtonElement>('.expand-toggle');
		const svg = toggle?.querySelector('svg');

		const expandIcon = toggle?.querySelector<SVGPathElement>('.icon-expand');
		const collapseIcon = toggle?.querySelector<SVGPathElement>('.icon-collapse');

		if (!page || !toggle || !svg || !expandIcon || !collapseIcon) return;

		let rotation = 0;

		toggle.addEventListener('click', () => {
			const expanded = page.classList.toggle('expanded');
			rotation += 90;

			gsap.to(svg, {rotate: rotation, duration: 0.4, ease: 'power2.inOut'});
			gsap.to(expandIcon, {opacity: expanded ? 0 : 1, duration: 0.3, ease: 'power2.inOut'});
			gsap.to(collapseIcon, {opacity: expanded ? 1 : 0, duration: 0.3, ease: 'power2.inOut'});

			toggle.setAttribute('aria-label', expanded ? 'Collapse showcase width' : 'Expand showcase width');
		});
	});

</script>

<style>
    .page {
        max-width: 50rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 0;
        transition: max-width 0.3s var(--ease-spring-soft);
    }

    .page.expanded {
        max-width: max(50rem, 80vw);
    }

    .showcase-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .expand-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        background: var(--color-gray-faint);
        border: none;
        border-radius: 999px;
        color: var(--color-black);
        cursor: pointer;
        transition: color 0.2s ease,
        background 0.2s ease;
    }

    :root[data-theme='dark'] .expand-toggle {
        background: #25232c;
    }

    .expand-toggle:hover {
        background: var(--color-gray-faint-hover);
        color: var(--color-brand-pink);
    }

    h2 {
        font-family: var(--font-display), sans-serif;
        font-size: var(--font-size-18);
        margin: 0;
        color: var(--color-text-primary);
    }

    .showcase-grid {
        position: relative;
        width: 100%;
        aspect-ratio: 919 / 1396;
        margin-bottom: 3.5rem;
    }

    .showcase-note {
        position: absolute;
        left: 0;
        top: calc(95.1% + 1.5rem);
        width: 55.2%;
        margin: 0;
        font-family: var(--font-mono), monospace;
        font-size: var(--font-size-12);
        text-align: center;
        color: var(--color-brand-pink);
        line-height: 24px;
    }

    :global(.placeholder) {
        position: absolute;
        background: var(--color-gray-faint);
        border: 1px solid var(--color-border-soft);
        border-radius: 0.5rem
    }

    video.placeholder {
        object-fit: cover;
    }

    :global(.showcase-preview) {
        overflow: hidden;
    }

    :global(.preview-phone) {
        position: absolute;
        top: 50%;
        width: 22.9%;
        height: auto;
        transform: translate(-50%, -50%);
        pointer-events: none;
        -webkit-user-select: none;
        user-select: none;
    }

    :global(.preview-phone-left) {
        left: 21.25%;
    }

    .preview-phone-center {
        left: 50%;
    }

    .preview-phone-right {
        left: 78.75%;
    }

    .wallet-phone {
        position: absolute;
        width: 41.04%;
        height: auto;
        pointer-events: none;
        -webkit-user-select: none;
        user-select: none;
    }

    .wallet-phone-1 {
        left: 6.67%;
        top: 9.19%;
    }

    .wallet-phone-2 {
        left: 51.25%;
        top: -36.26%;
    }

    :global(.card-savings.showcase-preview) {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7%;
        padding: 1.5rem;
    }

    :global(.savings-phone) {
        height: 100%;
        width: auto;
        max-width: 45%;
        object-fit: contain;
        pointer-events: none;
        -webkit-user-select: none;
        user-select: none;
    }

    :global(.card-settings.showcase-preview) {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10%;
        padding: 1.75rem;
    }

    :global(.settings-phone) {
        height: 100%;
        width: auto;
        max-width: 45%;
        object-fit: contain;
        pointer-events: none;
        -webkit-user-select: none;
        user-select: none;
    }

    .review-phone {
        position: absolute;
        width: 66%;
        height: auto;
        left: 18%;
        top: -124%;
        pointer-events: none;
        -webkit-user-select: none;
        user-select: none;
    }


    :global(.card-withdraw) {
        left: 0;
        top: 0;
        width: 99.8%;
        height: 37%;
    }

    :global(.card-wallet) {
        left: 0;
        top: 38.9%;
        width: 54.9%;
        height: 23%;
    }

    .card-toast {
        left: 58%;
        top: 38.9%;
        width: 41.8%;
        height: 15.5%;
    }

    :global(.card-savings) {
        left: 58%;
        top: 56.3%;
        width: 42%;
        height: 24.4%;
    }

    :global(.card-settings) {
        left: 0;
        top: 63.9%;
        width: 55.2%;
        height: 31.2%;
    }

    :global(.card-review) {
        left: 58%;
        top: 82.5%;
        width: 41.8%;
        height: 17.5%;
    }

    @media (max-width: 62.5rem) {
        .expand-toggle {
            display: none;
        }
    }
</style>
