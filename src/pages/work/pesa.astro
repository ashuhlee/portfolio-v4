---
import Layout from '../../layouts/Layout.astro';
import PageFooter from '../../components/PageFooter.astro';
import DitherBackground from '../../components/home/DitherBackground.astro';
import BackButton from '../../components/BackButton.astro';
---

<Layout
	title="Pesa Internship - Ashley O"
	description="Over the summer I worked on Pesa's mobile app, using Flutter and Dart across iOS and Android."
>
	<DitherBackground slot="background" color="grey" />
	<div class="page">
		<BackButton />

		<header class="header-row">
			<div class="header-left">
				<div class="title-row stagger-in">
					<h1>Pesa</h1>
				</div>
				<p class="description stagger-in">
					Over the summer I worked on Pesa's mobile app, using Flutter. I worked across
					iOS and Android to build and ship new features and improve existing user experiences, rotating across product and
					engineering teams.
				</p>
				<p class="description stagger-in">
					I had the opportunity to ship multiple user-facing features to the app, being used by
					thousands of users all over the world.
				</p>
			</div>

			<div class="chips">
				<div class="chip-group stagger-in">
					<span class="chip role">Role <img src="/images/pesa/chip-caret-role.svg" alt="" width="9" height="9" /></span>
					<p>Software Engineer Intern</p>
				</div>
				<div class="chip-group stagger-in">
					<span class="chip focus">Focus <img src="/images/pesa/chip-caret-focus.svg" alt="" width="9" height="9" /></span>
					<p>Mobile (iOS &amp; Android)</p>
				</div>
				<div class="chip-group stagger-in">
					<span class="chip timeline">Timeline <img src="/images/pesa/chip-caret-timeline.svg" alt="" width="9" height="9" /></span>
					<p>Summer 2026</p>
				</div>
			</div>
		</header>

		<div class="showcase-header stagger-in">
			<h2>Showcase</h2>
		</div>

		<div class="showcase-grid">
			<div
				class="placeholder card-e showcase-preview stagger-in"
				data-tooltip="Deposit and withdraw from savings"
				data-tooltip-color="#FEC0F2"
			>
				<img
					class="preview-phone preview-phone-left"
					src="/images/pesa/withdraw-1.png"
					alt="Withdraw from stash screen"
				/>
				<img
					class="preview-phone preview-phone-center"
					src="/images/pesa/withdraw-2.png"
					alt="Request for withdrawal modal"
				/>
				<img
					class="preview-phone preview-phone-right"
					src="/images/pesa/withdraw-3.png"
					alt="Decline withdrawal request modal"
				/>
			</div>
			<div
				class="placeholder card-b showcase-preview stagger-in"
				data-tooltip="Create and new wallet"
				data-tooltip-color="#E4F894"
			>
				<img
					class="wallet-phone wallet-phone-1"
					src="/images/pesa/wallet-1.png"
					alt="Your new GBP wallet is waiting screen"
				/>
				<img
					class="wallet-phone wallet-phone-2"
					src="/images/pesa/wallet-2.png"
					alt="Activate your USD wallet screen"
				/>
			</div>
			<video
				class="placeholder card-a stagger-in"
				src="/videos/pesa/notifications.mp4"
				autoplay
				loop
				muted
				playsinline
				controls={false}
				data-tooltip="Toast feedback"
				data-tooltip-color="#FFE9A0"
			></video>
			<div
				class="placeholder card-d showcase-preview stagger-in"
				data-tooltip="More savings related stuff"
				data-tooltip-color="#BEEFFF"
			>
				<img
					class="savings-phone savings-phone-1"
					src="/images/pesa/savings-1.png"
					alt="Empty personal stash screen"
				/>
				<img
					class="savings-phone savings-phone-2"
					src="/images/pesa/savings-2.png"
					alt="Stash created successfully modal"
				/>
			</div>
			<div
				class="placeholder card-f showcase-preview stagger-in"
				data-tooltip="Savings creation and deletion"
				data-tooltip-color="#FFCCCA"
			>
				<img
					class="settings-phone settings-phone-1"
					src="/images/pesa/settings-1.png"
					alt="Stash settings screen"
				/>
				<img
					class="settings-phone settings-phone-2"
					src="/images/pesa/settings-2.png"
					alt="Stash closed confirmation modal"
				/>
			</div>
			<div
				class="placeholder card-c showcase-preview stagger-in"
				data-tooltip="Action-prompted dialogs"
				data-tooltip-color="#edfdad"
			>
				<img
					class="review-phone"
					src="/images/pesa/placeholder.png"
					alt="App Store review prompt dialog"
				/>
			</div>
		</div>

		<div class="badges">
			<div class="badge-group stagger-in">
				<span class="badge blue">+ a bunch of other cool stuff</span>
				<span class="badge pink">for 10k+ users</span>
			</div>
		</div>

		<div class="stagger-in"><PageFooter /></div>
	</div>
</Layout>

<style>
	.page {
		max-width: 800px;
		margin: 0 auto;
		padding: 40px 24px 64px;
	}

	.header-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 32px;
		margin-bottom: 32px;
	}

	.header-left {
		flex: 1;
		min-width: 0;
	}

	.title-row {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 12px;
	}

	h1 {
		font-family: var(--font-display), sans-serif;
		font-size: 20px;
		margin: 0;
		color: var(--color-ink);
	}

	.description {
		font-size: 15px;
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0 0 12px;
		max-width: 510px;
	}

	.description:last-child {
		margin-bottom: 0;
	}

	.chips {
		display: flex;
		flex-direction: column;
		gap: 16px;
		flex-shrink: 0;
		width: 180px;
	}

	.chip-group {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 8px;
	}

	.chip {
		user-select: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: #2b2b2b;
		border-radius: 24px;
		padding: 6px 12px 8px 12px;
		font-family: var(--font-sofia), sans-serif;
		font-weight: 600;
		font-size: 14px;
		line-height: 1;
		white-space: nowrap;
	}

	.chip img {
		margin-top: 3px;
	}

	.chip.role {
		color: #FEC0F2;
	}

	.chip.focus {
		color: #ffeeb5;
	}

	.chip.timeline {
		color: #beefff;
	}

	.chip-group p {
		margin: 0;
		font-size: 15px;
		color: #303030;
		text-align: right;
	}

	.showcase-header {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 24px;
	}

	h2 {
		font-family: var(--font-display), sans-serif;
		font-size: 18px;
		margin: 0;
		color: var(--color-ink);
	}

	.showcase-grid {
		position: relative;
		width: 100%;
		aspect-ratio: 919 / 1396;
		margin-bottom: 56px;
	}

	.placeholder {
		position: absolute;
		background: #f8f8f8;
		border: 1px solid #ebebeb;
		border-radius: 24px;
	}

	video.placeholder {
		object-fit: cover;
	}

	.showcase-preview {
		overflow: hidden;
	}

	.preview-phone {
		position: absolute;
		top: 50%;
		width: 22.9%;
		transform: translate(-50%, -50%);
		pointer-events: none;
		user-select: none;
	}

	.preview-phone-left {
		left: 21.25%;
	}

	.preview-phone-center {
		left: 50%;
	}

	.preview-phone-right {
		left: 78.75%;
	}

	.wallet-phone {
		position: absolute;
		width: 41.04%;
		pointer-events: none;
		user-select: none;
	}

	.wallet-phone-1 {
		left: 6.67%;
		top: 9.19%;
	}

	.wallet-phone-2 {
		left: 51.25%;
		top: -36.26%;
	}

	.card-d.showcase-preview {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10%;
		padding: 20px;
	}

	.savings-phone {
		height: 100%;
		width: auto;
		max-width: 45%;
		object-fit: contain;
		pointer-events: none;
		user-select: none;
	}

	.card-f.showcase-preview {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8%;
		padding: 20px;
	}

	.settings-phone {
		height: 100%;
		width: auto;
		max-width: 45%;
		object-fit: contain;
		pointer-events: none;
		user-select: none;
	}

	.review-phone {
		position: absolute;
		width: 66%;
		left: 18%;
		top: -124%;
		pointer-events: none;
		user-select: none;
	}


	.card-e {
		left: 0;
		top: 0;
		width: 99.8%;
		height: 37%;
	}

	.card-b {
		left: 0;
		top: 38.9%;
		width: 54.9%;
		height: 23%;
	}

	.card-a {
		left: 58%;
		top: 38.9%;
		width: 41.8%;
		height: 15.5%;
	}

	.card-d {
		left: 58%;
		top: 56.3%;
		width: 42%;
		height: 24.4%;
	}

	.card-f {
		left: 0;
		top: 63.9%;
		width: 55.2%;
		height: 31.2%;
	}

	.card-c {
		left: 58%;
		top: 82.5%;
		width: 41.8%;
		height: 17.5%;
	}

	.badges {
		display: flex;
		justify-content: center;
		margin-bottom: 56px;
	}

	.badge-group {
		position: relative;
		display: inline-block;
		transform: translateX(-40px);
	}

	.badge {
		border-radius: 999px;
		padding: 5px 12px;
		font-family: var(--font-sofia), sans-serif;
		font-weight: 600;
		font-size: 14px;
		white-space: nowrap;
	}

	.badge.blue {
		display: inline-block;
		background: #7e96ff;
		color: #fff;
		transform: rotate(-2deg);
	}

	.badge.pink {
		position: absolute;
		left: 50%;
		top: 50%;
		background: #FEC0F2;
		color: #000;
		transform: translate(calc(-50% + 126px), calc(-50% + 20px)) rotate(2deg);
	}

	@media (max-width: 720px) {
		.header-row {
			flex-direction: column;
		}

		.chips {
			width: 100%;
		}

		.chip-group {
			align-items: flex-start;
		}

		.chip-group p {
			text-align: left;
		}

		.badges {
			flex-wrap: wrap;
		}
	}
</style>
