---
import PageFooter from '@/components/common/PageFooter.astro';
import Layout from '@/layouts/Layout.astro';
import SiteNav from '@/components/home/SiteNav.astro';
import ProfileIntro from '@/components/home/ProfileIntro.astro';
import ExperienceSection from '@/components/home/ExperienceSection.astro';
import ProjectsSection from '@/components/home/ProjectsSection.astro';
import DitherBackground from '@/components/webGL/dither/DitherBackground.astro';
import PixelBlastBackground from '@/components/webGL/pixelblast/PixelBlastBackground.astro';
import CursorFillButton from '@/components/common/CursorFillButton.astro';
import Divider from '@/components/home/Divider.astro';
import SeekingBanner from '@/components/home/SeekingBanner.astro';

import codPreview from '@/assets/projects/countorama.webm';
import starlitPreview from '@/assets/projects/starlit.gif';
import flappyKittyPreview from '@/assets/projects/flappy-kitty.webm';

const experiences = [
	{
		role: 'Frontend Engineer Intern at Sun Life',
		when: 'Fall 2026',
		dot: 'var(--color-text-primary)',
		href: 'https://www.sunlife.ca/en/',
	},
	{
		role: 'Software Engineer Intern at Pesa',
		when: 'Summer 2026',
		dot: '#ff8fd5',
		href: 'https://www.pesa.co/',
	},
	{
		role: 'Web Development Intern at SCAN',
		when: 'Summer 2024 - 25',
		dot: '#DFF28F'
	},
];

const projects = [
	{
		name: 'Count O Rama',
		description: 'A fun arcade game with progressive difficulty, power ups and game modes',
		tags: ['Game', 'Electron', 'Typescript'],
		color: '#303030',
		url: 'https://github.com/ashuhlee/count-or-die',
		preview: codPreview,
	},
	{
		name: 'Starlit',
		description: 'A customizable weather package that matches any terminal - 4k+ downloads!',
		tags: ['Terminal', 'Python'],
		color: '#FFAAE5',
		blendMode: 'overlay',
		overlayOpacity: 0.19,
		url: 'https://github.com/ashuhlee/starlit',
		preview: starlitPreview,
	},
	{
		name: 'Loggi',
		description: 'Track your daily meals, weight and steps, synced with the health app',
		tags: ['Mobile', 'Swift', 'Firebase'],
		color: '#f7f7f7',
		comingSoon: true,
		labelColor: '#5E5E5E',
	},
	{
		name: 'Flappy Kitty',
		description: "A Flappy Bird-style game but it's a cat, with collision detection & physics based movement",
		tags: ['Game', 'Lua', 'Love2D'],
		color: '#beefff',
		url: 'https://github.com/ashuhlee/flappy-kitty',
		preview: flappyKittyPreview,
	},
];
---

<Layout>
	<DitherBackground slot="background" color="grey" />
	<PixelBlastBackground slot="background" visibleInTheme="dark" />
	<div class="page">
		<div class="stagger-in">
			<SiteNav />
		</div>

		<main class="content">
			<ProfileIntro />
			<Divider class="stagger-in" />
			<ExperienceSection experiences={experiences} />
			<Divider class="stagger-in" />
			<div class="stagger-in">
				<ProjectsSection projects={projects} />
			</div>
			<div>
				<div class="cursor-fill-wrap stagger-in">
					<CursorFillButton
						href="https://github.com/ashuhlee"
						label="View more on GitHub"
						hoverSound="/audio/scribble.mp3"
						magnet={false}
					/>
				</div>
			</div>
		</main>

		<div class="stagger-in">
			<SeekingBanner />
			<PageFooter />
		</div>
	</div>
</Layout>

<script>
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll('.divider').forEach((el) => {
			el.addEventListener('contextmenu', (event) => event.preventDefault());
		});
	});
</script>

<style>
	.page {
		max-width: 42.1875rem;
		margin: 0 auto;
		padding: 3rem 1.5rem 0;
		--page-max-width: 42.1875rem;
	}

	.cursor-fill-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 3rem;
		margin: 3rem 0 3.5rem;
	}
</style>
