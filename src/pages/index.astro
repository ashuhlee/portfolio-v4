---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/layout/Footer.astro';
import CursorFillButton from '@/components/ui/CursorFillButton.astro';
import PixelBlastBackground from '@/components/webgl/pixelblast/PixelBlastBackground.astro';
import ExperienceSection from '@/components/sections/ExperienceSection.astro';
import ProjectsSection from '@/components/sections/ProjectsSection.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import ribbonImg from '@/assets/images/png/ribbon.png';
---

<Layout showSplash>
	<PixelBlastBackground slot="background" color="#F5F5F5"/>
	<div class="page">
		<Image src={ribbonImg} class="page-ribbon" alt="" aria-hidden="true" draggable="false" />
		<div class="layout">
			<div class="content">
				<HeroSection/>
				<ExperienceSection/>
				<ProjectsSection/>
			</div>
		</div>

		<div class="view-more-wrap stagger-in">
					<CursorFillButton
						href="https://github.com/ashuhlee"
						label="View more on GitHub"
						hoverSound="/audio/scribble.mp3"
						magnet={false}
					/>
		</div>

		<div class="footer-wrap stagger-in">
			<Footer/>
		</div>
	</div>
</Layout>

<style>
	.page {
		max-width: 40.625rem;
		margin: 0 auto;
		padding: 7rem 2rem 0 1.5rem;
		position: relative;
		overflow-y: clip;
	}

	.layout {
		display: block;
	}

	.view-more-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		margin-top: 3.5rem;
		margin-bottom: 4.5rem;
		height: 3rem;
	}

	.content {
		min-width: 0;
	}

	.page-ribbon {
		position: absolute;
		top: -5.5rem;
		right: -25.5rem;
		height: 460px;
		transform: rotate(90deg);
		opacity: 0.08;
		pointer-events: none;
		user-select: none;
		filter: blur(2.5px);
		z-index: 0;
	}

	:root[data-theme='dark'] .page-ribbon {
		opacity: 0;
	}

	.footer-wrap {
		position: relative;
		z-index: 1;
	}

	@media (max-width: 44rem) {
		.page {
			padding: 2rem 1rem 0;
		}
	}
</style>
