---
import PageFooter from '../components/PageFooter.astro';
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/home/SiteNav.astro';
import ProfileIntro from '../components/home/ProfileIntro.astro';
import ExperienceSection from '../components/home/ExperienceSection.astro';
import ProjectsSection from '../components/home/ProjectsSection.astro';
import DoodleCluster from '../components/home/DoodleCluster.astro';

const experiences = [
	{role: 'Frontend Engineer Intern at Sun Life', when: 'Fall 2026', dot: '#dff28f'},
	{role: 'Software Engineer Intern at Pesa', when: 'Summer 2026', dot: '#bccaff'},
	{role: 'Web Development Intern at SCAN', when: 'Summer 2024 - 25', dot: '#f4c9f1'},
];

const projects = [
	{
		name: 'Count O Rama',
		description: 'A fun arcade game with progressive difficulty, power ups and game modes',
		tags: ['Game', 'Electron', 'Typescript'],
		color: '#bccaff',
	},
	{
		name: 'Starlit',
		description: 'A fun arcade style clicker game with addictive fast-paced gameplay',
		tags: ['Terminal', 'Python'],
		color: '#f4c9f1',
	},
	{
		name: 'Loggi',
		description: 'A fun arcade style clicker game with addictive fast-paced gameplay',
		tags: ['Mobile', 'Swift', 'Firebase'],
		color: '#f7f7f7',
	},
	{
		name: 'Synced',
		description: 'A fun arcade style clicker game with addictive fast-paced gameplay',
		tags: ['Game', 'Electron', 'Typescript'],
		color: '#beefff',
	},
];
---

<Layout>
  <div class="page">
    <div class="stagger-in"><SiteNav/></div>

    <main class="content">
      <ProfileIntro/>
      <hr class="stagger-in"/>
      <ExperienceSection experiences={experiences}/>
      <hr class="stagger-in"/>
      <div class="stagger-in"><ProjectsSection projects={projects}/></div>
      <div class="stagger-in"><DoodleCluster/></div>
    </main>

    <div class="stagger-in"><PageFooter/></div>
  </div>
</Layout>

<style>
    .page {
        max-width: 650px;
        margin: 0 auto;
        padding: 40px 24px 64px;
    }

    hr {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 32px 0;
    }
</style>
