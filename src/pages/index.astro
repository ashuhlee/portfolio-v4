---
import { Image } from 'astro:assets';
import PageFooter from '../components/common/PageFooter.astro';
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/home/SiteNav.astro';
import ProfileIntro from '../components/home/ProfileIntro.astro';
import ExperienceSection from '../components/home/ExperienceSection.astro';
import ProjectsSection from '../components/home/ProjectsSection.astro';
import DoodleCluster from '../components/home/DoodleCluster.astro';
import DitherBackground from '../components/dither/DitherBackground.astro';
import CursorFillButton from '../components/common/CursorFillButton.astro';
import lineDivider from '../assets/home/line1.svg';

const experiences = [
	{role: 'Frontend Engineer Intern at Sun Life', when: 'Fall 2026', dot: '#dff28f'},
	{role: 'Software Engineer Intern at Pesa', when: 'Summer 2026', dot: '#A6B9FF'},
	{role: 'Web Development Intern at SCAN', when: 'Summer 2024 - 25', dot: '#FFAAE5'},
];

const projects = [
	{
		name: 'Count O Rama',
		description: 'A fun arcade game with progressive difficulty, power ups and game modes',
		tags: ['Game', 'Electron', 'Typescript'],
		color: '#B1C2FF',
		url: 'https://github.com/ashuhlee/count-or-die',
	},
	{
		name: 'Starlit',
		description: 'A customizable weather package that matches any terminal - 4k+ downloads!',
		tags: ['Terminal', 'Python'],
		color: '#FFBBEC',
		blendMode: 'overlay',
		overlayOpacity: 0.19,
		url: 'https://github.com/ashuhlee/starlit',
	},
	{
		name: 'Loggi',
		description: 'Track your daily meals, weight and steps, synced with the health app',
		tags: ['Mobile', 'Swift', 'Firebase'],
		color: '#f7f7f7',
		comingSoon: true,
	},
	{
		name: 'Synced',
		description: 'Plan and manage your Twitch stream schedule, directly from your phone',
		tags: ['Mobile', 'Flutter', 'Dart'],
		color: '#beefff',
		comingSoon: true,
	},
];
---

<Layout>
  <DitherBackground slot="background" color={['pink', 'grey']} />
  <div class="page">
    <div class="stagger-in"><SiteNav/></div>

    <main class="content">
      <ProfileIntro/>
      <Image class="divider stagger-in" src={lineDivider} inferSize alt="" draggable="false" />
      <ExperienceSection experiences={experiences}/>
      <Image class="divider stagger-in" src={lineDivider} inferSize alt="" draggable="false" />
      <div class="stagger-in"><ProjectsSection projects={projects}/></div>
      <div>
        <div class="cursor-fill-wrap stagger-in">
          <CursorFillButton href="https://github.com/ashuhlee" label="See more on GitHub" />
        </div>
      </div>
      <Image class="divider divider--doodle stagger-in" src={lineDivider} inferSize alt="" draggable="false" />
      <div class="stagger-in"><DoodleCluster/></div>
    </main>

    <div class="stagger-in"><PageFooter/></div>
  </div>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.divider').forEach((el) => {
      el.addEventListener('contextmenu', (event) => event.preventDefault());
    });
  });
</script>

<style>
    .page {
        max-width: 650px;
        margin: 0 auto;
        padding: 40px 24px 0;
        --page-max-width: 650px;
    }

    .cursor-fill-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 48px;
        margin: 48px 0;
    }

    .divider {
        display: block;
        width: 100%;
        height: 5px;
        margin: 32px 0;
    }

    .divider--doodle {
        margin-bottom: 12px;
    }
</style>
