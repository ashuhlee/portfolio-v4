---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/layout/Footer.astro';
import PixelBlastBackground from '@/components/webgl/pixelblast/PixelBlastBackground.astro';
import ExperienceSection from '@/components/sections/ExperienceSection.astro';
import ProjectsSection from '@/components/sections/ProjectsSection.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import CommitLogSection from '@/components/sections/CommitLogSection.astro';
import ContactSection from '@/components/sections/ContactSection.astro';
import ribbonImg from '@/assets/images/png/ribbon.png';
---

<Layout title="Hi, I'm Ashley">
	<script is:inline>
		if (!window.__astroWasNavigation) {
			document.documentElement.setAttribute('data-stagger-init', '');
		}
	</script>
	<PixelBlastBackground slot="background" color="#F5F5F5"/>
	<Image src={ribbonImg} class="page-ribbon" alt="" aria-hidden="true" draggable="false" />
	<div class="page">
		<div class="layout">
			<div class="content">
				<HeroSection/>
				<ExperienceSection/>
				<ProjectsSection/>
			</div>
		</div>
		<CommitLogSection />
		<hr class="section-divider" />
		<ContactSection />
	</div>
	<div class="footer-wrap stagger-in">
		<Footer/>
	</div>
</Layout>

<script>
	document.addEventListener('astro:page-load', () => {
		document.documentElement.removeAttribute('data-stagger-init');
		const w = window as any;
		if (w.__astroWasNavigation) {
			w.__astroWasNavigation = false;
		}
	});
</script>

<style>
	.page {
		max-width: 40.625rem;
		margin: 0 auto;
		padding: 8rem 2rem 0 1.5rem;
		position: relative;
		overflow-y: clip;
	}

	.layout {
		display: block;
	}

	.content {
		min-width: 0;
	}

	.page-ribbon {
		position: fixed;
		top: -5.5rem;
		right: 1rem;
		height: 460px;
		transform: rotate(90deg);
		opacity: 0.08;
		pointer-events: none;
		user-select: none;
		filter: blur(2.5px);
		z-index: 0;
	}

	:root[data-theme='dark'] .page-ribbon {
		opacity: 0;
	}

	.section-divider {
		border: none;
		border-top: 1px solid var(--color-border-harsher);
		margin: 0;
	}


	.footer-wrap {
		position: relative;
		z-index: 1;
	}

	@media (max-width: 44rem) {
		.page {
			padding: 4rem 2rem 0;
		}
	}

	:global(html[data-stagger-init] .stagger-in),
	:global(html[data-stagger-init] .hero-top-row) {
		opacity: 0;
	}
</style>

