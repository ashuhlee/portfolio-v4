---
import Layout from '@/layouts/Layout.astro';
import DitherBackground from '@/components/webgl/dither/DitherBackground.astro';
import PixelBlastBackground from '@/components/webgl/pixelblast/PixelBlastBackground.astro';
import BackButton from '@/components/layout/BackButton.astro';
import DraggableFrame from '@/components/interactive/DraggableFrame.astro';
---

<Layout title="Play — Hi, I'm Ashley" starColor="var(--color-brand-pink)">
	<DitherBackground slot="background" color={['grey']} />
	<PixelBlastBackground slot="background" visibleInTheme="dark" />
	<div class="page">
		<BackButton />

		<h1 class="stagger-in">UNDER CONSTRUCTION</h1>
		<p class="description stagger-in">Looks like this page has no content yet &nbsp;(◞‸◟；)</p>

		<DraggableFrame />
	</div>
</Layout>

<style>
	.page {
		max-width: 50rem;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem;
	}

	h1 {
		font-family: var(--font-display), sans-serif;
		font-size: var(--font-size-20);
		margin: 0;
		color: var(--color-text-primary);
	}

	.description {
		font-size: var(--font-size-15);
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0.75rem 0 0;
		max-width: 31.875rem;
	}
</style>
