---
import Layout from '../layouts/Layout.astro';
import DitherBackground from '../components/home/DitherBackground.astro';
import BackButton from '../components/BackButton.astro';
---

<Layout title="Extras - Ashley O">
	<DitherBackground slot="background" color={['grey']} />
	<div class="page">
		<BackButton />

		<h1 class="stagger-in">Under construction</h1>
		<p class="description stagger-in">Come back in the future!</p>
	</div>
</Layout>

<style>
	.page {
		max-width: 800px;
		margin: 0 auto;
		padding: 40px 24px 64px;
	}

	h1 {
		font-family: var(--font-display), sans-serif;
		font-size: 20px;
		margin: 0;
		color: var(--color-ink);
	}

	.description {
		font-size: 15px;
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 12px 0 0;
		max-width: 510px;
	}
</style>
