---
import Layout from '../layouts/Layout.astro';
import DitherBackground from '../components/dither/DitherBackground.astro';
import BackButton from '../components/common/BackButton.astro';
---

<Layout title="Extras - Ashley O">
	<DitherBackground slot="background" color={['grey']} />
	<div class="page">
		<BackButton />

		<h1 class="stagger-in">Under construction</h1>
		<p class="description stagger-in">Come back in the future!</p>
	</div>
</Layout>

<style>
	.page {
		max-width: 50rem;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem;
	}

	h1 {
		font-family: var(--font-display), sans-serif;
		font-size: 1.25rem;
		margin: 0;
		color: var(--color-ink);
	}

	.description {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0.75rem 0 0;
		max-width: 31.875rem;
	}
</style>
