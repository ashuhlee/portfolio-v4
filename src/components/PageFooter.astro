<footer class="page-footer">
	<p class="copyright">© ashuhlee 2026</p>
	<nav class="footer-links">
		<a href="https://www.linkedin.com/in/ashuhlee" target="_blank" rel="noopener noreferrer"><span>LinkedIn</span></a>
		<a href="https://github.com/ashuhlee" target="_blank" rel="noopener noreferrer"><span>GitHub</span></a>
		<a href="mailto:hello@ashuhlee.ca"><span>Email</span></a>
	</nav>
</footer>

<style>
	.page-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-top: 1px solid var(--color-border);
		padding-top: 24px;
	}

	.copyright {
		margin: 0;
		font-size: 13px;
		color: var(--color-ink-muted);
	}

	.footer-links {
		display: flex;
		gap: 4px;
	}

	.footer-links a {
		position: relative;
		display: inline-block;
		padding: 6px 10px;
		font-size: 13px;
		color: var(--color-ink-soft);
		text-decoration: none;
	}

	.footer-links a::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 999px;
		background: #f0f0f0;
		opacity: 0;
		transform: scale(0.7);
		transition:
			opacity 0.15s ease,
			transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.footer-links a:hover::before {
		opacity: 1;
		transform: scale(1);
	}

	.footer-links a span {
		position: relative;
		z-index: 1;
	}

	@media (max-width: 720px) {
		.page-footer {
			flex-direction: column;
			align-items: flex-start;
			gap: 12px;
		}
	}
</style>
