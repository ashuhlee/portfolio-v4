---
import { Image } from 'astro:assets';
import avatarIcon from '../../assets/home/icon-white.png';
---

<section class="profile stagger-in">
	<div class="avatar">
		<div class="avatar-scale">
			<Image class="avatar-icon" src={avatarIcon} width={24} height={24} densities={[1, 2, 3]} alt="" draggable="false" loading="eager" />
		</div>
	</div>
	<div class="who">
		<p class="name">Ashuhlee</p>
		<p class="title">Software Engineer</p>
	</div>
</section>

<p class="bio stagger-in">
	I'm <a class="accent" href="https://www.linkedin.com/in/ashuhlee" target="_blank" rel="noreferrer">Ashley<span class="squiggle-wrap" aria-hidden="true"></span></a>, a computer science student who cares about making software feel intuitive, thoughtful and easy to use.
	I'm interested in mobile and web app development, and currently interning at{' '}
	<a class="accent" href="https://www.sunlife.ca/en/" target="_blank" rel="noreferrer">Sun Life<span class="squiggle-wrap" aria-hidden="true"></span></a> for the fall.
	<br /><br />
	When I'm not working or studying, I'm usually building some random side project, experimenting with
	a new idea, or making things for the internet.
	<br /><br />
	You can reach me via <a class="accent contact" href="https://www.linkedin.com/in/ashuhlee" target="_blank" rel="noreferrer"><span class="scribble-wrap" aria-hidden="true"><svg viewBox="0 0 61 23" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.51228 6.86806C7.33524 7.37598 6.4656 9.54622 5.72332 11.329C4.74692 13.6742 4.05842 15.9853 3.99957 16.8125C3.97185 17.2021 4.10947 17.5334 4.43102 17.6385C5.25263 17.907 8.34035 15.3134 12.922 11.2357C19.2765 5.58015 21.1745 4.02924 21.6097 4.00221C25.5107 3.76001 16.2727 14.1504 15.9453 15.6411C15.8806 15.9358 16.2938 16.1655 16.6087 16.2447C20.6746 17.2674 26.8129 8.61603 29.3733 7.01979C31.7813 5.51856 24.8376 15.9199 24.2297 18.1477C24.0597 18.7704 29.0803 14.0994 34.9694 8.17222C37.0971 6.03078 37.5911 5.76319 37.9038 5.772C38.2166 5.78082 38.3622 6.1035 38.3138 6.59285C37.9235 10.5417 34.7977 15.0105 34.4957 16.1392C33.1583 21.1369 45.1716 7.22995 45.6789 7.21252C48.1 7.12929 45.3691 12.9342 45.7041 14.5595C45.8257 15.1498 46.7615 14.868 47.2842 14.6258C48.1868 14.2076 49.9322 12.4887 52.0783 10.7765C52.4329 10.4937 52.2959 11.8359 52.4854 12.5324C52.5668 12.8313 53.0858 12.7768 53.5968 12.4895C54.1079 12.2022 54.7149 11.6218 55.1628 11.1766C55.6106 10.7313 55.881 10.4387 56.8176 9.50557" stroke="#BEEFFF" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="label">LinkedIn</span></a> or <a class="accent contact" href="mailto:hello@ashuhlee.ca"><span class="label">email</span><span class="circle-wrap" aria-hidden="true"><svg viewBox="0 0 44 28" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20.3993 3.55331C19.1469 3.49497 15.505 3.71142 11.8957 5.0889C10.4195 5.65229 9.16118 6.88586 7.65837 8.51484C4.75021 11.6671 4.31987 14.0285 4.10922 18.0273C4.03035 19.5244 4.90726 20.3954 6.35235 21.9264C6.9823 22.5938 8.64192 23.5423 10.9818 24.8123C12.7021 25.746 15.8549 26.2457 20.2084 26.7318C23.8442 27.1378 26.7205 26.7116 29.0334 26.1649C31.2997 25.6292 33.5305 24.2723 35.8322 22.7419C39.79 20.1103 40.4764 18.0314 41.4928 15.7484C42.8792 12.6342 41.8984 7.85312 40.2963 5.59102C39.5711 4.5669 38.2401 4.02133 36.6498 3.27206C34.539 2.27756 31.0311 1.7285 26.8131 1.22984C22.8319 0.75917 20.2486 1.10477 18.5992 1.43597C15.9007 1.97783 13.0252 3.21521 10.4393 4.5319C7.77796 5.88703 5.75168 7.70822 4.05845 9.33855C3.21374 10.2131 2.39852 11.1835 1.88639 11.9288C1.37426 12.6741 1.18992 13.1649 1 13.6707" stroke="#FE74C6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>, and see my code on <a class="accent contact" href="https://github.com/ashuhlee" target="_blank" rel="noreferrer"><span class="label">GitHub</span><span class="squiggle-wrap" aria-hidden="true"><svg viewBox="0 0 46 3" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.930426 1.39631C0.921394 1.39631 0.912362 1.39631 6.30309 1.31953C11.6938 1.24276 22.4846 1.08921 29.515 1.03021C36.5455 0.971214 39.4886 1.01142 41.2783 1.04292C43.068 1.07441 43.6152 1.09597 44.179 1.11819" stroke="#444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>.
</p>

<script>
	import { gsap } from 'gsap';
	import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

	gsap.registerPlugin(DrawSVGPlugin);

	const SQUIGGLES = [
		// squiggle 1
		'<svg viewBox="0 0 51 5" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M49.6991 0.75C49.5469 0.75 49.3947 0.75 42.8759 0.810386C36.357 0.870773 23.4761 0.991546 15.5825 1.33154C7.68892 1.67153 5.17305 2.22709 3.63803 2.60852C2.10302 2.98995 1.62511 3.18043 0.75 3.69351" stroke="#FF7FD2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
		// squiggle 2
		'<svg viewBox="0 0 57 5" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.75 1.61334C1.02792 1.95992 2.19226 2.94419 3.88018 3.19217C7.68748 3.75149 10.1441 2.03592 11.8716 1.05327C12.4477 0.725579 13.5234 0.681874 14.8578 0.834168C17.2449 1.10661 18.8404 3.55079 20.8385 3.99035C23.9585 4.67673 27.5734 2.80115 29.7553 2.01024C31.1974 1.48755 32.5032 2.49229 35.0206 3.22583C38.3041 4.18266 40.4803 2.5256 42.4073 1.96588C44.3024 1.41544 47.839 3.22933 50.3691 3.73389C51.2377 3.79069 52.6565 4.09021 53.3691 3.73389C55.3691 2.73389 55.0997 2.55215 55.8691 2.01024" stroke="#FF7FD2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
		// squiggle 3
		'<svg viewBox="0 0 48 8" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.607431 0.820646C0.596018 0.809232 11.0638 0.774992 17.1333 0.763406C23.2027 0.75182 35.3534 0.740407 41.4773 0.762887C47.6011 0.785368 47.33 0.842089 45.2772 1.77728C43.2244 2.71248 39.3982 4.52443 37.6464 5.48725C35.8946 6.45008 36.3331 6.50887 37.6889 6.55196C39.0448 6.59505 41.3046 6.62064 43.6329 6.64701" stroke="#FF7FD2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
		// squiggle 4
		'<svg viewBox="0 0 53 4" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.75 2.96192C0.762454 2.96192 3.00656 2.93078 7.81833 2.55693C10.4073 2.35577 13.2351 1.56084 15.4857 1.17456C19.2838 0.522663 21.1032 0.727543 21.4286 1.08451C21.8135 1.50685 21.9547 2.15716 22.2426 2.64082C22.7382 3.4733 25.1686 3.31016 27.9237 2.7505C31.3339 2.05778 34.1761 0.807443 35.5295 0.806818C36.7805 0.806241 37.5379 1.98258 40.2671 1.98472C42.2161 1.98626 43.6181 1.42692 44.4903 1.51589C47.6699 1.9882 51.0396 1.99318 51.567 1.90839C51.811 1.86336 52.0072 1.81426 52.2093 1.76367" stroke="#FF7FD2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
	];

	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLElement>('.avatar-icon').forEach((icon) => {
			let rotation = 0;
			icon.addEventListener('click', () => {
				rotation += 60;
				gsap.to(icon, { rotate: rotation, duration: 0.4, ease: 'back.out(1.7)' });
			});
		});

		document.querySelectorAll<HTMLElement>('.accent').forEach((link) => {
			const wrap = link.querySelector<HTMLElement>('.squiggle-wrap, .circle-wrap, .scribble-wrap');
			if (!wrap) return;

			const isCycling = wrap.classList.contains('squiggle-wrap') && wrap.children.length === 0;
			const isScribble = wrap.classList.contains('scribble-wrap');
			const SCRIBBLE_COLORS = ['#BEEFFF', '#EDFDAD'];

			const initialPath = wrap.querySelector('path');
			if (initialPath) gsap.set(initialPath, { drawSVG: '0%' });

			let index = 0;
			let scribbleIndex = 0;
			let leaveTween: gsap.core.Timeline | null = null;

			link.addEventListener('mouseenter', () => {
				link.classList.add('hovering');

				if (isCycling) {
					index = (index + 1) % SQUIGGLES.length;
					wrap.innerHTML = SQUIGGLES[index];
				}

				const path = wrap.querySelector('path');
				if (!path) return;

				if (isScribble) {
					scribbleIndex = (scribbleIndex + 1) % SCRIBBLE_COLORS.length;
					path.setAttribute('stroke', SCRIBBLE_COLORS[scribbleIndex]);
				}

				leaveTween?.kill();
				gsap.set(wrap, { clearProps: 'opacity' });
				gsap.fromTo(path, { drawSVG: '0%' }, { drawSVG: '100%', duration: 0.4, ease: 'power2.inOut' });
			});

			const resetLink = () => {
				link.classList.remove('hovering');

				const path = wrap.querySelector('path');
				if (!path) return;

				leaveTween = gsap
					.timeline()
					.to(path, { drawSVG: '100% 100%', duration: 0.3, ease: 'power2.in' }, 0)
					.to(wrap, { opacity: 0, duration: 0.1, ease: 'power1.in' }, 0.2);
			};

			link.addEventListener('mouseleave', resetLink);

			link.addEventListener('click', resetLink);
		});
	});
</script>

<style>
	.profile {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.avatar {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		flex-shrink: 0;
	}

	.avatar-scale {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		background: var(--color-brand-pink);
		border-radius: 999px;
	}

	.avatar-icon {
		cursor: pointer;
	}

	//.who .name {
	//	margin: 0;
	//	font-weight: 600;
	//	font-size: var(--font-size-16);
	//	color: var(--color-text-primary);
	//}

	.who .name {
		margin: 0.125rem 0;
		font-weight: 600;
		font-family: var(--font-display), sans-serif;
		text-transform: uppercase;
		font-size: var(--font-size-15);
		color: var(--color-text-primary);
	}

	.who .title {
		margin: 0;
		font-size: var(--font-size-15);
		color: var(--color-text-muted);
	}

	.bio {
		position: relative;
		z-index: 0;
		width: 100%;
		max-width: 37.5rem;
		font-size: var(--font-size-15);
		line-height: 1.5;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.bio .accent {
		position: relative;
		display: inline-block;
		color: var(--color-black);
		font-family: var(--font-sofia), sans-serif;
		font-style: italic;
		text-decoration: none;
	}

	.bio .accent.contact {
		font-style: normal;
		color: var(--color-text-medium);
	}

	.bio .accent.contact::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.2rem;
		height: 0;
		border-bottom: 1px dashed;
		border-bottom-color: var(--color-black) !important;
		opacity: 0.5;
		transition: opacity 0.1s ease;
	}

	.bio .accent.contact.hovering::after {
		opacity: 0;
	}

	.bio .accent .squiggle-wrap {
		position: absolute;
		z-index: -1;
		left: 0;
		bottom: -0.0625rem;
		width: 100%;
		height: 0.5rem;
		pointer-events: none;
	}

	.bio .accent .squiggle-wrap :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	:root[data-theme='dark'] a[href="https://github.com/ashuhlee"] .squiggle-wrap :global(path) {
		stroke: #eaff97;
	}

	.bio .accent .circle-wrap {
		position: absolute;
		z-index: -1;
		left: 50%;
		top: 50%;
		width: calc(100% + 1.25rem);
		height: 2.125rem;
		transform: translate(-50%, -50%);
		pointer-events: none;
	}

	.bio .accent .circle-wrap :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.bio .accent .label {
		position: relative;
		z-index: 1;
		transition: color 0.15s ease;
	}

	.bio .accent .scribble-wrap {
		position: absolute;
		z-index: -1;
		left: 50%;
		top: 50%;
		width: calc(100% + 1rem);
		height: 1.75rem;
		opacity: 0.7;
		transform: translate(-50%, -50%);
		pointer-events: none;
	}

	:root[data-theme='dark'] .bio .accent .scribble-wrap {
		opacity: 0.4;
	}

	.bio .accent.contact.hovering .label {
		color: var(--color-black);
	}

	.bio .accent .scribble-wrap :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
</style>
