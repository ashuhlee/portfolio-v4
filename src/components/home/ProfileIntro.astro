---
---

<section class="profile stagger-in">
	<div class="avatar">
		<div class="avatar-scale">
			<img class="avatar-icon" src="/images/home/icon-white.png" alt="" width="24" height="24" draggable="false" />
		</div>
	</div>
	<div class="who">
		<p class="name">Ashley O</p>
		<p class="title">Software Engineer</p>
	</div>
</section>

<p class="bio stagger-in">
	I'm a computer science student who cares deeply about making software feel intuitive, thoughtful and easy to use.
	I'm interested in mobile and web app development, and currently interning at{' '}
	<a class="accent" href="https://www.sunlife.ca/en/" target="_blank" rel="noreferrer">Sun Life<span class="squiggle-wrap" aria-hidden="true"></span></a> for the fall.
	<br /><br />
	When I'm not working or studying, I'm usually building some random side project, experimenting with
	a new idea, or making things for the internet.
	<br /><br />
	You can reach me via LinkedIn or email, and see my code on GitHub.
</p>

<script>
	import { gsap } from 'gsap';
	import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

	gsap.registerPlugin(DrawSVGPlugin);

	const SQUIGGLES = [
		// squiggle 1
		'<svg viewBox="0 0 48 8" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.607431 0.820646C0.596018 0.809232 11.0638 0.774992 17.1333 0.763406C23.2027 0.75182 35.3534 0.740407 41.4773 0.762887C47.6011 0.785368 47.33 0.842089 45.2772 1.77728C43.2244 2.71248 39.3982 4.52443 37.6464 5.48725C35.8946 6.45008 36.3331 6.50887 37.6889 6.55196C39.0448 6.59505 41.3046 6.62064 43.6329 6.64701" stroke="#FF8AEC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
		// squiggle 2
		'<svg viewBox="0 0 57 5" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.75 1.61334C1.02792 1.95992 2.19226 2.94419 3.88018 3.19217C7.68748 3.75149 10.1441 2.03592 11.8716 1.05327C12.4477 0.725579 13.5234 0.681874 14.8578 0.834168C17.2449 1.10661 18.8404 3.55079 20.8385 3.99035C23.9585 4.67673 27.5734 2.80115 29.7553 2.01024C31.1974 1.48755 32.5032 2.49229 35.0206 3.22583C38.3041 4.18266 40.4803 2.5256 42.4073 1.96588C44.3024 1.41544 47.839 3.22933 50.3691 3.73389C51.2377 3.79069 52.6565 4.09021 53.3691 3.73389C55.3691 2.73389 55.0997 2.55215 55.8691 2.01024" stroke="#FF8AEC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
		// squiggle 3
		'<svg viewBox="0 0 51 5" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M49.6991 0.75C49.5469 0.75 49.3947 0.75 42.8759 0.810386C36.357 0.870773 23.4761 0.991546 15.5825 1.33154C7.68892 1.67153 5.17305 2.22709 3.63803 2.60852C2.10302 2.98995 1.62511 3.18043 0.75 3.69351" stroke="#9EE0FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
		// squiggle 4
		'<svg viewBox="0 0 53 4" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.75 2.96192C0.762454 2.96192 3.00656 2.93078 7.81833 2.55693C10.4073 2.35577 13.2351 1.56084 15.4857 1.17456C19.2838 0.522663 21.1032 0.727543 21.4286 1.08451C21.8135 1.50685 21.9547 2.15716 22.2426 2.64082C22.7382 3.4733 25.1686 3.31016 27.9237 2.7505C31.3339 2.05778 34.1761 0.807443 35.5295 0.806818C36.7805 0.806241 37.5379 1.98258 40.2671 1.98472C42.2161 1.98626 43.6181 1.42692 44.4903 1.51589C47.6699 1.9882 51.0396 1.99318 51.567 1.90839C51.811 1.86336 52.0072 1.81426 52.2093 1.76367" stroke="#FF8AEC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
	];

	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLElement>('.avatar-icon').forEach((icon) => {
			let rotation = 0;
			icon.addEventListener('click', () => {
				rotation += 60;
				gsap.to(icon, { rotate: rotation, duration: 0.4, ease: 'back.out(1.7)' });
			});
		});

		document.querySelectorAll<HTMLElement>('.accent').forEach((link) => {
			const wrap = link.querySelector<HTMLElement>('.squiggle-wrap');
			if (!wrap) return;

			let index = 0;
			let leaveTween: gsap.core.Tween | null = null;

			link.addEventListener('mouseenter', () => {
				index = (index + 1) % SQUIGGLES.length;
				wrap.innerHTML = SQUIGGLES[index];
				const path = wrap.querySelector('path');
				if (!path) return;

				leaveTween?.kill();
				gsap.fromTo(path, { drawSVG: '0%' }, { drawSVG: '100%', duration: 0.4, ease: 'power2.inOut' });
			});

			link.addEventListener('mouseleave', () => {
				const path = wrap.querySelector('path');
				if (!path) return;

				leaveTween = gsap.to(path, { drawSVG: '100% 100%', duration: 0.3, ease: 'power2.in' });
			});
		});
	});
</script>

<style>
	.profile {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 32px;
	}

	.avatar {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		flex-shrink: 0;
	}

	.avatar-scale {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		background: var(--color-main);
		border-radius: 999px;
	}

	.avatar-icon {
		cursor: pointer;
	}

	.who .name {
		margin: 0;
		font-weight: 600;
		font-size: 16px;
		color: var(--color-ink);
	}

	.who .title {
		margin: 0;
		font-size: 15px;
		color: var(--color-ink-soft);
	}

	.bio {
		width: 100%;
		max-width: 600px;
		font-size: 15px;
		line-height: 1.5;
		color: var(--color-ink-medium);
		margin: 0;
	}

	.bio .accent {
		position: relative;
		display: inline-block;
		color: var(--color-accent);
		font-family: var(--font-sofia), sans-serif;
		font-style: italic;
		text-decoration: none;
	}

	.bio .accent .squiggle-wrap {
		position: absolute;
		left: 0;
		bottom: -4px;
		width: 100%;
		height: 8px;
		pointer-events: none;
	}

	.bio .accent .squiggle-wrap :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
</style>
