---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<hr class:list={['divider', className]} aria-hidden="true" />

<style>
	.divider {
		display: block;
		width: 100%;
		height: 0;
		margin: 2rem 0;
		border: none;
		border-top: 1px dashed #d0d0d0;
	}

	:root[data-theme='dark'] .divider {
		border-top-color: #2f2e31;
	}


</style>
