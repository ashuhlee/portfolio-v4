---
import { Image } from 'astro:assets';
import star from '@/assets/home/star-outline.svg';
import terminal from '@/assets/home/doodle-image.png';
import folder from '@/assets/home/folder-pink.png';
import folderDark from '@/assets/home/folder-purple.png';
import cursor from '@/assets/home/cursor-pointer.svg';
import squiggle from '@/assets/home/squiggle1.svg';
import arc from '@/assets/home/arc.svg';
---

<div class="doodles-top">
	<button class="doodles-reset" type="button" aria-label="Reset sticker positions">↺</button>
</div>

<section class="doodles" aria-hidden="true">
	<span class="doodle badge dark">Currently seeking</span>
	<span class="doodle badge cyan">Summer 2027 positions</span>

	<Image src={star} alt="" class="doodle star" />
	<Image src={terminal} alt="" class="doodle terminal" />
	<Image src={folder} alt="" class="doodle folder folder--light" />
	<Image src={folderDark} alt="" class="doodle folder folder--dark" />
	<Image src={cursor} alt="" class="doodle cursor" />
	<Image src={squiggle} alt="" class="doodle squiggle" />
	<Image src={arc} alt="" class="doodle arc" />
</section>

<script>
	import { gsap } from 'gsap';
	import { Draggable } from 'gsap/Draggable';
	import { InertiaPlugin } from 'gsap/InertiaPlugin';

	gsap.registerPlugin(Draggable, InertiaPlugin);

	document.addEventListener('astro:page-load', () => {
		const doodles = document.querySelectorAll<HTMLElement>('.doodle');
		doodles.forEach((el) => Draggable.get(el)?.kill());

		const resetButton = document.querySelector<HTMLButtonElement>('.doodles-reset');
		resetButton?.classList.remove('visible');
		if (resetButton) gsap.set(resetButton, { display: 'none', opacity: 0, rotate: 30 });

		function showResetButton() {
			if (!resetButton || resetButton.classList.contains('visible')) return;
			resetButton.classList.add('visible');
			gsap.set(resetButton, { display: 'flex' });
			gsap.fromTo(
				resetButton,
				{ opacity: 0, rotate: -180 },
				{ opacity: 1, rotate: 0, duration: 0.3, ease: 'back.out(1.7)' }
			);
		}

		function hideResetButton() {
			if (!resetButton) return;
			resetButton.classList.remove('visible');
			gsap.to(resetButton, {
				opacity: 0,
				duration: 0.2,
				ease: 'power2.in',
				onComplete() {
					gsap.set(resetButton, { display: 'none' });
				},
			});
		}

		if (doodles.length) {
			Draggable.create(doodles, {
				type: 'x,y',
				bounds: '.doodles',
				inertia: true,
				cursor: 'grab',
				activeCursor: 'grabbing',
				onPress() {
					gsap.to(this.target, { scale: 0.9, duration: 0.2, ease: 'power2.out' });
				},
				onRelease() {
					gsap.to(this.target, { scale: 1, duration: 0.4, ease: 'elastic.out(1, 0.5)' });
				},
				onDragEnd() {
					showResetButton();
				},
			});
		}

		resetButton?.addEventListener('click', () => {
			gsap.to(doodles, {
				x: 0,
				y: 0,
				scale: 1,
				duration: 0.8,
				ease: 'elastic.out(1, 0.6)',
				stagger: 0.03,
			});
			hideResetButton();
		});

		resetButton?.addEventListener('mousedown', () => {
			gsap.to(resetButton, { scale: 0.85, duration: 0.15, ease: 'power2.out' });
		});

		['mouseup', 'mouseleave'].forEach((eventName) => {
			resetButton?.addEventListener(eventName, () => {
				gsap.to(resetButton, { scale: 1, duration: 0.6, ease: 'elastic.out(1, 0.5)' });
			});
		});
	});
</script>

<style>
	.doodles-top {
		position: relative;
		z-index: 1;
		max-width: 37.5rem;
		margin: 0 auto;
	}

	.doodles-reset {
		display: none;
		position: absolute;
		top: 0;
		right: 0;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		background: var(--color-gray-lighter);
		border: none;
		border-radius: 999px;
		font-family: inherit;
		font-size: var(--font-size-18);
		line-height: 1;
		color: var(--color-text-primary);
		cursor: pointer;
		opacity: 0;
	}

	:root[data-theme='dark'] .doodles-reset {
		background: #25232c;
	}

	.doodles {
		position: relative;
		width: 100%;
		max-width: 37.5rem;
		aspect-ratio: 1245 / 543;
		margin: 0.75rem auto 0.75rem;
	}

	.doodle {
		position: absolute;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		padding: 0.375rem 0.75rem 0.5rem 0.75rem;
		font-weight: 600;
		font-size: var(--font-size-14);
		line-height: 1.1;
		white-space: nowrap;
	}

	.badge.dark {
		left: 23%;
		top: 30.4%;
		background: #393939;
		color: var(--color-lime-bright);
		transform: rotate(-2deg);
	}

	:root[data-theme='dark'] .badge.dark {
		background: #FFA7E8;
		color: #000000;
	}

	.badge.cyan {
		left: 38%;
		top: 40%;
		background: #A4E8FF;
		color: #000000;
		transform: rotate(2deg);
	}

	.star {
		left: 47%;
		top: 20%;
		transform: rotate(10deg);
		width: 6.5%;
		height: auto;
	}

	.terminal {
		left: 69%;
		top: 20.8%;
		transform: rotate(-5deg);
		width: 9.9%;
		height: auto;
		border-radius: 22%;
	}

	.folder {
		left: 16%;
		top: 50%;
		width: 10.6%;
		height: auto;
		transform: rotate(5deg);
	}

	.cursor {
		left: 21.5%;
		top: 64%;
		width: 6%;
		height: auto;
		transform: rotate(-6.5deg);
	}

	.squiggle {
		left: 47%;
		top: 47%;
		width: 12%;
		height: auto;
		transform: rotate(45deg);
	}

	.arc {
		left: 71%;
		top: 61%;
		transform: rotate(7deg);
		width: 11%;
		height: auto;
	}

		.folder--dark {
		display: none;
	}

	:root[data-theme='dark'] .folder--light {
		display: none;
	}

	:root[data-theme='dark'] .folder--dark {
		display: block;
	}

	:root[data-theme='dark'] .star,
	:root[data-theme='dark'] .squiggle {
		filter: invert(1);
	}

	@media (max-width: 37.5rem) {
		.doodles {
			transform: scale(0.85);
			transform-origin: top center;
			margin: 3rem auto;
		}
	}
</style>
