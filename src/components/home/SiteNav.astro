---
---

<header class="nav">
	<nav class="links">
		<a class="link-home" href="/"><span>Home.</span></a>
		<a class="link-extras" href="/extras"><span>Extras</span><span class="bracket-right">]</span></a>
	</nav>
	<div class="right-side">
		<button class="theme-toggle" type="button" aria-label="Switch to dark mode">
			<svg
				class="icon-sun"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<path
					fill-rule="evenodd"
					clip-rule="evenodd"
					d="M12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16ZM12 18C15.3137 18 18 15.3137 18 12C18 8.68629 15.3137 6 12 6C8.68629 6 6 8.68629 6 12C6 15.3137 8.68629 18 12 18Z"
					fill="currentColor"
				/>
				<path
					fill-rule="evenodd"
					clip-rule="evenodd"
					d="M11 0H13V4.06189C12.6724 4.02104 12.3387 4 12 4C11.6613 4 11.3276 4.02104 11 4.06189V0ZM7.0943 5.68018L4.22173 2.80761L2.80752 4.22183L5.6801 7.09441C6.09071 6.56618 6.56608 6.0908 7.0943 5.68018ZM4.06189 11H0V13H4.06189C4.02104 12.6724 4 12.3387 4 12C4 11.6613 4.02104 11.3276 4.06189 11ZM5.6801 16.9056L2.80751 19.7782L4.22173 21.1924L7.0943 18.3198C6.56608 17.9092 6.09071 17.4338 5.6801 16.9056ZM11 19.9381V24H13V19.9381C12.6724 19.979 12.3387 20 12 20C11.6613 20 11.3276 19.979 11 19.9381ZM16.9056 18.3199L19.7781 21.1924L21.1923 19.7782L18.3198 16.9057C17.9092 17.4339 17.4338 17.9093 16.9056 18.3199ZM19.9381 13H24V11H19.9381C19.979 11.3276 20 11.6613 20 12C20 12.3387 19.979 12.6724 19.9381 13ZM18.3198 7.0943L21.1923 4.22183L19.7781 2.80762L16.9056 5.6801C17.4338 6.09071 17.9092 6.56608 18.3198 7.0943Z"
					fill="currentColor"
				/>
			</svg>
			<svg
				class="icon-moon"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<path
					fill-rule="evenodd"
					clip-rule="evenodd"
					d="M12.2256 2.00253C9.59172 1.94346 6.93894 2.9189 4.92893 4.92891C1.02369 8.83415 1.02369 15.1658 4.92893 19.071C8.83418 22.9763 15.1658 22.9763 19.0711 19.071C21.0811 17.061 22.0565 14.4082 21.9975 11.7743C21.9796 10.9772 21.8669 10.1818 21.6595 9.40643C21.0933 9.9488 20.5078 10.4276 19.9163 10.8425C18.5649 11.7906 17.1826 12.4053 15.9301 12.6837C14.0241 13.1072 12.7156 12.7156 12 12C11.2844 11.2844 10.8928 9.97588 11.3163 8.0699C11.5947 6.81738 12.2094 5.43511 13.1575 4.08368C13.5724 3.49221 14.0512 2.90664 14.5935 2.34046C13.8182 2.13305 13.0228 2.02041 12.2256 2.00253ZM17.6569 17.6568C18.9081 16.4056 19.6582 14.8431 19.9072 13.2186C16.3611 15.2643 12.638 15.4664 10.5858 13.4142C8.53361 11.362 8.73568 7.63895 10.7814 4.09281C9.1569 4.34184 7.59434 5.09193 6.34315 6.34313C3.21895 9.46732 3.21895 14.5326 6.34315 17.6568C9.46734 20.781 14.5327 20.781 17.6569 17.6568Z"
					fill="currentColor"
				/>
			</svg>
		</button>
		<a class="say-hello opacity-60" data-bounce="0.8" href="mailto:hello@ashuhlee.ca">
			<span class="inner-shadow" aria-hidden="true"></span>
			<span>say hello</span>
			<span class="arrow-track">
				<span class="arrow" aria-hidden="true">!</span>
			</span>
		</a>
	</div>
</header>

<script>
	const leading = ['!', '!!', ':3', '!?', ':D'];

	document.addEventListener('astro:page-load', () => {
		const sayHello = document.querySelector<HTMLElement>('.say-hello');
		const arrow = sayHello?.querySelector<HTMLElement>('.arrow');
		if (!sayHello || !arrow) return;

		let index = 0;
		sayHello.addEventListener('mouseenter', () => {
			arrow.textContent = leading[index];
			index = (index + 1) % leading.length;
		});
	});

	document.addEventListener('astro:page-load', () => {
		const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
		if (!toggle) return;

		const setLabel = (theme: string) => {
			toggle.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
		};

		setLabel(document.documentElement.getAttribute('data-theme') || 'light');

		let transitionInProgress = false;

		toggle.addEventListener('click', () => {
			if (transitionInProgress) return;

			const current = document.documentElement.getAttribute('data-theme') || 'light';
			const next = current === 'dark' ? 'light' : 'dark';

			const applyTheme = () => {
				document.documentElement.setAttribute('data-theme', next);
				localStorage.setItem('theme', next);
				setLabel(next);
			};
			if (!document.startViewTransition) {
				applyTheme();
				return;
			}

			transitionInProgress = true;
			document.documentElement.setAttribute('data-theme-transition', next === 'dark' ? 'down' : 'up');
			const transition = document.startViewTransition(applyTheme);
			transition.ready.catch(() => {});
			transition.finished.catch(() => {}).finally(() => {
				document.documentElement.removeAttribute('data-theme-transition');
				transitionInProgress = false;
			});
		});
	});
</script>

<style>
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 1.71875rem;
		margin-bottom: 4rem;
	}

	.links {
		display: flex;
		align-items: center;
		gap: 0;
		margin-left: -0.625rem;
	}

	.links a {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 0.375rem 0.625rem;
		font-family: var(--font-mono), monospace;
		text-transform: uppercase;
		font-size: var(--font-size-13);
		color: var(--color-text-nav);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.links a::before {
		content: '';
		position: absolute;
		left: 0;
		width: 0.625rem;
		text-align: right;
		opacity: 0;
		pointer-events: none;
	}

	.links a.link-home::before {
		content: '\5C';
	}

	.links a.link-extras::before {
		content: '[';
	}

	.links a .bracket-right {
		position: absolute;
		right: 0;
		width: 0.625rem;
		text-align: left;
		opacity: 0;
		pointer-events: none;
	}

	.links a:hover {
		color: var(--color-brand-pink);
	}

	.links a.link-extras:hover {
	}

	.links a:hover::before {
		opacity: 1;
	}

	.links a:hover .bracket-right {
		opacity: 1;
	}

	.links a span {
		position: relative;
		z-index: 1;
	}

	.slash {
		color: var(--color-gray-mid);
		opacity: 0.5;
	}

	.right-side {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: none;
		background: transparent;
		padding: 0;
		color: var(--color-text-primary);
		cursor: pointer;
		transition: color 0.15s ease;
	}

	.theme-toggle:hover {
		color: var(--color-brand-pink);
	}

	.theme-toggle svg {
		display: block;
		width: 1rem;
		height: 1rem;
	}

	.theme-toggle .icon-sun {
		display: none;
	}

	:root[data-theme='dark'] .theme-toggle .icon-sun {
		display: block;
	}

	:root[data-theme='dark'] .theme-toggle .icon-moon {
		display: none;
	}

	.say-hello {
		position: relative;
		display: inline-flex;
		align-items: center;
		background: var(--color-brand-cyan);
		border-radius: 999px;
		padding: 0.375rem 0.625rem;
		font-family: var(--font-sofia), sans-serif;
		font-style: italic;
		font-weight: 500;
		font-size: var(--font-size-15);
		color: #000000;
		text-decoration: none;
		transition: padding 0.35s ease;
	}
	.say-hello:hover {
			font-weight: 600;
	}
	.say-hello::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 999px;
		background: var(--color-navy-deep);
		opacity: 0;
		transform: scale(0.7);
		transition:
			opacity 0.15s ease,
			transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.say-hello:hover::before {
		opacity: 1;
		transform: scale(1);
	}

	.say-hello .inner-shadow {
		position: absolute;
		inset: 0;
		z-index: 2;
		border-radius: 999px;
		box-shadow:
			inset 2px 2px 2px 0 rgba(255, 255, 255, 0.60),
			inset 2px -2px 2px 0 rgba(0, 0, 0, 0.50);
		mix-blend-mode: overlay;
		pointer-events: none;
	}

	.say-hello:hover {
		padding: 0.6rem 0.875rem;
		color: var(--color-brand-cyan);
	}

	:root[data-theme='dark'] .say-hello::before {
		background: #a4e8ff;
	}

	:root[data-theme='dark'] .say-hello:hover {
		color: #000000;
	}

	.say-hello span {
		position: relative;
		z-index: 1;
	}

	.say-hello .arrow-track {
		display: grid;
		grid-template-columns: 0fr;
		transition: grid-template-columns 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.say-hello:hover .arrow-track {
		grid-template-columns: 1fr;
	}

	.say-hello .arrow {
		position: relative;
		z-index: 1;
		overflow: hidden;
		min-width: 0;
		opacity: 0;
		white-space: nowrap;
		transform: translateX(-0.25rem);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.say-hello:hover .arrow {
		padding-left: 0.125rem;
		opacity: 1;
		transform: translateX(0);
	}
</style>
