---
---

<header class="nav">
	<nav class="links">
		<a class="link-home" href="/"><span>Home.</span></a>
		<!--<span class="slash">\</span>-->
		<a class="link-extras" href="/extras"><span>Extras</span><span class="bracket-right">]</span></a>
	</nav>
	<div class="right-side">
		<button class="theme-toggle" type="button" aria-label="Toggle dark mode">dark mode</button>
		<a class="say-hello opacity-60" data-bounce="0.8" href="mailto:hello@ashuhlee.ca">
			<span>say hello</span>
			<span class="arrow-track">
				<span class="arrow" aria-hidden="true">!</span>
			</span>
		</a>
	</div>
</header>

<script>
	const leading = ['!', '!!', ':3', '!?', ':D'];

	document.addEventListener('astro:page-load', () => {
		const sayHello = document.querySelector<HTMLElement>('.say-hello');
		const arrow = sayHello?.querySelector<HTMLElement>('.arrow');
		if (!sayHello || !arrow) return;

		let index = 0;
		sayHello.addEventListener('mouseenter', () => {
			arrow.textContent = leading[index];
			index = (index + 1) % leading.length;
		});
	});

	// swap for icon
	document.addEventListener('astro:page-load', () => {
		const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
		if (!toggle) return;

		const setLabel = (theme: string) => {
			toggle.textContent = theme === 'dark' ? '</3' : '<3';
		};

		setLabel(document.documentElement.getAttribute('data-theme') || 'light');

		let transitionInProgress = false;

		toggle.addEventListener('click', () => {
			if (transitionInProgress) return;

			const current = document.documentElement.getAttribute('data-theme') || 'light';
			const next = current === 'dark' ? 'light' : 'dark';

			const applyTheme = () => {
				document.documentElement.setAttribute('data-theme', next);
				localStorage.setItem('theme', next);
				setLabel(next);
			};
			if (!document.startViewTransition) {
				applyTheme();
				return;
			}

			transitionInProgress = true;
			document.documentElement.setAttribute('data-theme-transition', next === 'dark' ? 'down' : 'up');
			const transition = document.startViewTransition(applyTheme);
			transition.ready.catch(() => {});
			transition.finished.catch(() => {}).finally(() => {
				document.documentElement.removeAttribute('data-theme-transition');
				transitionInProgress = false;
			});
		});
	});
</script>

<style>
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 1.71875rem;
		margin-bottom: 4rem;
	}

	.links {
		display: flex;
		align-items: center;
		gap: 0;
		margin-left: -0.625rem;
	}

	.links a {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 0.375rem 0.625rem;
		font-family: var(--font-mono), monospace;
		text-transform: uppercase;
		font-size: var(--font-size-13);
		color: var(--color-text-nav);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.links a::before {
		content: '';
		position: absolute;
		left: 0;
		width: 0.625rem;
		text-align: right;
		opacity: 0;
		pointer-events: none;
	}

	.links a.link-home::before {
		content: '\5C';
	}

	.links a.link-extras::before {
		content: '[';
	}

	.links a .bracket-right {
		position: absolute;
		right: 0;
		width: 0.625rem;
		text-align: left;
		opacity: 0;
		pointer-events: none;
	}

	.links a:hover {
		color: var(--color-brand-pink);
	}

	.links a.link-extras:hover {
	}

	.links a:hover::before {
		opacity: 1;
	}

	.links a:hover .bracket-right {
		opacity: 1;
	}

	.links a span {
		position: relative;
		z-index: 1;
	}

	.slash {
		color: var(--color-gray-mid);
		opacity: 0.5;
	}

	.right-side {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.theme-toggle {
		border: none;
		background: transparent;
		padding: 0;
		font-family: var(--font-mono), monospace;
		text-transform: uppercase;
		font-size: var(--font-size-13);
		color: var(--color-text-secondary);
		cursor: pointer;
		transition: color 0.15s ease;
	}

	.theme-toggle:hover {
		color: var(--color-brand-pink);
	}

	.say-hello {
		position: relative;
		display: inline-flex;
		align-items: center;
		background: var(--color-brand-cyan);
		border-radius: 999px;
		padding: 0.375rem 0.625rem;
		font-family: var(--font-sofia), sans-serif;
		font-style: italic;
		font-weight: 500;
		font-size: var(--font-size-15);
		color: #000000;
		text-decoration: none;
		transition: padding 0.35s ease;
	}
	.say-hello:hover {
			font-weight: 600;
	}
	.say-hello::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 999px;
		background: var(--color-navy-deep);
		opacity: 0;
		transform: scale(0.7);
		transition:
			opacity 0.15s ease,
			transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.say-hello:hover::before {
		opacity: 1;
		transform: scale(1);
	}

	.say-hello:hover {
		padding: 0.6rem 0.875rem;
		color: var(--color-brand-cyan);
	}

	:root[data-theme='dark'] .say-hello::before {
		background: #a4e8ff;
	}

	:root[data-theme='dark'] .say-hello:hover {
		color: #000000;
	}

	.say-hello span {
		position: relative;
		z-index: 1;
	}

	.say-hello .arrow-track {
		display: grid;
		grid-template-columns: 0fr;
		transition: grid-template-columns 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.say-hello:hover .arrow-track {
		grid-template-columns: 1fr;
	}

	.say-hello .arrow {
		position: relative;
		z-index: 1;
		overflow: hidden;
		min-width: 0;
		opacity: 0;
		white-space: nowrap;
		transform: translateX(-0.25rem);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.say-hello:hover .arrow {
		padding-left: 0.125rem;
		opacity: 1;
		transform: translateX(0);
	}
</style>
