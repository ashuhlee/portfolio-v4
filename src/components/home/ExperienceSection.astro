---
import SectionHeader from './SectionHeader.astro';

interface Experience {
	role: string;
	when: string;
	dot: string;
}

interface Props {
	experiences: Experience[];
}

const { experiences } = Astro.props;
---

<section class="section" id="experience">
	<div class="stagger-in">
		<SectionHeader title="Experience">
			<div class="icon-button" aria-hidden="true">
				<div class="icon-button-scale lime">
					<img src="/images/home/see-work-arrow-icon.svg" alt="" width="28" height="28" />
				</div>
			</div>
		</SectionHeader>
	</div>

	<div class="timeline-wrap">
		<ul class="timeline">
			{
				experiences.map((exp) => (
					<li class="stagger-in">
						<span class="timeline-dot" style={{ backgroundColor: exp.dot }} />
						<div>
							<p class="role">{exp.role}</p>
							<p class="when">{exp.when}</p>
						</div>
					</li>
				))
			}
		</ul>

		<a class="see-work opacity-60 stagger-in" data-bounce="0.88" href="/work/pesa">
			<span>See work</span>
			<span class="arrow-track">
				<span class="arrow" aria-hidden="true">→</span>
			</span>
		</a>
	</div>
</section>

<script>
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll('.icon-button').forEach((el) => {
			el.addEventListener('mouseenter', () => {
				el.classList.toggle('flipped');
			});
		});
	});
</script>

<style>
	.icon-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		transform: rotate(8.5deg);
	}

	.icon-button.flipped {
		transform: rotate(-8.5deg);
	}

	.icon-button-scale {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		border-radius: 999px;
	}

	.icon-button-scale.lime {
		background: #edfdad;
	}

	.timeline-wrap {
		display: grid;
		grid-template-columns: 1fr auto;
		column-gap: 16px;
		row-gap: 20px;
	}

	.timeline {
		display: contents;
	}

	.timeline li {
		grid-column: 1;
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: flex-start;
		gap: 10px;
	}

	.timeline-dot {
		width: 7px;
		height: 7px;
		margin-top: 7px;
		flex-shrink: 0;
	}

	.role {
		margin: 0 0 4px;
		font-weight: 500;
		font-size: 15px;
		color: #000;
	}

	.when {
		margin: 0;
		font-size: 14px;
		color: #595d62;
	}

	.see-work {
		position: relative;
		grid-column: 2;
		grid-row: 2;
		align-self: center;
		justify-self: end;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: #f3f3f3;
		border-radius: 999px;
		padding: 4px 12px;
		font-size: 14px;
		font-weight: 500;
		color: #383838;
		text-decoration: none;
		white-space: nowrap;
		transition: padding 0.35s ease;
	}

	.see-work::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 999px;
		background: #222C25;
		opacity: 0;
		transform: scale(0.7);
		transition:
			opacity 0.15s ease,
			transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.see-work:hover::before {
		opacity: 1;
		transform: scale(1);
	}
	.see-work:hover {
		padding: 6px 16px;
		color: #EDFDAD;
	}
	.see-work span {
		position: relative;
		z-index: 1;
	}

	.see-work .arrow-track {
		display: grid;
		grid-template-columns: 0fr;
		transition: grid-template-columns 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.see-work:hover .arrow-track {
		grid-template-columns: 1fr;
	}

	.see-work .arrow {
		position: relative;
		z-index: 1;
		overflow: hidden;
		min-width: 0;
		opacity: 0;
		transform: translateX(-4px);
		transition:
			opacity 0.3s ease,
			transform 0.15s ease;
	}

	.see-work:hover .arrow {
		padding-left: 2px;
		opacity: 1;
		transform: translateX(4px);
	}

	@media (max-width: 600px) {
		.timeline-wrap {
			grid-template-columns: 1fr;
		}

		.see-work {
			grid-column: 1;
			grid-row: auto;
			justify-self: start;
			margin-top: 4px;
		}
	}
</style>
