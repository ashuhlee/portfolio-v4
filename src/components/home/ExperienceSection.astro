---
import SectionHeader from './SectionHeader.astro';

interface Experience {
	role: string;
	when: string;
	dot: string;
}

interface Props {
	experiences: Experience[];
}

const { experiences } = Astro.props;
---

<section class="section" id="experience">
	<SectionHeader title="Experience">
		<div class="icon-button" aria-hidden="true">
			<div class="icon-button-scale lime">
				<img src="/images/home/see-work-arrow-icon.svg" alt="" width="28" height="28" />
			</div>
		</div>
	</SectionHeader>

	<div class="timeline-wrap">
		<ul class="timeline">
			{
				experiences.map((exp) => (
					<li>
						<span class="timeline-dot" style={{ backgroundColor: exp.dot }} />
						<div>
							<p class="role">{exp.role}</p>
							<p class="when">{exp.when}</p>
						</div>
					</li>
				))
			}
		</ul>

		<a class="see-work" href="#">See work</a>
	</div>
</section>

<script>
	document.querySelectorAll('.icon-button').forEach((el) => {
		el.addEventListener('mouseenter', () => {
			el.classList.toggle('flipped');
		});
	});
</script>

<style>
	.icon-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		transform: rotate(8.5deg);
	}

	.icon-button.flipped {
		transform: rotate(-8.5deg);
	}

	.icon-button-scale {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		border-radius: 999px;
		transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.icon-button-scale.lime {
		background: #edfdad;
	}

	.icon-button:active .icon-button-scale {
		transform: scale(0.85);
		transition: transform 0.08s ease-out;
	}

	.timeline-wrap {
		display: grid;
		grid-template-columns: 1fr auto;
		column-gap: 16px;
		row-gap: 20px;
	}

	.timeline {
		display: contents;
	}

	.timeline li {
		grid-column: 1;
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: flex-start;
		gap: 10px;
	}

	.timeline-dot {
		width: 7px;
		height: 7px;
		margin-top: 7px;
		flex-shrink: 0;
	}

	.role {
		margin: 0 0 4px;
		font-weight: 500;
		font-size: 14px;
		color: #000;
	}

	.when {
		margin: 0;
		font-size: 13px;
		color: #595d62;
	}

	.see-work {
		grid-column: 2;
		grid-row: 2;
		align-self: center;
		justify-self: end;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: #f3f3f3;
		border-radius: 999px;
		padding: 4px 12px;
		font-size: 12px;
		color: #383838;
		text-decoration: none;
		white-space: nowrap;
	}

	@media (max-width: 600px) {
		.timeline-wrap {
			grid-template-columns: 1fr;
		}

		.see-work {
			grid-column: 1;
			grid-row: auto;
			justify-self: start;
			margin-top: 4px;
		}
	}
</style>
