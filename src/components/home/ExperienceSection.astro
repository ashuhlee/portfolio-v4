---
import SectionHeader from './SectionHeader.astro';

interface Experience {
	role: string;
	when: string;
	dot: string;
}

interface Props {
	experiences: Experience[];
}

const { experiences } = Astro.props;
---

<section class="section" id="experience">
	<div class="stagger-in">
		<SectionHeader title="Experience">
			<button class="icon-button" type="button" aria-label="Change sticker color">
				<div class="icon-button-scale">
					<svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" data-bounce="0.95">
						<path
							d="M20.2217 16.7115C18.926 18.7855 16.6252 20.1675 14 20.1677C11.3863 20.1675 9.09354 18.7981 7.79499 16.7393L9.36713 15.7952C10.3444 17.321 12.0536 18.3336 14 18.3337C16.0465 18.3336 17.8305 17.2142 18.7777 15.5557L20.2217 16.7115Z"
							fill="currentColor"
						/>
						<path
							d="M10.3335 8.4996C11.346 8.49971 12.1661 9.32108 12.1661 10.3335C12.166 11.3459 11.3459 12.166 10.3335 12.1661C9.32108 12.1661 8.49971 11.346 8.4996 10.3335C8.4996 9.32101 9.32101 8.4996 10.3335 8.4996Z"
							fill="currentColor"
						/>
						<path
							d="M17.6665 8.4996C18.679 8.4996 19.5004 9.32101 19.5004 10.3335C19.5003 11.346 18.6789 12.1661 17.6665 12.1661C16.6541 12.166 15.834 11.3459 15.8339 10.3335C15.8339 9.32108 16.654 8.49971 17.6665 8.4996Z"
							fill="currentColor"
						/>
						<path
							fill-rule="evenodd"
							clip-rule="evenodd"
							d="M14 1.16667C21.0877 1.16667 26.8333 6.91235 26.8333 14C26.8333 21.0877 21.0877 26.8333 14 26.8333C6.91234 26.8333 1.16667 21.0877 1.16667 14C1.16667 6.91235 6.91234 1.16667 14 1.16667ZM14 3.0006C7.92487 3.0006 3.0006 7.92487 3.0006 14C3.0006 20.0751 7.92487 24.9994 14 24.9994C20.0751 24.9994 24.9994 20.0751 24.9994 14C24.9994 7.92487 20.0751 3.0006 14 3.0006Z"
							fill="currentColor"
						/>
					</svg>
				</div>
			</button>
		</SectionHeader>
	</div>

	<div class="timeline-wrap">
		<ul class="timeline">
			{
				experiences.map((exp) => (
					<li class="stagger-in">
						<span class="timeline-dot" style={{ backgroundColor: exp.dot }} />
						<div>
							<p class="role">{exp.role}</p>
							<p class="when">{exp.when}</p>
						</div>
					</li>
				))
			}
		</ul>

		<a class="see-work opacity-60 stagger-in" data-bounce="0.88" href="/work/pesa">
			<span>See work</span>
			<span class="arrow-track">
				<span class="arrow" aria-hidden="true">→</span>
			</span>
		</a>
	</div>
</section>

<script>
	import { gsap } from 'gsap';

	const STICKER_COLORS = [
		{ bg: '#edfdad', fg: '#000000' },
		{ bg: '#96adff', fg: '#3C2C91' },
		{ bg: '#fe6fc1', fg: '#ffffff' },
		{ bg: '#252D38', fg: '#AEEBFF' },
		{ bg: '#FF938D', fg: '#ffffff' },
	];

	const FLIP_AXES = [
		{ rotateX: -90, rotateY: -90 },
		{ rotateX: 90, rotateY: 0 },
		{ rotateX: 0, rotateY: -90 },
		{ rotateX: -90, rotateY: 0 },
		{ rotateX: 90, rotateY: 90 },
		{ rotateX: 0, rotateY: 90 },
	];

	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLElement>('.icon-button').forEach((el) => {
			const scale = el.querySelector<HTMLElement>('.icon-button-scale');
			if (!scale) return;

			let index = 0;
			scale.style.background = STICKER_COLORS[index].bg;
			scale.style.color = STICKER_COLORS[index].fg;

			let flipping = false;
			let tilted = false;

			el.addEventListener('click', () => {
				if (flipping) return;
				flipping = true;
				index = (index + 1) % STICKER_COLORS.length;
				tilted = !tilted;
				const axis = FLIP_AXES[Math.floor(Math.random() * FLIP_AXES.length)];

				gsap
					.timeline({ onComplete: () => (flipping = false) })
					.to(scale, { rotateX: axis.rotateX, rotateY: axis.rotateY, duration: 0.18, ease: 'power1.in' })
					.to(el, { rotate: tilted ? -8.5 : 8.5, duration: 0.36, ease: 'power1.inOut' }, 0)
					.set(scale, {
						onComplete: () => {
							scale.style.background = STICKER_COLORS[index].bg;
							scale.style.color = STICKER_COLORS[index].fg;
						},
					})
					.to(scale, { rotateX: 0, rotateY: 0, duration: 0.18, ease: 'power1.out' });
			});
		});
	});
</script>

<style>
	.icon-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		background: none;
		border: none;
		cursor: pointer;
		perspective: 300px;
		transform: rotate(8.5deg);
	}

	.icon-button-scale {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		border-radius: 999px;
	}

	.timeline-wrap {
		display: grid;
		grid-template-columns: 1fr auto;
		column-gap: 16px;
		row-gap: 20px;
	}

	.timeline {
		display: contents;
	}

	.timeline li {
		grid-column: 1;
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: flex-start;
		gap: 10px;
	}

	.timeline-dot {
		width: 7px;
		height: 7px;
		margin-top: 7px;
		flex-shrink: 0;
	}

	.role {
		margin: 0 0 2px;
		font-weight: 500;
		font-size: 15px;
		color: #000;
	}

	.when {
		margin: 0;
		font-size: 14px;
		color: #595d62;
	}

	.see-work {
		position: relative;
		grid-column: 2;
		grid-row: 2;
		align-self: center;
		justify-self: end;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: #f3f3f3;
		border-radius: 999px;
		padding: 4px 12px;
		font-size: 14px;
		font-weight: 500;
		color: #383838;
		text-decoration: none;
		white-space: nowrap;
		transition: padding 0.35s ease;
	}

	.see-work::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 999px;
		background: #1D2726;
		opacity: 0;
		transform: scale(0.7);
		transition:
			opacity 0.15s ease,
			transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.see-work:hover::before {
		opacity: 1;
		transform: scale(1);
	}
	.see-work:hover {
		padding: 6px 16px;
		color: #EDFDAD;
	}
	.see-work span {
		position: relative;
		z-index: 1;
	}

	.see-work .arrow-track {
		display: grid;
		grid-template-columns: 0fr;
		transition: grid-template-columns 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.see-work:hover .arrow-track {
		grid-template-columns: 1fr;
	}

	.see-work .arrow {
		position: relative;
		z-index: 1;
		overflow: hidden;
		min-width: 0;
		opacity: 0;
		transform: translateX(-4px);
		transition:
			opacity 0.3s ease,
			transform 0.15s ease;
	}

	.see-work:hover .arrow {
		padding-left: 2px;
		opacity: 1;
		transform: translateX(4px);
	}

	@media (max-width: 600px) {
		.timeline-wrap {
			grid-template-columns: 1fr;
		}

		.see-work {
			grid-column: 1;
			grid-row: auto;
			justify-self: start;
			margin-top: 4px;
		}
	}
</style>
