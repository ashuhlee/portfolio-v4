---
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';

interface Project {
	name: string;
	description: string;
	tags: string[];
	color: string;
	blendMode?: string;
	overlayOpacity?: number;
	comingSoon?: boolean;
	url?: string;
	labelColor?: string;
}

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<section class="section" id="projects">
	<SectionHeader title="Projects" darkColor="#FFEDB3">
		<span class="path-label">~/STUFF</span>
	</SectionHeader>

	<div class="projects-grid">
		{projects.map((project) => <ProjectCard {...project} />)}
	</div>
</section>

<style>
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		align-items: start;
		gap: 1.5rem;
	}

	@media (max-width: 37.5rem) {
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
