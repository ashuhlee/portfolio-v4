---
interface Props {
	title: string;
	darkColor?: string;
	accentColor?: string;
}

const { title, accentColor } = Astro.props;
---

<div class="section-header">
	<h2>
		{title}
		<span class="accent" aria-hidden="true" style={accentColor ? `--accent-color: ${accentColor}` : undefined}>++</span>
	</h2>
	<slot />
</div>

<style>
	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
	}

	h2 {
		user-select: none;
		-webkit-user-select: none;
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin: 0;
		font-family: var(--font-display), sans-serif;
		text-transform: uppercase;
		font-weight: 600;
		font-size: var(--font-size-13);
		color: var(--color-text-primary);
	}

	.accent {
		flex-shrink: 0;
		font-family: var(--font-mono), monospace;
		font-weight: 400;
		text-transform: uppercase;
		font-size: var(--font-size-13);
		color: var(--accent-color, var(--color-brand-pink));
	}
</style>
