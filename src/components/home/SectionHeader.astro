---
import { Image } from 'astro:assets';
import dotVector from '../../assets/home/dot-vector.svg';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="section-header">
	<h2><Image src={dotVector} width={11} height={11} alt="" loading="eager" /> {title}</h2>
	<slot />
</div>

<style>
	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
	}
	img {
			margin-top: 0.1875rem;
	}

	h2 {
		user-select: none;
		-webkit-user-select: none;
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin: 0;
		font-size: var(--font-size-16);
		font-weight: 600;
		color: var(--color-text-primary);
	}
</style>
