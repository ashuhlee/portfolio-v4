---
import { Image } from 'astro:assets';

interface Props {
	name: string;
	description: string;
	tags: string[];
	color: string;
	borderColor?: string;
	blendMode?: string;
	overlayOpacity?: number;
	comingSoon?: boolean;
	url?: string;
	image?: ImageMetadata;
	imageAlt?: string;
	preview?: ImageMetadata | string;
}

const {
	name,
	description,
	tags,
	color,
	borderColor,
	blendMode = 'color-burn',
	overlayOpacity = 0.08,
	comingSoon = false,
	url = 'https://github.com/ashuhlee',
	image,
	imageAlt = '',
	preview,
} = Astro.props;

const previewSrc = typeof preview === 'string' ? preview : preview?.src;
const previewIsVideo = previewSrc ? /\.(webm|mp4|mov)(\?|$)/i.test(previewSrc) : false;

const Tag = comingSoon ? 'div' : 'a';
---

<Tag
	class="card"
	class:list={{ 'coming-soon': comingSoon }}
	href={comingSoon ? undefined : url}
	target={comingSoon ? undefined : '_blank'}
	rel={comingSoon ? undefined : 'noopener noreferrer'}
	data-tooltip={comingSoon ? 'Coming soon..' : ' View on GitHub'}
	style={borderColor ? `--card-hover-border: ${borderColor}` : undefined}
>
	<div
		class="thumb"
		style={{
			backgroundColor: color,
			'--thumb-blend': blendMode,
			'--thumb-opacity': overlayOpacity,
			'--thumb-color': color,
		}}
	>
		{image && <Image class="thumb-image" src={image} alt={imageAlt} width={128} height={128} />}
		{
			previewSrc &&
				(previewIsVideo ? (
					<video class="thumb-preview" data-src={previewSrc} muted loop playsinline preload="none" aria-hidden="true" />
				) : (
					<img class="thumb-preview" data-src={previewSrc} alt="" aria-hidden="true" decoding="async" />
				))
		}
	</div>
	<div class="body">
		<h3>{name}</h3>
		<p>{description}</p>
		<ul class="tags">
			{tags.map((tag, i) => <li class:list={{ outline: i === 0 }}>{tag}</li>)}
		</ul>
	</div>
</Tag>

<script>
	document.addEventListener('astro:page-load', () => {
		const PREVIEW_DELAY = 1500;
		const PREVIEW_FADE_OUT = 150;

		document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
			const body = card.querySelector<HTMLElement>('.body');
			const title = body?.querySelector('h3');

			const measureSlide = () => {
				if (!body || !title) return;
				const styles = getComputedStyle(body);
				const padding = parseFloat(styles.paddingTop) + parseFloat(styles.paddingBottom);
				card.style.setProperty('--slide', `${Math.max(0, body.offsetHeight - title.offsetHeight - padding)}px`);
			};

			measureSlide();
			new ResizeObserver(measureSlide).observe(card);
			document.fonts?.ready.then(measureSlide);

			const preview = card.querySelector<HTMLImageElement | HTMLVideoElement>('.thumb-preview');
			let previewTimer: ReturnType<typeof setTimeout> | undefined;
			let clearTimer: ReturnType<typeof setTimeout> | undefined;

			const startPreviewTimer = () => {
				const src = preview?.dataset.src;
				if (!preview || !src) return;

				clearTimeout(clearTimer);

				if (preview instanceof HTMLVideoElement) {
					preview.src = src;
					preview.load();
				} else {
					new Image().src = src;
				}

				previewTimer = setTimeout(() => {
					if (preview instanceof HTMLVideoElement) {
						preview.currentTime = 0;
						preview.play().catch(() => {});
					} else {
						preview.removeAttribute('src');
						preview.src = src;
					}
					card.classList.add('showing-preview');
				}, PREVIEW_DELAY);
			};

			const stopPreview = () => {
				clearTimeout(previewTimer);
				if (!preview) return;

				const wasShowing = card.classList.contains('showing-preview');
				card.classList.remove('showing-preview');

				clearTimer = setTimeout(
					() => {
						if (preview instanceof HTMLVideoElement) preview.pause();
						preview.removeAttribute('src');
						if (preview instanceof HTMLVideoElement) preview.load();
					},
					wasShowing ? PREVIEW_FADE_OUT : 0,
				);
			};

			const resetHover = () => {
				card.classList.remove('hovering');
				stopPreview();
			};

			card.addEventListener('mouseenter', () => {
				card.classList.add('hovering');
				startPreviewTimer();
			});
			card.addEventListener('mouseleave', resetHover);

			card.addEventListener('click', resetHover);
		});
	});
</script>

<style>
	.card {
		-webkit-user-drag: none;
		display: block;
		text-decoration: none;
		color: inherit;
		background: var(--color-white);
		border: 1px solid var(--color-border-harsher);
		border-radius: 0.375rem;
		overflow: hidden;
		rotate: 0deg;
		opacity: 1;
		box-shadow: 0 0 rgba(0, 0, 0, 0);
		transition:
			rotate 0.5s var(--ease-pop),
			scale 0.3s var(--ease-bounce),
			opacity 0.15s ease,
			border-color 0.2s ease,
			border-width 0.2s ease,
			box-shadow 0.3s var(--ease-standard);
	}

	//.card.hovering {
	//	border-width: 1.4px;
	//	border-color: var(--card-hover-border, var(--color-border-harsh));
	//}

	.card:nth-child(4n + 1).hovering,
	.card:nth-child(4n).hovering {
		rotate: -1.5deg;
	}

	.card:nth-child(4n + 2).hovering,
	.card:nth-child(4n + 3).hovering {
		rotate: 1.5deg;
	}

	.card.hovering {
		scale: 1.02;
	}

	.card:active {
		scale: 0.95;
		opacity: 0.8;
	}

	.card.coming-soon {
		cursor: default;
	}

	.thumb {
		--thumb-blend: color-burn;
		--thumb-opacity: 0.08;
		position: relative;
		height: 0;
		width: 100%;
		overflow: hidden;
		transform-origin: center;
		transition:
			scale 0.15s var(--ease-standard),
			height 0.35s var(--ease-standard);
	}

	.thumb::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: url('/images/patterns/dither-gradient.jpg');
		background-size: cover;
		background-position: top;
		mix-blend-mode: var(--thumb-blend);
		opacity: var(--thumb-opacity);
	}

	.thumb-image {
		position: absolute;
		top: 50%;
		left: 50%;
		translate: -50% -50%;
		z-index: 1;
		width: 3rem;
		height: 3rem;
		border-radius: 6px;
		object-fit: cover;
		pointer-events: none;
	}

	.thumb-preview {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
	}

	.card.showing-preview .thumb-preview {
		opacity: 1;
		transition: opacity 0.5s ease;
	}

	.card.hovering .thumb {
		scale: 1.07;
	}

	.card.showing-preview .thumb {
		scale: 1;
		height: calc(4.875rem + var(--slide, 0px));
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding: 0.75rem;
		clip-path: inset(0 0 0 0);
		transition:
			margin-bottom 0.35s var(--ease-standard),
			clip-path 0.35s var(--ease-standard);
	}

	.card.showing-preview .body {
		margin-bottom: calc(var(--slide, 0px) * -1);
		clip-path: inset(0 0 calc(var(--slide, 0px) + 0.375rem) 0);
	}

	h3 {
		margin: 0;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: var(--font-size-15);
		text-transform: capitalize;
		color: var(--color-text-primary);
	}

	p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--font-size-13);
		line-height: 1.35;
		color: var(--color-text-faint);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
	}

	.tags li {
		-webkit-user-select: none;
		user-select: none;
		background: rgba(134, 134, 134, 0.12);
		border-radius: 999px;
		padding: 0.375rem 0.5rem;
		font-family: var(--font-sans);
		font-size: var(--font-size-12);
		color: var(--color-charcoal);
		line-height: 1.35;
		text-box: trim-both cap alphabetic;
	}

	.tags li.outline {
		background: transparent;
		border: 1px solid var(--color-charcoal);
	}

	:root[data-theme='dark'] .tags li.outline {
		color: #91B5C6;
		border-color: #91B5C6;
	}
</style>
