---
interface Props {
	name: string;
	description: string;
	tags: string[];
	color: string;
	blendMode?: string;
	overlayOpacity?: number;
	comingSoon?: boolean;
	url?: string;
}

const {
	name,
	description,
	tags,
	color,
	blendMode = 'color-burn',
	overlayOpacity = 0.08,
	comingSoon = false,
	url = 'https://github.com/ashuhlee',
} = Astro.props;
---

<a
	class="card"
	class:list={{ 'coming-soon': comingSoon }}
	href={comingSoon ? undefined : url}
	target={comingSoon ? undefined : '_blank'}
	rel={comingSoon ? undefined : 'noopener noreferrer'}
	aria-disabled={comingSoon ? 'true' : undefined}
	data-tooltip={comingSoon ? 'Coming soon..' : 'View on GitHub'}
>
	<div
		class="thumb"
		style={{ backgroundColor: color, '--thumb-blend': blendMode, '--thumb-opacity': overlayOpacity }}
	></div>
	<div class="body">
		<h3>{name}</h3>
		<p>{description}</p>
		<ul class="tags">
			{tags.map((tag, i) => <li class:list={{ outline: i === 0 }}>{tag}</li>)}
		</ul>
	</div>
</a>

<style>
	.card {
		-webkit-user-drag: none;
		display: block;
		text-decoration: none;
		color: inherit;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		overflow: hidden;
		rotate: 0deg;
		opacity: 1;
		box-shadow: 0 0 rgba(0, 0, 0, 0);
		transition:
			rotate 0.5s cubic-bezier(0.34, 3.5, 0.64, 0.8),
			scale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.15s ease,
			box-shadow 0.3s cubic-bezier(0, 0, 0.2, 1);
	}

	.card:nth-child(4n + 1):hover,
	.card:nth-child(4n):hover {
		rotate: -1.5deg;
	}

	.card:nth-child(4n + 2):hover,
	.card:nth-child(4n + 3):hover {
		rotate: 1.5deg;
	}

	.card:hover {
		scale: 1.02;
		box-shadow:
			0 0.0625rem 0.125rem -0.0625rem rgba(0, 0, 0, 0.04),
			0 0.125rem 0.25rem rgba(0, 0, 0, 0.04);
	}

	.card:active {
		scale: 0.95;
		opacity: 0.8;
	}

	.card.coming-soon {
		cursor: default;
	}

	.thumb {
		--thumb-blend: color-burn;
		--thumb-opacity: 0.08;
		position: relative;
		height: 6.875rem;
		width: 100%;
		overflow: hidden;
		transform-origin: bottom;
		transition:
			scale 0.5s cubic-bezier(0, 0, 0.2, 1)
	}

	.thumb::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: url('/images/patterns/dither-gradient.jpg');
		background-size: cover;
		background-position: top;
		mix-blend-mode: var(--thumb-blend);
		opacity: var(--thumb-opacity);
	}

	.card:hover .thumb {
		scale: 1.03;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding: 0.75rem;
	}

	h3 {
		margin: 0;
		font-family: var(--font-sans), sans-serif;
		font-weight: 600;
		font-size: 0.9375rem;
		text-transform: capitalize;
		color: var(--color-ink);
	}

	p {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.35;
		color: var(--color-ink-muted);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
	}

	.tags li {
		user-select: none;
		background: rgba(134, 134, 134, 0.12);
		border-radius: 999px;
		padding: 0.375rem 0.5rem;
		font-size: 0.75rem;
		color: #393939;
		line-height: 1.35;
		text-box: trim-both cap alphabetic;
	}

	.tags li.outline {
		background: transparent;
		border: 0.75px solid #393939;
	}
</style>
