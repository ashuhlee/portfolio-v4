---
interface Props {
	name: string;
	description: string;
	tags: string[];
	color: string;
}

const { name, description, tags, color } = Astro.props;
---

<a
	class="card"
	href="https://github.com/ashuhlee"
	target="_blank"
	rel="noopener noreferrer"
	data-tooltip="View on GitHub"
>
	<div class="thumb" style={{ backgroundColor: color }}></div>
	<div class="body">
		<h3>{name}</h3>
		<p>{description}</p>
		<ul class="tags">
			{tags.map((tag, i) => <li class:list={{ outline: i === 0 }}>{tag}</li>)}
		</ul>
	</div>
</a>

<style>
	.card {
		-webkit-user-drag: none;
		display: block;
		text-decoration: none;
		color: inherit;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		overflow: hidden;
		rotate: 0deg;
		opacity: 1;
		box-shadow: 0 0 rgba(0, 0, 0, 0);
		transition:
			rotate 0.5s cubic-bezier(0.34, 3.5, 0.64, 0.8),
			scale 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.15s ease,
			box-shadow 0.3s cubic-bezier(0, 0, 0.2, 1);
	}

	.card:nth-child(4n + 1):hover,
	.card:nth-child(4n):hover {
		rotate: -1.5deg;
	}

	.card:nth-child(4n + 2):hover,
	.card:nth-child(4n + 3):hover {
		rotate: 1.5deg;
	}

	.card:hover {
		scale: 1.02;
		box-shadow:
			0 1px 2px -1px rgba(0, 0, 0, 0.04),
			0 2px 4px rgba(0, 0, 0, 0.04);
	}

	.card:active {
		scale: 0.95;
		opacity: 0.8;
	}

	.thumb {
		height: 110px;
		width: 100%;
		transform-origin: bottom;
		transition:
			scale 0.5s cubic-bezier(0, 0, 0.2, 1)
	}

	.card:hover .thumb {
		scale: 1.03;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 12px;
	}

	h3 {
		margin: 0;
		font-family: var(--font-sans), sans-serif;
		font-weight: 600;
		font-size: 15px;
		text-transform: capitalize;
		color: var(--color-ink);
	}

	p {
		margin: 0;
		font-size: 13px;
		line-height: 1.35;
		color: var(--color-ink-muted);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		list-style: none;
		margin: 4px 0 0;
		padding: 0;
	}

	.tags li {
		user-select: none;
		background: rgba(134, 134, 134, 0.12);
		border-radius: 999px;
		padding: 6px 8px;
		font-size: 12px;
		color: #393939;
		line-height: 1.35;
		text-box: trim-both cap alphabetic;
	}

	.tags li.outline {
		background: transparent;
		border: 0.75px solid #393939;
	}
</style>
