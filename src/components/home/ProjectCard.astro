---
import { Image } from 'astro:assets';

interface Props {
	name: string;
	description: string;
	tags: string[];
	color: string;
	blendMode?: string;
	overlayOpacity?: number;
	comingSoon?: boolean;
	url?: string;
	labelColor?: string;
	image?: ImageMetadata;
	imageAlt?: string;
}

const {
	name,
	description,
	tags,
	color,
	blendMode = 'color-burn',
	overlayOpacity = 0.08,
	comingSoon = false,
	url = 'https://github.com/ashuhlee',
	labelColor = 'white',
	image,
	imageAlt = '',
} = Astro.props;

const Tag = comingSoon ? 'div' : 'a';
---

<Tag
	class="card"
	class:list={{ 'coming-soon': comingSoon }}
	href={comingSoon ? undefined : url}
	target={comingSoon ? undefined : '_blank'}
	rel={comingSoon ? undefined : 'noopener noreferrer'}
	data-tooltip={comingSoon ? 'Coming soon..' : ' View on GitHub'}
>
	<div
		class="thumb"
		style={{
			backgroundColor: color,
			'--thumb-blend': blendMode,
			'--thumb-opacity': overlayOpacity,
			'--thumb-color': color,
			'--thumb-label-color': labelColor,
		}}
	>
		{image && <Image class="thumb-image" src={image} alt={imageAlt} width={128} height={128} />}
		<!--<span class="thumb-label" aria-hidden="true">tbd</span>-->
	</div>
	<div class="body">
		<h3>{name}</h3>
		<p>{description}</p>
		<ul class="tags">
			{tags.map((tag, i) => <li class:list={{ outline: i === 0 }}>{tag}</li>)}
		</ul>
	</div>
</Tag>

<script>
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
			const resetHover = () => card.classList.remove('hovering');

			card.addEventListener('mouseenter', () => card.classList.add('hovering'));
			card.addEventListener('mouseleave', resetHover);

			card.addEventListener('click', resetHover);
		});
	});
</script>

<style>
	.card {
		-webkit-user-drag: none;
		display: block;
		text-decoration: none;
		color: inherit;
		background: var(--color-white);
		border: 1px solid var(--color-border-harsh);
		border-radius: 0.5625rem;
		overflow: hidden;
		rotate: 0deg;
		opacity: 1;
		box-shadow: 0 0 rgba(0, 0, 0, 0);
		transition:
			rotate 0.5s var(--ease-pop),
			scale 0.3s var(--ease-bounce),
			opacity 0.15s ease,
			box-shadow 0.3s var(--ease-standard);
	}

	.card:nth-child(4n + 1).hovering,
	.card:nth-child(4n).hovering {
		rotate: -1.5deg;
	}

	.card:nth-child(4n + 2).hovering,
	.card:nth-child(4n + 3).hovering {
		rotate: 1.5deg;
	}

	.card.hovering {
		scale: 1.02;
		box-shadow:
			0 0.0625rem 0.125rem -0.0625rem rgba(0, 0, 0, 0.04),
			0 0.125rem 0.25rem rgba(0, 0, 0, 0.04);
	}

	.card:active {
		scale: 0.95;
		opacity: 0.8;
	}

	.card.coming-soon {
		cursor: default;
	}

	.thumb {
		--thumb-blend: color-burn;
		--thumb-opacity: 0.08;
		position: relative;
		height: 5.25rem;
		width: 100%;
		overflow: hidden;
		transform-origin: center;
		transition:
			scale 0.15s var(--ease-standard)
	}

	.thumb::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: url('/images/patterns/dither-gradient.jpg');
		background-size: cover;
		background-position: top;
		mix-blend-mode: var(--thumb-blend);
		opacity: var(--thumb-opacity);
	}

	.thumb-image {
		position: absolute;
		top: 50%;
		left: 50%;
		translate: -50% -50%;
		z-index: 1;
		width: 3rem;
		height: 3rem;
		border-radius: 6px;
		object-fit: cover;
		pointer-events: none;
	}

	.thumb-label {
		position: absolute;
		left: 1rem;
		bottom: 0.75rem;
		z-index: 1;
		font-family: var(--font-sofia), sans-serif;
		font-style: italic;
		font-weight: 600;
		font-size: var(--font-size-16);
		letter-spacing: 0.05em;
		color: var(--thumb-label-color, white);
		-webkit-user-select: none;
		user-select: none;
		pointer-events: none;
	}

	.card.hovering .thumb {
		scale: 1.07;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding: 0.75rem;
	}

	h3 {
		margin: 0;
		font-family: var(--font-sans), sans-serif;
		font-weight: 600;
		font-size: var(--font-size-15);
		text-transform: capitalize;
		color: var(--color-text-primary);
	}

	p {
		margin: 0;
		font-size: var(--font-size-13);
		line-height: 1.35;
		color: var(--color-text-faint);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
	}

	.tags li {
		-webkit-user-select: none;
		user-select: none;
		background: rgba(134, 134, 134, 0.12);
		border-radius: 999px;
		padding: 0.375rem 0.5rem;
		font-size: var(--font-size-12);
		color: var(--color-charcoal);
		line-height: 1.35;
		text-box: trim-both cap alphabetic;
	}

	.tags li.outline {
		background: transparent;
		border: 1px solid var(--color-charcoal);
	}

	:root[data-theme='dark'] .tags li.outline {
		color: #91B5C6;
		border-color: #91B5C6;
	}
</style>
