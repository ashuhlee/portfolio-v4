---

<footer class="footer" id="extras">
	<h1 class="wordmark">ASHUHLEE</h1>
	<a class="email" href="mailto:hello@ashuhlee.ca">hello@ashuhlee.ca</a>
	<div class="socials">
	</div>
</footer>

<style>
	.footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 8px;
		position: relative;
	}

	.footer-path {
		position: absolute;
		top: -32px;
		right: 0;
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: 72px;
		margin: 0;
		color: var(--color-ink);
		letter-spacing: 0.01em;
	}

	.email {
		font-size: 14px;
		color: var(--color-ink-soft);
		text-decoration: underline;
		text-decoration-skip-ink: none;
	}

	.socials {
		display: flex;
		gap: 12px;
		margin-top: 16px;
	}

	.socials a {
		display: flex;
	}

	@media (max-width: 600px) {
		.wordmark {
			font-size: 58px;
		}

		.footer-path {
			position: static;
		}
	}
</style>
