---
---

<div class="contact-section stagger-in">
	<div class="contact-left">
		<div class="contact-heading">
			<h2 class="contact-title">say hello</h2>

		</div>
		<a class="contact-email" href="mailto:hello@ashuhlee.ca">
			<span class="contact-email-text">
				<span class="contact-email-primary">hello@ashuhlee.ca</span>
				<span class="contact-email-hover">hello@ashuhlee.ca</span>
			</span>
			<span class="contact-email-arrow">↗</span>
		</a>
	</div>
	<p class="contact-desc">I'm open to new internship opportunities and projects. Reach out at any time!</p>
</div>

<style>
	.contact-section {
		display: flex;
		align-items: flex-end;
		gap: 3rem;
		margin-bottom: 5rem;
		margin-top: 3rem;
	}

	.contact-left {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
		flex-shrink: 0;
	}

	.contact-heading {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.contact-title {
		font-family: var(--font-display);
		font-size: 2.75rem;
		font-weight: 400;
		color: var(--color-text-primary);
		margin: 0;
		line-height: 1;
		text-transform: lowercase;
	}

	.contact-icon {
		display: block;
		flex-shrink: 0;
		margin-bottom: 0.1rem;
	}

	.contact-email {
		display: inline-flex;
		align-items: baseline;
		gap: 0.6rem;
		font-family: var(--font-gt), sans-serif;
		font-size: var(--font-size-17);
		color: var(--color-text-primary-alt);
		text-decoration: none;
		line-height: 1;
	}

	.contact-email-text {
		position: relative;
		display: inline-block;
	}

	.contact-email-text::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.7px;
		height: 1px;
		background: var(--color-text-primary-alt);
		opacity: 0.4;
		transition: none;
	}

	.contact-email:hover .contact-email-text::after {
		background: var(--color-brand-pink);
		opacity: 1;
		transition: background 0.2s ease 0.03s, opacity 0.2s ease 0.03s;
	}

	.contact-email-arrow {
		font-family: var(--font-sans), sans-serif;
		font-style: normal;
		color: var(--color-brand-pink);
		font-size: var(--font-size-15);
		display: inline-block;
	}

	.contact-email-primary,
	.contact-email-hover {
		display: block;
		transition: none;
	}

	.contact-email-hover {
		position: absolute;
		top: 0;
		left: 0;
		color: var(--color-brand-pink);
		opacity: 0;
		transition: none;
		white-space: nowrap;
	}

	.contact-email:hover .contact-email-primary {
		opacity: 0;
		transition: none;
	}

	.contact-email:hover .contact-email-hover {
		opacity: 1;
		transition: opacity 0.2s ease 0.03s;
	}

	.contact-desc {
		font-family: var(--font-gt), sans-serif;
		font-size: var(--font-size-15);
		color: var(--color-text-primary-alt);
		margin: 0;
		margin-left: auto;
		max-width: 20rem;
		line-height: 1.45;
	}

	@media (max-width: 44rem) {
		.contact-section {
			flex-direction: column;
			gap: 1rem;
		}

		.contact-desc {
			margin-top: 0;
			max-width: 100%;
		}
	}
</style>
