---
---

<div class="hero stagger-in">
	<div class="hero-left">
		<div class="hero-photo-box">
			<img src="/images/hero.png" alt="Ashley" class="hero-photo" draggable="false" />
		</div>
		<div class="hero-links-row">
			<a class="hero-link" href="https://www.linkedin.com/in/ashuhlee" target="_blank" rel="noopener noreferrer">
				<span class="hero-link-arrow-wrap">
					<span class="hero-link-arrow hero-link-arrow-primary">\</span>
					<span class="hero-link-arrow hero-link-arrow-hover">\</span>
				</span>
				<span class="hero-link-label-wrap">
					<span class="hero-link-label-primary">linkedin</span>
					<span class="hero-link-label-hover">linkedin</span>
				</span>
			</a>
			<a class="hero-link" href="mailto:hello@ashuhlee.ca">
				<span class="hero-link-arrow-wrap">
					<span class="hero-link-arrow hero-link-arrow-primary">\</span>
					<span class="hero-link-arrow hero-link-arrow-hover">\</span>
				</span>
				<span class="hero-link-label-wrap">
					<span class="hero-link-label-primary">email</span>
					<span class="hero-link-label-hover">email</span>
				</span>
			</a>
		</div>
	</div>
	<div class="hero-right">
		<div class="hero-top-row">
			<span class="hero-tag">MAIN.SH</span>
		</div>
		<p class="hero-name">Hi, I'm Ashley</p>
		<div class="hero-bio-wrap">
			<p class="hero-bio">I'm a computer science student at Western University who cares about making software feel intuitive, fun and user focused.</p>
			<p class="hero-bio">I work in mobile, fullstack and frontend engineering, but always open to exploring new things.</p>
			<p class="hero-bio">Reach me at <a class="hero-bio-link" href="mailto:hello@ashuhlee.ca"><span class="bio-link-primary">hello@ashuhlee.ca</span><span class="bio-link-hover">hello@ashuhlee.ca</span></a> to chat.</p>
		</div>
	</div>
</div>

<style>
	.hero {
		display: flex;
		align-items: flex-start;
		gap: 2rem;
		margin-bottom: 2.5rem;
	}

	.hero-left {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.hero-photo-box {
		width: 172px;
		height: 192px;
		border: 1px solid var(--color-brand-pink);
		overflow: hidden;
		flex-shrink: 0;
	}

	.hero-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		display: block;
		pointer-events: none;
		user-select: none;
	}

	.hero-links-row {
		display: flex;
		gap: 1.25rem;
	}

	.hero-link {
		display: inline-flex;
		font-family: var(--font-mono), monospace;
		font-size: 12px;
		text-transform: uppercase;
		color: #272727;
		text-decoration: none;
		letter-spacing: 0.01em;
		line-height: 24px;
		white-space: nowrap;
	}

	:root[data-theme='dark'] .hero-link {
		color: var(--color-text-muted);
	}

	.hero-link-arrow-wrap {
		position: relative;
		display: inline-block;
	}

	.hero-link-arrow-primary {
		display: block;
		transition: none;
	}

	.hero-link-arrow-hover {
		position: absolute;
		top: 0;
		left: 0;
		color: var(--color-brand-pink);
		opacity: 0;
		transition: none;
	}

	.hero-link-label-wrap {
		position: relative;
		display: inline-block;
	}

	.hero-link-label-primary {
		display: block;
	}

	.hero-link-label-hover {
		position: absolute;
		top: 0;
		left: 0;
		color: var(--color-brand-pink);
		opacity: 0;
		transition: none;
	}

	.hero-link:hover .hero-link-label-primary {
		opacity: 0;
		transition: none;
	}

	.hero-link:hover .hero-link-label-hover {
		opacity: 1;
		transition: opacity 0.2s ease 0.03s;
	}

	.hero-link:hover .hero-link-arrow-primary {
		opacity: 0;
		transition: none;
	}

	.hero-link:hover .hero-link-arrow-hover {
		opacity: 1;
		transition: opacity 0.2s ease 0.05s;
	}

	/* ── Right column ── */
	.hero-right {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.hero-top-row {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 2px;
	}

	.hero-tag {
		font-family: var(--font-mono), monospace;
		font-size: 12px;
		text-transform: uppercase;
		color: var(--color-brand-pink);
		letter-spacing: 0.01em;
	}

	.hero-name {
		font-family: var(--font-gt), sans-serif;
		font-size: 17px;
		font-weight: 500;
		color: var(--color-text-primary-alt);
		margin: 0;
		line-height: 1.2;
	}

	.hero-bio-wrap {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.hero-bio {
		font-family: var(--font-gt), sans-serif;
		font-size: 15px;
		line-height: 1.4;
		color: #595d62;
		margin: 0;
	}

	:root[data-theme='dark'] .hero-bio {
		color: var(--color-text-muted);
	}

	.hero-bio-link {
		position: relative;
		display: inline-block;
		color: var(--color-text-primary-alt);
		text-decoration: none;
	}

	.hero-bio-link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 1.3px;
		height: 1px;
		background: var(--color-text-primary-alt);
		opacity: 0.4;
		transition: none;
	}

	.hero-bio-link:hover::after {
		background: var(--color-brand-pink);
		opacity: 1;
		transition: background 0.2s ease 0.03s, opacity 0.2s ease 0.03s;
	}

	.bio-link-primary {
		display: block;
		transition: none;
	}

	.bio-link-hover {
		position: absolute;
		top: 0;
		left: 0;
		color: var(--color-brand-pink);
		opacity: 0;
		transition: none;
		white-space: nowrap;
	}

	.hero-bio-link:hover .bio-link-primary {
		opacity: 0;
		transition: none;
	}

	.hero-bio-link:hover .bio-link-hover {
		opacity: 1;
		transition: opacity 0.2s ease 0.03s;
	}
</style>
