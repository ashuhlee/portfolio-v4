<div class="identity stagger-in">
	<div class="avatar-wrap">
		<img
			src="/images/butterfly.gif"
			class="avatar-butterfly"
			width="48"
			height="48"
			alt=""
			aria-hidden="true"
			draggable="false"
		/>
	</div>
	<div class="who">
		<p class="name">Ashuhlee</p>
		<p class="role">Software Engineer</p>
	</div>
	<button class="theme-toggle" type="button" aria-label="Switch to dark mode">
