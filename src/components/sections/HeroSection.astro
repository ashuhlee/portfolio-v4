---
import { Image } from 'astro:assets';
import heroImg from '@/assets/images/png/hero.png';
---

<div class="hero-wrapper">
	<div class="hero stagger-in">
		<div class="hero-left">
			<div class="hero-photo-box">
				<Image src={heroImg} alt="Ashley" class="hero-photo" draggable="false" loading="eager" />
			</div>
			<div class="hero-links-row">
				<a class="hero-link" href="https://www.linkedin.com/in/ashuhlee" target="_blank" rel="noopener noreferrer">
					<span class="hero-link-arrow-wrap">
						<span class="hero-link-arrow hero-link-arrow-primary">\</span>
						<span class="hero-link-arrow hero-link-arrow-hover">\</span>
					</span>
					<span class="hero-link-label-wrap">
						<span class="hero-link-label-primary">linkedin</span>
						<span class="hero-link-label-hover">linkedin</span>
					</span>
				</a>
				<a class="hero-link" href="mailto:hello@ashuhlee.ca">
					<span class="hero-link-arrow-wrap">
						<span class="hero-link-arrow hero-link-arrow-primary">\</span>
						<span class="hero-link-arrow hero-link-arrow-hover">\</span>
					</span>
					<span class="hero-link-label-wrap">
						<span class="hero-link-label-primary">email</span>
						<span class="hero-link-label-hover">email</span>
					</span>
				</a>
			</div>
		</div>
		<div class="hero-right">
			<p class="hero-name">ashuhlee</p>
			<div class="hero-bio-wrap">
				<p class="hero-bio">I'm a computer science student at Western University who cares about making software feel intuitive, fun and user focused.</p>
				<p class="hero-bio">I work in mobile, fullstack and frontend engineering, but always open to exploring new things.</p>
				<p class="hero-bio">Reach me at <a class="hero-bio-link" href="mailto:hello@ashuhlee.ca"><span class="bio-link-primary">hello@ashuhlee.ca</span><span class="bio-link-hover">hello@ashuhlee.ca</span></a> to chat.</p>
			</div>
		</div>
	</div>
	<div class="hero-top-row">
		<button class="hero-tag" id="color-switcher" type="button" aria-label="Switch brand color">
			<span class="hero-tag-primary">THEME.CFG</span>
			<span class="hero-tag-hover">THEME.CFG</span>
		</button>
	</div>
</div>

<style>
	.hero-wrapper {
		position: relative;
		margin-bottom: 2.5rem;
	}

	.hero {
		display: flex;
		align-items: flex-start;
		gap: 2rem;
	}

	.hero-left {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.hero-photo-box {
		width: 176px;
		height: 190px;
		border: 1px solid var(--color-brand-pink);
		overflow: hidden;
		flex-shrink: 0;
	}

	.hero-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		display: block;
		pointer-events: none;
		user-select: none;
	}

	.hero-links-row {
		display: flex;
		gap: 1.25rem;
	}

	.hero-link {
		display: inline-flex;
		font-family: var(--font-mono), monospace;
		font-size: var(--font-size-11);
		text-transform: uppercase;
		color: #272727;
		text-decoration: none;
		letter-spacing: 0.01em;
		line-height: 24px;
		white-space: nowrap;
	}

	:root[data-theme='dark'] .hero-link {
		color: var(--color-text-muted);
	}

	.hero-link-arrow-wrap {
		position: relative;
		display: inline-block;
	}

	.hero-link-arrow-primary {
		display: block;
		transition: none;
	}

	.hero-link-arrow-hover {
		position: absolute;
		top: 0;
		left: 0;
		color: var(--color-brand-pink);
		opacity: 0;
		transition: none;
	}

	.hero-link-label-wrap {
		position: relative;
		display: inline-block;
	}

	.hero-link-label-primary {
		display: block;
	}

	.hero-link-label-hover {
		position: absolute;
		top: 0;
		left: 0;
		color: var(--color-brand-pink);
		opacity: 0;
		transition: none;
	}

	.hero-link:hover .hero-link-label-primary {
		opacity: 0;
		transition: none;
	}

	.hero-link:hover .hero-link-label-hover {
		opacity: 1;
		transition: opacity 0.2s ease 0.03s;
	}

	.hero-link:hover .hero-link-arrow-primary {
		opacity: 0;
		transition: none;
	}

	.hero-link:hover .hero-link-arrow-hover {
		opacity: 1;
		transition: opacity 0.2s ease 0.05s;
	}

	/* ── Right column ── */
	.hero-right {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-top: -1rem;
	}

	.hero-top-row {
		position: absolute;
		top: -1rem;
		right: 0;
	}

	.hero-tag {
		font-family: var(--font-mono), monospace;
		font-size: var(--font-size-12);
		text-transform: uppercase;
		color: var(--color-brand-pink);
		letter-spacing: 0.01em;
		position: relative;
		display: inline-block;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}

	.hero-tag-primary {
		display: block;
		transition: none;
	}

	.hero-tag-hover {
		position: absolute;
		top: 0;
		left: 0;
		color: var(--color-brand-pink);
		opacity: 0;
		transition: none;
		white-space: nowrap;
	}

	.hero-tag:hover .hero-tag-primary {
		opacity: 0;
		transition: none;
	}

	.hero-tag:hover .hero-tag-hover {
		opacity: 1;
		transition: opacity 0.2s ease 0.03s;
	}

	.hero-name {
		font-family: var(--font-display);
		font-size: var(--font-size-48);
		font-weight: 400;
		color: var(--color-text-primary-alt);
		margin: 0;
		-webkit-user-select: none;
		user-select: none;
	}

	.hero-bio-wrap {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.hero-bio {
		font-family: var(--font-gt), sans-serif;
		font-size: var(--font-size-15);
		line-height: 1.4;
		color: #505356;
		margin: 0;
	}

	:root[data-theme='dark'] .hero-bio {
		color: var(--color-text-muted);
	}

	.hero-bio-link {
		position: relative;
		display: inline-block;
		color: var(--color-text-primary-alt);
		text-decoration: none;
	}

	.hero-bio-link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 1.3px;
		height: 1px;
		background: var(--color-text-primary-alt);
		opacity: 0.4;
		transition: none;
	}

	.hero-bio-link:hover::after {
		background: var(--color-brand-pink);
		opacity: 1;
		transition: background 0.2s ease 0.03s, opacity 0.2s ease 0.03s;
	}

	.bio-link-primary {
		display: block;
		transition: none;
	}

	.bio-link-hover {
		position: absolute;
		top: 0;
		left: 0;
		color: var(--color-brand-pink);
		opacity: 0;
		transition: none;
		white-space: nowrap;
	}

	.hero-bio-link:hover .bio-link-primary {
		opacity: 0;
		transition: none;
	}

	.hero-bio-link:hover .bio-link-hover {
		opacity: 1;
		transition: opacity 0.2s ease 0.03s;
	}

	@media (max-width: 36rem) {
		.hero-left {
			display: none;
		}
	}
</style>

<script>
	const COLORS = [
		{ brand: null,      brandDark: null,      trail: null,      gradientStart: null,      gradientEnd: null      },
		{ brand: '#7A76F2', brandDark: '#A8A6FF', trail: '#C9C7FB', gradientStart: '#E8E7FD', gradientEnd: '#A09DFA' },
		{ brand: '#5591FF', brandDark: '#80AAFF', trail: '#B8CEFF', gradientStart: '#D6E5FF', gradientEnd: '#89AEFF' },
	] as const;
	const STORAGE_KEY = 'brand-color-idx';

	function applyColorByIndex(idx: number) {
		const color = COLORS[idx] ?? COLORS[0];
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		const brand = isDark ? (color.brandDark ?? color.brand) : color.brand;
		if (brand) {
			document.documentElement.style.setProperty('--color-brand-pink', brand);
			document.documentElement.style.setProperty('--color-brand-pink-trail', color.trail);
			document.documentElement.style.setProperty('--color-pink-gradient-start', color.gradientStart);
			document.documentElement.style.setProperty('--color-pink-gradient-end', color.gradientEnd);
		} else {
			document.documentElement.style.removeProperty('--color-brand-pink');
			document.documentElement.style.removeProperty('--color-brand-pink-trail');
			document.documentElement.style.removeProperty('--color-pink-gradient-start');
			document.documentElement.style.removeProperty('--color-pink-gradient-end');
		}
	}

	document.addEventListener('astro:page-load', () => {
		const btn = document.getElementById('color-switcher');
		if (!btn) return;

		btn.addEventListener('click', () => {
			const current = parseInt(localStorage.getItem(STORAGE_KEY) ?? '0', 10);
			const next = (current + 1) % COLORS.length;
			localStorage.setItem(STORAGE_KEY, String(next));
			applyColorByIndex(next);
		});
	});
</script>
