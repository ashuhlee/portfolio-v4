---
import SectionHeader from './SectionHeader.astro';

const experiences = [
	{
		role: 'Frontend Engineer Intern',
		company: 'Sun Life',
		when: 'fall 2026',
	},
	{
		role: 'Software Engineer Intern',
		company: 'Pesa',
		when: 'summer 2026',
		href: '/work/pesa',
		tooltip: 'view demo',
	},
	{
		role: 'Web Development Intern',
		company: 'Scan',
		when: 'summer 2024 + 2025',
	},
	{
		role: 'Designer',
		company: 'Western University',
		when: '2023',
	},
];
---

<section class="section stagger-in">
	<SectionHeader title="experience">
		<!--<img src="/images/section-icon.svg" class="section-icon" alt="" aria-hidden="true" width="28" height="28" />-->
	</SectionHeader>
	<div class="section-grid">
		{experiences.map((exp) => {
			const Tag = exp.href ? 'a' : 'div';
			return (
				<Tag
					class={`grid-cell exp-cell${exp.href ? ' exp-cell-link' : ''}`}
					href={exp.href}
					target={exp.href?.startsWith('http') ? '_blank' : undefined}
					rel={exp.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
				data-tooltip={exp.tooltip}
				>
					{exp.href && (
						<div class="cell-disco-wrap">
							<img src="/images/disco.gif" class="cell-disco" alt="" aria-hidden="true" draggable="false" />
						</div>
					)}
					<div data-bounce={exp.href ? '0.95' : undefined} class="cell-content">
						<p class="exp-role">
							{exp.role}
							{exp.href && <span class="exp-arrow">↗</span>}
						</p>
						<p class="exp-meta">{exp.company}, {exp.when}</p>
					</div>
				</Tag>
			);
		})}
		<span class="grid-center-plus" aria-hidden="true">+</span>
		<span class="grid-triangle grid-triangle-left" aria-hidden="true"></span>
		<span class="grid-triangle grid-triangle-right" aria-hidden="true"></span>
	</div>
</section>

<style>
	.section {
		margin-top: 3.5rem;
	}

	/* ── Grid ── */
	.section-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border: 1px solid #e6e6e6;
		position: relative;
	}

	:root[data-theme='dark'] .section-grid {
		border-color: #2e2b35;
	}

	.grid-cell {
		padding: 1rem;
		text-decoration: none;
		color: inherit;
		position: relative;
		overflow: hidden;
	}

	.grid-cell:nth-child(odd) {
		border-right: 1px solid #e6e6e6;
	}

	.grid-cell:nth-child(-n+2) {
		border-bottom: 1px solid #e6e6e6;
	}

	:root[data-theme='dark'] .grid-cell:nth-child(odd),
	:root[data-theme='dark'] .grid-cell:nth-child(-n+2) {
		border-color: #2e2b35;
	}

	.grid-center-plus {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		font-family: 'Azeret Mono', monospace;
		font-weight: 300;
		font-size: 15px;
		line-height: 1;
		color: #bcbcbc;
		background: var(--color-bg, #fff);
		padding: 0 2px;
		z-index: 1;
		pointer-events: none;
		user-select: none;
	}

	:root[data-theme='dark'] .grid-center-plus {
		color: #4a4a4a;
		background: var(--color-bg, #1A1820);
	}

	.grid-triangle {
		position: absolute;
		top: 50%;
		width: 4px;
		height: 9px;
		background: #e6e6e6;
		z-index: 1;
		pointer-events: none;
	}

	:root[data-theme='dark'] .grid-triangle {
		background: #2e2b35;
	}

	.grid-triangle-left {
		left: 0;
		transform: translateY(-50%);
		clip-path: polygon(0 0, 100% 50%, 0 100%);
	}

	.grid-triangle-right {
		right: 0;
		transform: translateY(-50%);
		clip-path: polygon(100% 0, 0 50%, 100% 100%);
	}

	/* ── Experience cells ── */
	.exp-cell-link {
		transition: background 0.15s ease;
		cursor: pointer;
	}

	.exp-cell-link:hover {
		background: var(--color-bg-page);
	}

	:root[data-theme='dark'] .exp-cell-link:hover {
		background: rgba(255, 255, 255, 0.015);
	}

	:root[data-theme='dark'] .cell-disco-wrap {
		display: none;
	}

	.cell-disco-wrap {
		position: absolute;
		bottom: -105px;
		right: 20px;
		width: 160px;
		height: 160px;
		overflow: hidden;
		pointer-events: none;
		user-select: none;
		opacity: 0;
		filter: blur(1.5px);
		transition: opacity 0.35s ease;
	}

	.exp-cell-link:hover .cell-disco-wrap {
		opacity: 0.045;
	}

	.cell-disco {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cell-content {
		position: relative;
	}

	.exp-role {
		font-family: 'GT Walsheim Pro', sans-serif;
		font-size: 15.5px;
		font-weight: 500;
		text-transform: lowercase;
		color: #212121;
		margin: 0 0 0.25rem;
		line-height: 1.2;
	}

	:root[data-theme='dark'] .exp-role {
		color: var(--color-text-primary);
	}

	@keyframes exp-arrow-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	.exp-arrow {
		font-family: var(--font-sans), sans-serif;
		font-style: normal;
		color: var(--color-brand-pink);
		margin-left: 0.6rem;
		font-size: 15px;
		display: inline-block;
	}

	.exp-cell-link:hover .exp-arrow {
		animation: exp-arrow-in 0.2s ease 0.03s both;
	}

	.exp-meta {
		font-family: var(--font-sans), sans-serif;
		font-size: 14.5px;
		color: #595d62;
		margin: 0;
		line-height: 1.2;
	}

	:root[data-theme='dark'] .exp-meta {
		color: var(--color-text-muted);
	}
</style>
