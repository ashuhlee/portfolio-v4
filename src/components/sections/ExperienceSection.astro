---
import SectionHeader from './SectionHeader.astro';

const experiences = [
	{
		role: 'Manulife',
		company: 'W2027 - incoming',
		stack: 'Salesforce team',
		when: 'W2027',
		desc: 'Software Engineer Intern',
		description: 'Joining the Salesforce platform team to build enterprise software solutions',
	},
	{
		role: 'Sunlife',
		company: 'F2026 - present',
		stack: 'Enterprise Frontend team',
		when: 'F26',
		desc: 'Frontend Engineer Intern',
		description: 'Building components for the new design system, and internal tooling',
	},
	{
		role: 'Pesa',
		company: 'S2026',
		stack: 'Mobile, product',
		when: 'S2026',
		href: '/work/pesa',
		tooltip: 'view demo',
		desc: 'Software Engineer Intern',
		description: 'Shipped multiple features across wallets, transactions and savings accounts',
	},
	{
		role: 'Scan',
		company: 'S2024 + 25',
		stack: 'web, ux design',
		when: 'S24 - 25',
		desc: 'Web Development Intern',
		description: 'Migrated sites to a modern framework, and integrated payment processing',
	},
];
---

<section class="section stagger-in">
	<SectionHeader title="experience">
		<!--<img src="/images/section-icon.svg" class="section-icon" alt="" aria-hidden="true" width="28" height="28" />-->
	</SectionHeader>
	<div class="section-grid">
		{experiences.map((exp) => {
			const Tag = exp.href ? 'a' : 'div';
			return (
				<Tag
					class={`grid-cell exp-cell${exp.href ? ' exp-cell-link' : ''}`}
					href={exp.href}
					target={exp.href?.startsWith('http') ? '_blank' : undefined}
					rel={exp.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
				data-tooltip={exp.tooltip}
				>
					{exp.href && (
						<div class="cell-disco-wrap">
							<img src="/images/disco.gif" class="cell-disco" alt="" aria-hidden="true" draggable="false" />
						</div>
					)}
					<div data-bounce={exp.href ? '0.95' : undefined} class="cell-content">
						<div class="exp-label-wrap">
							<p class="exp-label label-company">{exp.company}</p>
							<p class="exp-label label-stack">{exp.stack}</p>
						</div>
						<p class="exp-role">{exp.role}<span class="exp-period">.</span></p>
						<p class="exp-meta">
							{exp.desc}
							{exp.href && <span class="exp-arrow">↗</span>}
						</p>
						<p class="exp-desc">{exp.description}</p>
					</div>
				</Tag>
			);
		})}
	</div>
</section>

<style>
	.section {
		margin-top: 3rem;
	}

	/* ── Grid ── */
	.section-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}

	.grid-cell {
		padding: 0 0 1.5rem;
		text-decoration: none;
		color: inherit;
		position: relative;
		overflow: hidden;
	}

	.grid-cell:nth-child(odd) {
		padding-right: 1rem;
	}

	.grid-cell:nth-child(even) {
		padding-left: 1rem;
	}

	.grid-cell:nth-child(-n+2) {
		border-bottom: 1px solid #e6e6e6;
		padding-bottom: 1.5rem;
	}

	.grid-cell:nth-child(n+3) {
		padding-top: 1.5rem;
	}

	:root[data-theme='dark'] .grid-cell:nth-child(-n+2) {
		border-color: #2e2b35;
	}

	/* ── Experience cells ── */
	.exp-cell-link {
		cursor: pointer;
	}

	.cell-disco-wrap {
		display: none;
	}

	.cell-content {
		position: relative;
	}

	.exp-arrow {
		font-family: var(--font-sans), sans-serif;
		font-style: normal;
		color: var(--color-brand-pink);
		margin-left: 0.6rem;
		font-size: 15px;
		display: inline-block;
		transition: opacity 0.1s ease;
	}

	.exp-cell-link:hover .exp-arrow {
		opacity: 0;
	}

	.exp-label-wrap {
		position: relative;
		height: 24px;
		margin: 0 0 0.125rem;
	}

	.exp-label {
		font-family: var(--font-mono), monospace;
		font-size: 12px;
		text-transform: uppercase;
		color: var(--color-brand-pink);
		line-height: 24px;
		margin: 0;
		display: block;
	}

	.label-stack {
		position: absolute;
		top: 0;
		left: 0;
		opacity: 0;
		transition: none;
	}

	.exp-cell:hover .label-company {
		opacity: 0;
		transition: none;
	}

	.exp-cell:hover .label-stack {
		opacity: 1;
		transition: opacity 0.2s ease 0.03s;
	}

	.exp-role {
		font-family: var(--font-gt), sans-serif;
		font-size: 15.5px;
		font-weight: 500;
		color: var(--color-text-primary-alt);
		margin: 0 0 0.125rem;
		line-height: 1.2;
	}

	.exp-period {
		color: var(--color-gray-mid-light);
	}

	.exp-meta {
		font-family: var(--font-gt), sans-serif;
		font-size: 15.5px;
		font-weight: 500;
		text-transform: lowercase;
		color: var(--color-text-secondary);
		margin: 0 0 0.375rem;
		line-height: 1.2;
	}

	:root[data-theme='dark'] .exp-meta {
		color: var(--color-text-medium);
	}

	.exp-desc {
		font-family: var(--font-gt), sans-serif;
		font-size: 15px;
		color: #505356;
		margin: 0;
		line-height: 1.4;
	}

	:root[data-theme='dark'] .exp-desc {
		color: var(--color-text-muted);
	}
</style>
