---
import { Image } from 'astro:assets';
import butterflyImg from '@/assets/images/png/butterfly.png';
---

<footer class="page-footer">
	<div class="butterfly butterfly-large" aria-hidden="true">
		<div class="butterfly-transform butterfly-transform-large">
			<div class="butterfly-wrap butterfly-wrap-large">
				<Image src={butterflyImg} alt="" class="butterfly-img" />
			</div>
		</div>
	</div>
	<div class="butterfly butterfly-small" aria-hidden="true">
		<div class="butterfly-transform butterfly-transform-small">
			<div class="butterfly-wrap butterfly-wrap-small">
				<Image src={butterflyImg} alt="" class="butterfly-img" />
			</div>
		</div>
	</div>
	<div class="page-footer-inner">
		<div class="brand">
			<p class="wordmark">ASHUHLEE</p>
			<p class="copyright"><span class="copyright-icon">©</span> 2026 Ashley Oyewole. All rights reserved.</p>
		</div>
		<nav class="footer-links">
			<a class="link-linkedin" href="https://www.linkedin.com/in/ashuhlee" target="_blank" rel="noopener noreferrer">
				<span class="foot-label-wrap"><span class="foot-primary">LinkedIn</span><span class="foot-hover">&gt;LinkedIn</span></span>
			</a>
			<a class="link-github" href="https://github.com/ashuhlee" target="_blank" rel="noopener noreferrer">
				<span class="foot-label-wrap"><span class="foot-primary">GitHub</span><span class="foot-hover">GitHub</span></span>
			</a>
			<a class="link-email" href="mailto:hello@ashuhlee.ca">
				<span class="foot-label-wrap"><span class="foot-primary">Email</span><span class="foot-hover">@Email</span></span>
			</a>
		</nav>
	</div>
</footer>

<script>
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLElement>('.footer-links a').forEach((link) => {
			const resetHover = () => link.classList.remove('hovering');

			link.addEventListener('mouseenter', () => link.classList.add('hovering'));
			link.addEventListener('mouseleave', resetHover);

			link.addEventListener('click', resetHover);
		});
	});
</script>

<style>
	.page-footer {
		width: 100vw;
		position: relative;
		left: 50%;
		margin-left: -50vw;
		background: var(--color-bg-page);
		border-top: 1px solid var(--color-border);
		overflow: hidden;
	}

	.page-footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: calc(var(--page-max-width, 50rem) * 1.4);
		margin: 0 auto;
		padding: 2.5rem 1.5rem 3rem;
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.wordmark {
		margin: 0;
		font-family: var(--font-display), sans-serif;
		font-size: var(--font-size-18);
		color: var(--color-text-primary-alt);
		-webkit-user-select: none;
		user-select: none;
	}

	.copyright {
		margin: 0;
		font-size: var(--font-size-14);
		color: var(--color-text-muted);
	}

	.copyright-icon {
		color: var(--color-brand-pink);
		font-size: var(--font-size-15);
	}

	.footer-links {
		display: flex;
		align-self: flex-end;
		gap: 0.125rem;
	}

	.footer-links a {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 0.375rem 0.75rem;
		font-family: var(--font-mono), monospace;
		text-transform: uppercase;
		font-size: var(--font-size-12);
		color: var(--color-text-secondary);
		text-decoration: none;
	}


	.foot-label-wrap {
		position: relative;
		display: inline-block;
	}

	.foot-primary {
		display: block;
		color: var(--color-text-secondary);
		transition: none;
	}

	.foot-hover {
		position: absolute;
		top: 0;
		left: 0;
		color: var(--color-brand-pink);
		opacity: 0;
		transition: none;
		white-space: nowrap;
	}

	.link-linkedin .foot-hover,
	.link-email .foot-hover {
		left: -1ch;
	}

	.footer-links a.hovering .foot-primary {
		opacity: 0;
		transition: none;
	}

	.footer-links a.hovering .foot-hover {
		opacity: 1;
		transition: opacity 0.3s ease 0.03s;
	}

	.footer-links a.hovering {
		color: var(--color-brand-pink);
	}

	.foot-label-wrap::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.1px;
		height: 1px;
		background: currentColor;
		opacity: 0.4;
		transition: opacity 0.2s ease, transform 0.4s ease;
	}

	.footer-links a.hovering .foot-label-wrap::after {
		opacity: 0;
		height: 0;
	}

	.foot-label-wrap {
		z-index: 1;
	}

	.butterfly {
		position: absolute;
		pointer-events: none;
		mix-blend-mode: difference;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.butterfly-large {
		width: 320px;
		height: auto;
		right: 30px;
		top: -80px;
	}

	.butterfly-small {
		width: 150px;
		height: auto;
		right: 370px;
		top: -30px;
	}

	.butterfly-transform {
		flex: none;
	}

	.butterfly-transform-large {
		transform: rotate(-175deg) scaleY(-1) scaleX(-1);
	}

	.butterfly-transform-small {
		transform: rotate(-7deg) scaleX(-1);
	}

	.butterfly-wrap {
		position: relative;
	}

	.butterfly-wrap-large {
		width: 348px;
		height: auto;
		filter: blur(2px);
		opacity: 0.1;
	}

	.butterfly-wrap-small {
		width: 161px;
		height: auto;
		filter: blur(3px);
		opacity: 0.08;
	}

	.butterfly-img {
		display: block;
		width: 100%;
		height: auto;
		max-width: none;
		pointer-events: none;
	}

	:global(:root[data-theme='dark']) .butterfly {
		mix-blend-mode: lighten;
		opacity: 0.6;
	}

	@media (max-width: 45rem) {
		.page-footer-inner {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 0.75rem;
		}

		.brand {
			align-items: center;
		}

		.footer-links {
			align-self: center;
		}
	}
</style>
