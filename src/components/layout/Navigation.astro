---
import { Image } from 'astro:assets';
import navFlowerImg from '@/assets/images/png/nav-flower.png';

interface Props {
	primary: { label: string; href: string };
	secondary: { label: string; href: string };
}

const { primary, secondary } = Astro.props;
---

<nav class="site-nav" aria-label="Site navigation">
	<div class="nav-links">
		<a href={primary.href} class="nav-link" id="nav-link-primary">
			<span class="nav-arrow-wrap">
				<span class="nav-arrow nav-arrow-primary">\</span>
				<span class="nav-arrow nav-arrow-hover">\</span>
			</span>
			<span class="nav-label-wrap">
				<span class="nav-label-primary" id="nav-label-primary-main">{primary.label}</span>
				<span class="nav-label-hover" id="nav-label-hover-main">{primary.label}</span>
			</span>
		</a>
		<a href={secondary.href} class="nav-link" id="nav-link-extra">
			<span class="nav-arrow-wrap">
				<span class="nav-arrow nav-arrow-primary">\</span>
				<span class="nav-arrow nav-arrow-hover">\</span>
			</span>
			<span class="nav-label-wrap">
				<span class="nav-label-primary">{secondary.label}</span>
				<span class="nav-label-hover">{secondary.label}</span>
			</span>
		</a>
	</div>

	<div class="nav-bottom">
		<Image
			src={navFlowerImg}
			class="nav-flower"
			width="62"
			height="62"
			alt=""
			aria-hidden="true"
			draggable="false"
		/>
		<p class="nav-status">
			OPEN TO WINTER <span class="nav-plus">+</span> SUMMER 2027 ROLES
		</p>
	</div>
</nav>

<style>
	.site-nav {
		position: fixed;
		left: 0;
		top: 0;
		height: 100vh;
		pointer-events: none;
		z-index: 50;
		display: flex;
		flex-direction: column;
		padding-top: clamp(2rem, 7.5vh, 5.25rem);
		padding-bottom: clamp(2rem, 7.5vh, 5.25rem);
		will-change: transform;
	}

	@media (max-width: 1000px) {
		.site-nav {
			display: none;
		}
	}

	/* ── Nav links ── */
	.nav-links {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding-left: 72px;
		overflow: hidden;
	}

	.nav-link {
		display: inline-flex;
		width: fit-content;
		font-family: var(--font-mono), monospace;
		font-size: 12px;
		font-weight: 400;
		color: #6d6d6d;
		text-decoration: none;
		text-transform: uppercase;
		line-height: 24px;
		white-space: nowrap;
		pointer-events: auto;
	}

	.nav-arrow-wrap {
		position: relative;
		display: inline-block;
		margin-right: 0;
	}

	.nav-arrow {
		font-family: inherit;
		font-size: inherit;
		font-weight: inherit;
	}

	.nav-arrow-primary {
		color: inherit;
		display: block;
		transition: none;
	}

	.nav-arrow-hover {
		position: absolute;
		top: 0;
		left: 0;
		color: var(--color-brand-pink);
		opacity: 0;
		transition: none;
	}

	.nav-label-wrap {
		position: relative;
		display: inline-block;
	}

	.nav-label-primary {
		display: block;
	}

	.nav-label-hover {
		position: absolute;
		top: 0;
		left: 0;
		color: var(--color-brand-pink);
		opacity: 0;
		transition: none;
	}

	.nav-link:hover .nav-label-primary {
		opacity: 0;
		transition: none;
	}

	.nav-link:hover .nav-label-hover {
		opacity: 1;
		transition: opacity 0.2s ease 0.03s;
	}

	.nav-link:hover .nav-arrow-primary {
		opacity: 0;
		transition: none;
	}

	.nav-link:hover .nav-arrow-hover {
		opacity: 1;
		transition: opacity 0.2s ease 0.05s;
	}

	/* ── Bottom section ── */
	.nav-bottom {
		margin-top: auto;
		display: flex;
		flex-direction: column;
	}

	.nav-flower {
		display: block;
		width: 62px;
		height: 62px;
		object-fit: cover;
		opacity: 0.12;
		filter: blur(1.5px);
		pointer-events: none;
		user-select: none;
		margin-left: 61px;
		margin-bottom: 20px;
	}

	.nav-status {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 400;
		color: var(--color-text-primary-alt);
		text-transform: uppercase;
		line-height: 18px;
		width: 146px;
		margin: 0 0 0 72px;
		pointer-events: auto;
		user-select: none;
		-webkit-user-select: none;
	}

	:root[data-theme='dark'] .nav-flower {
		opacity: 0.5;
	}

	.nav-plus {
		color: var(--color-brand-pink);
	}
</style>

<script>
	import { gsap } from 'gsap';

	document.addEventListener('astro:page-load', () => {
		const nav = document.querySelector<HTMLElement>('.site-nav');
		const footer = document.querySelector<HTMLElement>('.page-footer');
		if (!nav) return;

		// Prevent navigating to the current page
		nav.querySelectorAll<HTMLAnchorElement>('.nav-link').forEach((link) => {
			link.addEventListener('click', (e) => {
				if (new URL(link.href, window.location.origin).pathname === window.location.pathname) {
					e.preventDefault();
				}
			});
		});

		// Footer avoidance
		if (footer) {
			const update = () => {
				nav.style.transform = '';
				const footerTop = footer.getBoundingClientRect().top;
				const navBottom = nav.getBoundingClientRect().bottom;
				const overlap = navBottom - footerTop;
				if (overlap > 0) nav.style.transform = `translateY(${-overlap}px)`;
			};
			gsap.ticker.add(update);
			document.addEventListener('astro:before-swap', () => gsap.ticker.remove(update), { once: true });
			update();
		}

		// Fade in only on the very first page load (not on SPA navigations)
		if (!(window as any).__navInited) {
			(window as any).__navInited = true;
			gsap.set(nav, { opacity: 0 });
			gsap.to(nav, { opacity: 1, duration: 0.3, delay: 0.1, ease: 'power2.out' });
		}
	});
</script>
