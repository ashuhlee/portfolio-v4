---
interface Props {
	variant: string;
	tooltip: string;
	tooltipColor: string;
	tooltipColorStart?: string;
	tooltipTextColor?: string;
}

const { variant, tooltip, tooltipColor, tooltipColorStart, tooltipTextColor } = Astro.props;
---

<div
	class:list={['placeholder', `card-${variant}`, 'showcase-preview', 'stagger-in']}
	data-tooltip={tooltip}
	data-tooltip-color={tooltipColor}
	data-tooltip-color-start={tooltipColorStart}
	data-tooltip-text-color={tooltipTextColor}
>
	<slot />
</div>
