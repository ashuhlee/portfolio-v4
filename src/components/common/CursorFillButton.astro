---
interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a class="cursor-fill-btn" data-bounce="0.95" href={href} target="_blank" rel="noopener noreferrer">
	<span class="fill" aria-hidden="true"></span>
	<span class="label">{label}</span>
	<span class="arrow-track">
		<span class="arrow" aria-hidden="true">→</span>
	</span>
</a>

<script>
	import { gsap } from 'gsap';

	function relativePoint(el: HTMLElement, event: MouseEvent) {
		const rect = el.getBoundingClientRect();
		return { x: event.clientX - rect.left, y: event.clientY - rect.top };
	}

	const HOVER_COLORS = [
		{
			fill: '#222C25',
			fg: '#EDFDAD'
		},
		{
			fill: '#FE6FC1',
			fg: '#ffffff'
		},
		{
			fill: '#202935',
			fg: '#beefff'
		},
		{
			fill: '#FF8276',
			fg: '#fff'
		},
	];

	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLElement>('.cursor-fill-btn').forEach((btn) => {
			const fill = btn.querySelector<HTMLElement>('.fill');
			if (!fill) return;

			let colorIndex = 0;
			btn.style.setProperty('--btn-fill', HOVER_COLORS[colorIndex].fill);
			btn.style.setProperty('--btn-fg', HOVER_COLORS[colorIndex].fg);

			gsap.set(fill, { xPercent: -50, yPercent: -50, scale: 0 });

			btn.addEventListener('mouseenter', (event) => {
				colorIndex = (colorIndex + 1) % HOVER_COLORS.length;

				btn.style.setProperty('--btn-fill', HOVER_COLORS[colorIndex].fill);
				btn.style.setProperty('--btn-fg', HOVER_COLORS[colorIndex].fg);

				const { x, y } = relativePoint(btn, event);
				const rect = btn.getBoundingClientRect();
				const diagonal = Math.hypot(rect.width, rect.height);
				const scale = ((2 * diagonal) / fill.offsetWidth) * 1.1;

				gsap.set(fill, { x, y, scale: 0 });
				gsap.to(fill, { scale, duration: 0.3, ease: 'back.out(1.7)' });
			});

			btn.addEventListener('mouseleave', (event) => {
				const { x, y } = relativePoint(btn, event);
				gsap.to(fill, { x, y, scale: 0, duration: 0.4, ease: 'power2.out' });
			});
		});
	});
</script>

<style>
	.cursor-fill-btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: var(--color-gray-light);
		border-radius: 999px;
		padding: 0.75rem 1rem;
		cursor: pointer;
		text-decoration: none;
		transition: padding 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.cursor-fill-btn:hover {
		padding: 1rem 1.25rem;
	}

	.fill {
		position: absolute;
		top: 0;
		left: 0;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		background: var(--btn-fill, var(--color-forest-deep));
		pointer-events: none;
	}

	.label {
		position: relative;
		z-index: 1;
		font-family: var(--font-sofia), sans-serif;
		font-size: var(--font-size-14);
		font-weight: 600;
		line-height: 1;
		color: var(--color-charcoal-alt);
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.cursor-fill-btn:hover .label {
		color: var(--btn-fg, var(--color-brand-lime));
	}

	.arrow-track {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 0fr;
		font-family: var(--font-sofia), sans-serif;
		font-size: var(--font-size-14);
		font-weight: 600;
		line-height: 1;
		transition: grid-template-columns 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.cursor-fill-btn:hover .arrow-track {
		grid-template-columns: 1fr;
	}

	.arrow {
		display: block;
		overflow: hidden;
		min-width: 0;
		opacity: 0;
		color: var(--btn-fg, var(--color-brand-lime));
		transform: translateX(-0.25rem);
		transition:
			opacity 0.3s ease,
			transform 0.15s ease;
	}

	.cursor-fill-btn:hover .arrow {
		padding-left: 0.125rem;
		opacity: 1;
		transform: translateX(0.25rem);
	}
</style>
