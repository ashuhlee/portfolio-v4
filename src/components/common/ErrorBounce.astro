<span class="error-bounce" aria-hidden="true">
	\ERROR
</span>

<script>
	document.addEventListener('astro:page-load', () => {
		const el = document.querySelector<HTMLElement>('.error-bounce');
		if (!el) return;

		const STEP = 2;
		const TICK_MS = 12;

		const COLORS = ['var(--color-brand-pink)', 'var(--color-text-primary)'];
		let colorIndex = 0;
		el.style.color = COLORS[colorIndex];

		let w = el.offsetWidth;
		let h = el.offsetHeight;
		let x = Math.random() * (window.innerWidth - w);
		let y = Math.random() * (window.innerHeight - h);
		let dx = STEP;
		let dy = STEP * 0.7;

		el.style.left = `${x}px`;
		el.style.top = `${y}px`;

		const handleResize = () => {
			w = el.offsetWidth;
			h = el.offsetHeight;
			x = Math.min(x, window.innerWidth - w);
			y = Math.min(y, window.innerHeight - h);
		};
		window.addEventListener('resize', handleResize);

		const interval = window.setInterval(() => {
			x += dx;
			y += dy;

			let bounced = false;
			if (x <= 0) {
				x = 0;
				dx = Math.abs(dx);
				bounced = true;
			} else if (x + w >= window.innerWidth) {
				x = window.innerWidth - w;
				dx = -Math.abs(dx);
				bounced = true;
			}
			if (y <= 0) {
				y = 0;
				dy = Math.abs(dy);
				bounced = true;
			} else if (y + h >= window.innerHeight) {
				y = window.innerHeight - h;
				dy = -Math.abs(dy);
				bounced = true;
			}

			if (bounced) {
				colorIndex = (colorIndex + 1) % COLORS.length;
				el.style.color = COLORS[colorIndex];
			}

			el.style.left = `${x}px`;
			el.style.top = `${y}px`;
		}, TICK_MS);

		document.addEventListener(
			'astro:before-swap',
			() => {
				clearInterval(interval);
				window.removeEventListener('resize', handleResize);
			},
			{ once: true },
		);
	});
</script>

<style>
	.error-bounce {
		position: fixed;
		top: 0;
		left: 0;
		font-family: var(--font-mono), monospace;
		font-size: var(--font-size-13);
		pointer-events: none;
		-webkit-user-select: none;
		user-select: none;
		z-index: -1;
		opacity: 0;
		animation: error-bounce-fade-in 0.25s ease 1s forwards;
	}

	@keyframes error-bounce-fade-in {
		to {
			opacity: 1;
		}
	}
</style>
