<div class="clock-widget" aria-hidden="true">
	<span class="time"><span class="hour">--</span><span class="colon">:</span><span class="minute">--</span></span>
	<span class="zone">pm</span>
</div>

<script>
	function formatTime() {
		const parts = new Intl.DateTimeFormat('en-US', {
			hour: '2-digit',
			minute: '2-digit',
			hour12: true,
			timeZone: 'America/Toronto',
		}).formatToParts(new Date());

		const hour = parts.find((p) => p.type === 'hour')?.value ?? '--';
		const minute = parts.find((p) => p.type === 'minute')?.value ?? '--';
		const period = parts.find((p) => p.type === 'dayPeriod')?.value.toLowerCase() ?? '';

		return { hour, minute, period };
	}

	let currentPeriod = '';
	let showingEst = false;

	function tick() {
		const hourEl = document.querySelector<HTMLElement>('.clock-widget .hour');
		const minuteEl = document.querySelector<HTMLElement>('.clock-widget .minute');
		const zoneEl = document.querySelector<HTMLElement>('.clock-widget .zone');

		const { hour, minute, period } = formatTime();
		currentPeriod = period;

		if (hourEl) hourEl.textContent = hour;
		if (minuteEl) minuteEl.textContent = minute;
		if (zoneEl && !showingEst) zoneEl.textContent = period;
	}

	document.addEventListener('astro:page-load', () => {
		tick();
		const widget = document.querySelector<HTMLElement>('.clock-widget');
		const zoneEl = document.querySelector<HTMLElement>('.clock-widget .zone');

		widget?.addEventListener('click', () => {
			if (!zoneEl) return;
			showingEst = !showingEst;
			zoneEl.textContent = showingEst ? `${currentPeriod} · EST` : currentPeriod;
		});

		const interval = setInterval(tick, 1000);
		document.addEventListener('astro:before-swap', () => clearInterval(interval), { once: true });
	});
</script>

<style>
	.clock-widget {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 5;
		display: inline-flex;
		align-items: baseline;
		gap: 0.125rem;
		padding: 0.375rem 0.75rem;
		border-radius: 999px;
		font-family: var(--font-mono), monospace;
		-webkit-user-select: none;
		user-select: none;
		pointer-events: auto;
		cursor: default;
	}

	.time {
		font-size: var(--font-size-12);
		color: var(--color-text-primary);
	}

	.colon {
		color: var(--color-brand-pink);
		font-weight: 600;
	}

	.zone {
		font-family: var(--font-sans), sans-serif;
		font-weight: 400;
		font-style: italic;
		font-size: var(--font-size-12);
		color: var(--color-text-primary);
	}

	@media (max-width: 37.5rem) {
		.clock-widget {
			right: 1rem;
			bottom: 1rem;
		}
	}
</style>
