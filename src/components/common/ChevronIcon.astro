---
interface Props {
	direction?: 'left' | 'right';
	size?: number;
}

const { direction = 'left', size = 12 } = Astro.props;
---

<svg
	class:list={['chevron', { 'chevron--right': direction === 'right' }]}
	width={size}
	height={size}
	viewBox="0 0 12 12"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
>
	<path d="M4.5 5.5L7.57 2.56L7 2L3 6L7 10L7.57 9.44L4.5 6.5L4 6L4.5 5.5Z" fill="currentColor" />
</svg>

<style>
	.chevron {
		display: block;
		flex-shrink: 0;
	}

	.chevron--right {
		transform: rotate(180deg);
	}
</style>
