---
---

<footer class="page-footer">
	<div class="page-footer-inner">
		<div class="brand">
			<p class="wordmark">ASHUHLEE</p>
			<p class="copyright"><span class="copyright-icon">©</span> 2026 Ashley Oyewole. All rights reserved.</p>
		</div>
		<nav class="footer-links">
			<a class="link-linkedin" href="https://www.linkedin.com/in/ashuhlee" target="_blank" rel="noopener noreferrer"><span>LinkedIn</span></a>
			<a class="link-github" href="https://github.com/ashuhlee" target="_blank" rel="noopener noreferrer"><span>GitHub</span><span class="bracket-right">]</span></a>
			<a class="link-email" href="mailto:hello@ashuhlee.ca"><span>Email</span></a>
		</nav>
	</div>
</footer>

<style>
	.page-footer {
		width: 100vw;
		position: relative;
		left: 50%;
		margin-left: -50vw;
		background: var(--color-bg);
		border-top: 1px solid var(--color-border);
	}

	.page-footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: calc(var(--page-max-width, 50rem) * 1.4);
		margin: 0 auto;
		padding: 2rem 1.5rem 2.5rem;
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.wordmark {
		margin: 0;
		font-family: var(--font-display), sans-serif;
		font-size: 1.125rem;
		color: #212121;
		user-select: none;
	}

	.copyright {
		margin: 0;
		font-size: 0.875rem;
		color: #606060;
	}

	.copyright-icon {
		color: var(--color-main);
		font-size: 0.9375rem;
	}

	.footer-links {
		display: flex;
		align-self: flex-end;
		gap: 0.125rem;
	}

	.footer-links a {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 0.375rem 0.625rem;
		font-family: var(--font-mono), monospace;
		text-transform: uppercase;
		font-size: 0.75rem;
		color: var(--color-ink-medium);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-links a::before {
		content: '> ';
		display: inline-block;
		width: 0;
		margin-right: 0;
		overflow: hidden;
		opacity: 0;
	}

	.footer-links a.link-github::before {
		content: '[';
	}

	.footer-links a.link-email::before {
		content: '\5C';
	}

	.footer-links a .bracket-right {
		display: inline-block;
		width: 0;
		margin-left: 0;
		overflow: hidden;
		opacity: 0;
	}

	.footer-links a:hover {
		color: var(--color-main);
	}

	.footer-links a:hover::before {
		width: auto;
		margin-right: 0px;
		opacity: 1;
	}

	.footer-links a:hover .bracket-right {
		width: auto;
		margin-left: 0px;
		opacity: 1;
	}

	.footer-links a::after {
		content: '';
		position: absolute;
		left: 0.625rem;
		right: 0.625rem;
		bottom: 0.375rem;
		height: 1px;
		background: currentColor;
		opacity: 0.4;
		transition: opacity 0.2s ease, transform 0.4s ease;
	}

	.footer-links a:hover::after {
		opacity: 0;
		height: 0px;
	}

	.footer-links a span {
		position: relative;
		z-index: 1;
	}

	@media (max-width: 45rem) {
		.page-footer-inner {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 0.75rem;
		}

		.brand {
			align-items: center;
		}

		.footer-links {
			align-self: center;
		}
	}
</style>
