---
interface Props {
	id: string;
	label: string;
	prefix?: string;
	checked?: boolean;
	[attr: string]: unknown;
}

const { id, label, prefix, checked = false, ...rest } = Astro.props;
---

<label class="toggle" for={id}>
	<input class="toggle-input" type="checkbox" role="switch" id={id} checked={checked} {...rest} />
	<span class="toggle-track" aria-hidden="true">
		<span class="toggle-thumb"></span>
	</span>
	<span class="toggle-label">
		{prefix && <span class="toggle-prefix" aria-hidden="true">{prefix}</span>}
		{label}
	</span>
</label>

<style>
	.toggle {
		--toggle-off: #ebebeb;
		--toggle-on: var(--color-text-primary);
		display: flex;
		align-items: center;
		gap: 0.375rem;
		cursor: pointer;
		-webkit-user-select: none;
		user-select: none;
	}

	:root[data-theme='dark'] .toggle {
		--toggle-off: #3a3646;
		--toggle-on: var(--color-brand-pink);
	}

	.toggle-input {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.toggle-track {
		position: relative;
		flex-shrink: 0;
		width: 1.75rem;
		height: 1rem;
		border-radius: 999px;
		background: var(--toggle-off);
		transition: background 0.2s var(--ease-standard);
	}

	.toggle-thumb {
		position: absolute;
		top: 0.09375rem;
		left: 0.09375rem;
		width: 0.8125rem;
		height: 0.8125rem;
		border-radius: 50%;
		background: #ffffff;
		box-shadow: 0 0.0625rem 0.125rem rgba(0, 0, 0, 0.2);
		transition: transform 0.25s var(--ease-spring);
	}

	.toggle-input:checked + .toggle-track {
		background: var(--toggle-on);
	}

	.toggle-input:checked + .toggle-track .toggle-thumb {
		transform: translateX(0.75rem);
	}

	.toggle-input:focus-visible + .toggle-track {
		outline: 2px solid var(--toggle-on);
		outline-offset: 2px;
	}

	.toggle-label {
		display: flex;
		align-items: center;
		font-family: var(--font-sans), sans-serif;
		font-size: var(--font-size-14);
		line-height: 1.75;
		color: var(--color-text-primary);
	}

	.toggle-prefix {
		font-family: var(--font-mono), monospace;
		font-size: var(--font-size-13);
		padding-bottom: 0.125rem;
		color: var(--color-brand-pink);
	}

	:root[data-theme='dark'] .toggle-prefix {
		color: var(--color-brand-lime);
	}
</style>
