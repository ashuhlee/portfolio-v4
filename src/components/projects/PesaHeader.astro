---
import PesaChips from '@/components/projects/PesaChips.astro';
---

<header class="header-row">
	<div class="header-left">
		<div class="title-row stagger-in">
			<h1>PESA</h1>
		</div>
		<p class="description stagger-in">
			Over the summer I worked on Pesa's mobile app, using Flutter. I worked across
			iOS and Android to build and ship new features and improve existing user experiences, rotating across product
			/
			engineering teams.
		</p>
		<p class="description stagger-in">
			I had the opportunity to ship multiple user-facing features that are now used by thousands of people around
			the world.
		</p>
	</div>
	<PesaChips />
</header>

<style>
	.header-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.header-left {
		flex: 1;
		min-width: 0;
	}

	.title-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	h1 {
		font-family: var(--font-display), sans-serif;
		font-size: var(--font-size-20);
		margin: 0;
		color: var(--color-text-primary);
	}

	.description {
		font-family: 'GT Walsheim Pro', sans-serif;
		font-size: 15.5px;
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0 0 0.75rem;
		max-width: 31.5625rem;
	}

	:root[data-theme='dark'] .description {
		color: var(--color-text-medium);
	}

	.description:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 45rem) {
		.header-row {
			flex-direction: column;
		}
	}
</style>
