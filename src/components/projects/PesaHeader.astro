---
import PesaChips from '@/components/projects/PesaChips.astro';
---

<header class="header-row">
	<div class="header-left">
		<div class="title-row stagger-in">
			<h1>PESA</h1>
		</div>
		<p class="description stagger-in">
			Over the summer, I worked on Pesa's official mobile app. I worked with the
			product + engineering team to build and ship lots of new features, and improve existing user experiences.
		</p>
		<p class="description stagger-in">
			From initial implementation to testing and release, I helped bring ideas from the design stage to real-world use.
		</p>
	</div>
	<PesaChips />
</header>

<style>
	.header-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.header-left {
		flex: 1;
		min-width: 0;
	}

	.title-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	h1 {
		font-family: var(--font-display), sans-serif;
		font-size: var(--font-size-20);
		margin: 0;
		color: var(--color-text-primary);
	}

	.description {
		font-family: var(--font-sans), sans-serif;
		font-size: var(--font-size-15);
		line-height: 1.5;
		color: var(--color-text-secondary);
		margin: 0 0 0.75rem;
		max-width: 30rem;
	}

	:root[data-theme='dark'] .description {
		color: var(--color-text-secondary);
	}

	.description:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 45rem) {
		.header-row {
			flex-direction: column;
		}
	}
</style>
