---
---

<div class="hover-tooltip" id="hover-tooltip" transition:persist></div>

<script>
	import { gsap } from 'gsap';

	const tooltip = document.getElementById('hover-tooltip');
	if (tooltip) {
		let activeTarget: HTMLElement | null = null;

		const xTo = gsap.quickTo(tooltip, 'x', { duration: 0.35, ease: 'power3' });
		const yTo = gsap.quickTo(tooltip, 'y', { duration: 0.35, ease: 'power3' });

		function offsetFor(target: HTMLElement, clientX: number) {
			const isLeft = target.dataset.tooltipAlign === 'left';
			return isLeft ? clientX - 15 : clientX + 15;
		}

		document.addEventListener('mouseover', (event) => {
			const target = (event.target as HTMLElement)?.closest<HTMLElement>('[data-tooltip]');
			if (!target || target === activeTarget) return;

			activeTarget = target;

			const oldWidth = tooltip.getBoundingClientRect().width;

			tooltip.classList.add('visible');
			const color = target.dataset.tooltipColor;
			tooltip.classList.toggle('solid', Boolean(color));
			tooltip.style.background = color ?? '';

			gsap.set(tooltip, { width: 'auto' });
			tooltip.textContent = target.dataset.tooltip ?? '';
			const newWidth = tooltip.getBoundingClientRect().width;

			gsap.fromTo(tooltip, { width: oldWidth }, { width: newWidth, duration: 0.25, ease: 'power2.out' });

			const mouseEvent = event as MouseEvent;

			gsap.set(tooltip, {
				x: offsetFor(target, mouseEvent.clientX),
				y: mouseEvent.clientY + 15,
			});
		});

		document.addEventListener('mousemove', (event) => {
			if (!activeTarget) return;
			xTo(offsetFor(activeTarget, event.clientX));
			yTo(event.clientY + 15);
		});

		document.addEventListener('mouseout', (event) => {
			if (!activeTarget) return;
			const related = event.relatedTarget as HTMLElement | null;
			if (related && activeTarget.contains(related)) return;

			activeTarget = null;
			tooltip.classList.remove('visible');
		});
	}
</script>

<style>
	.hover-tooltip {
		opacity: 0;
		pointer-events: none;
		position: fixed;
		top: 0;
		left: 0;
		background: #fff;
		border: 1px solid var(--color-border);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
		font-family: var(--font-sans), sans-serif;
		font-size: 14px;
		font-weight: 600;
		color: var(--color-ink);
		padding: 4px 12px 6px 12px;
		border-radius: 999px;
		white-space: nowrap;
		overflow: hidden;
		transition: opacity 0.18s ease, scale 0.2s ease;
		z-index: 9999;
	}

	.hover-tooltip.visible {
		opacity: 1;
	}

	.hover-tooltip.solid {
		border: none;
		box-shadow: none;
	}
</style>
